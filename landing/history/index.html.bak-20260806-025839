/* ==========================================================================
   组件5：双轨竞速
   两条轨道同时推进。Sonnet 先到（更快），Opus 后到但输出更长（推理更深）——
   这是两个模型真实的取舍方向，不是随机数。
   纯本地动画，界面上标了"非真实请求"：真跑两次生成要烧号池配额。
   ========================================================================= */
function paintCalc() { /* 保留空实现：applyLang() 会调用它，改语言时不该报错 */ }

(() => {
  const btn = $('#race-run');
  if (!btn) return;
  const lanes = $$('.race-lane').map(el => ({
    el,
    fill: el.querySelector('.race-fill'),
    peak: el.querySelector('.race-peak'),
    out:  el.querySelector('.race-out'),
    tEl:  el.querySelector('.race-t'),
    rEl:  el.querySelector('.race-r'),
    // Sonnet 更快但输出短，Opus 更慢但更长 —— 反映真实取舍
    isSonnet: el.dataset.lane === 'sonnet',
    // 弹道状态
    i: 0, acc: 0, lvl: 0, pk: 0, t0: 0, doneAt: 0, finalT: 0, lastRate: 0,
  }));
  const TEXT = {
    sonnet: ['用','Sonnet','：','快','、','够用','。'],
    opus:   ['用','Opus','：','推理','更','深','，','长','任务','更','稳','。'],
  };

  /* 电平表的量程：共用一个上限，两条才可比。
     取 14 tok/s —— 比两条的实际速率都高一点，指针才不会常年顶格。 */
  const FS = 14;
  /* VU 表的弹道：上冲快、回落慢（真实表头的机械阻尼就是这样，
     否则读数在瞬时抖动里根本读不出来）。峰值指针只前进不后退。 */
  const RISE = 14, FALL = 3.2;   // 每秒变化量（占满量程的比例）

  let raf = null, running = false, last = 0;

  function reset() {
    if (raf) { cancelAnimationFrame(raf); raf = null; }
    running = false; last = 0;
    lanes.forEach(l => {
      l.fill.style.width = '0';
      l.peak.style.left = '0'; l.peak.classList.remove('on');
      l.out.innerHTML = '';
      l.tEl.textContent = '—.-';
      l.rEl.textContent = '—.-';
      l.el.classList.remove('win');
      l.i = 0; l.acc = 0; l.lvl = 0; l.pk = 0; l.t0 = 0; l.doneAt = 0;
      l.finalT = 0; l.lastRate = 0;
    });
    setBtn(btn, 'play', t('race.run'));
  }

  function frame(now) {
    if (!running) return;
    raf = requestAnimationFrame(frame);
    const dt = last ? Math.min((now - last) / 1000, .05) : .016;   // 秒，掉帧时钳住
    last = now;

    let allDone = true;
    lanes.forEach(l => {
      const words = l.isSonnet ? TEXT.sonnet : TEXT.opus;
      // 每 token 的间隔（秒）：Sonnet 更快
      const gap = l.isSonnet ? .095 : .165;

      if (l.i < words.length) {
        allDone = false;
        l.acc += dt;
        // 一帧内可能跨过多个 token（掉帧时），用 while 补齐
        while (l.acc >= gap && l.i < words.length) {
          l.acc -= gap;
          const sp = document.createElement('span');
          sp.className = 'tok';
          sp.textContent = words[l.i];
          l.out.appendChild(sp);
          l.i++;
          if (l.i === 1) l.t0 = now;
        }
        const secs = (now - l.t0) / 1000;
        if (secs > 0 && l.i > 0) {
          l.tEl.textContent = secs.toFixed(1);
          l.rEl.textContent = (l.i / secs).toFixed(1);
          l.finalT = secs;                       // 冻结用
        }
      } else if (!l.doneAt) {
        l.doneAt = now;
        // 冻结读数：跑完后 now 还在涨，若继续用 (now - t0) 算速率会一直往下掉，
        // 看起来像模型越跑越慢。定格在完成那一刻的值才是这次测量的结果。
        if (l.finalT) {
          l.tEl.textContent = l.finalT.toFixed(1);
          l.rEl.textContent = (l.i / l.finalT).toFixed(1);
        }
        // 先跑完的标 win（doneAt 最小的那个）
        const others = lanes.filter(o => o !== l && o.doneAt);
        if (!others.length) l.el.classList.add('win');
      }

      /* 瞬时速率 → 目标电平（占量程比例）。
         跑完之后目标设 0，让条按 FALL 的速率自然衰减 —— 而不是瞬间清零。
         真实表头的指针不会"啪"地掉下来，它是有阻尼的。
         峰值指针在这期间保住末值，所以读数不会丢。 */
      const secs = l.t0 ? (now - l.t0) / 1000 : 0;
      const rate = secs > 0 ? l.i / secs : 0;
      l.lastRate = l.i < words.length ? rate : (l.lastRate || rate);
      const targetLvl = l.i < words.length ? Math.min(rate / FS, 1) : 0;

      // 弹道：上冲快、回落慢
      const rateOfChange = targetLvl > l.lvl ? RISE : FALL;
      const d = targetLvl - l.lvl;
      const maxStep = rateOfChange * dt;
      l.lvl += Math.abs(d) < maxStep ? d : Math.sign(d) * maxStep;
      l.lvl = Math.max(0, Math.min(1, l.lvl));
      l.fill.style.width = (l.lvl * 100).toFixed(1) + '%';

      // 峰值保持：只前进
      if (l.lvl > l.pk) {
        l.pk = l.lvl;
        l.peak.style.left = `calc(${(l.pk * 100).toFixed(1)}% - 1px)`;
        l.peak.classList.add('on');
      }
    });

    if (allDone && lanes.every(l => l.lvl < .01)) {
      running = false; cancelAnimationFrame(raf); raf = null;
      setBtn(btn, 'play', t('race.run'));
    }
  }

  function run() {
    if (running) { reset(); return; }
    reset();
    running = true;
    setBtn(btn, 'reset', lang === 'en' ? 'Reset' : '重置');
    last = 0;
    raf = requestAnimationFrame(frame);
  }
  btn.onclick = run;
  // 离屏就停，别在后台烧电池
  new IntersectionObserver((es) => {
    es.forEach(e => { if (!e.isIntersecting && running) reset(); });
  }, {threshold:0}).observe($('.race'));
  reset();
})();

/* ==========================================================================
   组件6：命令面板 ⌘K
