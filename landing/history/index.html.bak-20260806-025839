     注意 label 必须当**纯文本**处理 —— 之前这里直接拼进 innerHTML，
     而调用方传的是 t('...') 的结果，那份文案里本来就带 <svg>（HTML 里写死的），
     于是图标被套进图标，渲染成两个叠在一起。截图里"逐步推理"前面那两个
     三角就是这么来的。
     现在先清空再用 textContent 写文字，HTML 只由这里生成。 */
  el.textContent = '';
  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
  svg.setAttribute('class', 'ico ico-sm');
  svg.setAttribute('aria-hidden', 'true');
  const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
  use.setAttribute('href', '#i-' + name);
  svg.appendChild(use);
  el.appendChild(svg);
  if (label) {
    const sp = document.createElement('span');
    // 传进来的可能含 HTML 标签（i18n 文案里有 <svg>），只取其文字
    sp.textContent = String(label).replace(/<[^>]*>/g, '').trim();
    el.appendChild(sp);
