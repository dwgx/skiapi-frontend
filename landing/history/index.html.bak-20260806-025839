   用 textContent 会把 <svg> 一起冲掉，所以统一走这两个函数：
   只替换 <use> 的 href，或重建「图标 + 文字」这个结构。 */
function setIcon(el, name) {
  const use = el.querySelector('use');
  if (use) { use.setAttribute('href', '#i-' + name); return; }
  el.innerHTML = '<svg class="ico" aria-hidden="true"><use href="#i-' + name + '"/></svg>';
}
function setBtn(el, name, label) {
