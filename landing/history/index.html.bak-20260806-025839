      [['响应',.61],['结果',.22],['输出',.11],['内容',.06]],
      [['逐',.57],['一',.25],['按',.12],['分',.06]],
      [['token',.72],['字',.16],['词',.08],['块',.04]],
      [['吐',.54],['返',.26],['发',.13],['给',.07]],
      [['出来',.66],['回来',.21],['过来',.09],['到',.04]],
      [['，',.62],['。',.21],['；',.11],['—',.06]],
      [['全程',.58],['整条',.23],['一路',.12],['始终',.07]],
      [['不',.79],['无',.13],['零',.05],['非',.03]],
      [['缓冲',.71],['等待',.15],['积压',.09],['阻塞',.05]],
      [['。',.92],['了',.04],['的',.03],['着',.01]],
    ],
  ];
  let STEPS = TEMPLATES[0];

  /* ---- 动画状态 ----------------------------------------------------------
     丝滑的关键：位置不是每步跳一次，而是每帧被一个弹簧拉向目标。
     采样只负责移动 target，pos 自己追上去 —— 所以看到的是滑行，不是闪现。 */
  let step = 0, built = [], playing = false;
  let pos = {x:.5, y:.5}, vel = {x:0, y:0}, target = {x:.5, y:.5};
  let trail = [];            // 每帧一个点的环形缓冲，不是每步一个 —— 曲线才连续
  let anchors = [];          // 每步落点，用来画节点
  let cands = null, probs = null, pick = -1;
  let candIn = 0;            // 候选点的入场进度 0→1
  let ripples = [];          // 采样落定时的十字闪
  let rafId = null, last = 0, acc = 0, tGlobal = 0;
  const STEP_MS = 900;       // 自动播放时每步间隔
  const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* DPR 感知：canvas 的 CSS 宽是 100%，backing store 必须按实际像素来，
     否则在 Retina 上一切都是糊的。 */
  let W = 0, H = 0;
  function resize() {
    const r = cv.getBoundingClientRect();
    if (!r.width) return;
    const dpr = Math.min(devicePixelRatio || 1, 2);
    W = r.width; H = r.height || 300;
    cv.width = Math.round(W * dpr);
    cv.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  addEventListener('resize', resize, {passive:true});

  /* 背景尘埃已删除。
     漂浮粒子是"AI 生成的酷炫画面"最典型的一个符号，而且它和这个组件要讲的事
     毫无关系 —— 它不承载任何数据，纯装饰。仪表盘不会往刻度盘里撒星星。
     取而代之的是下面 drawGrid() 画的坐标网格：它同样填充画面，但每一根线都
     有含义（刻度），看久了不会觉得空，也不会觉得在看屏保。 */

  /* 1px 实线在 HiDPI 上会被插值成 2px 灰边。把坐标落在半像素上，
     线就正好压在一列物理像素中心，边缘是硬的。 */
  const crisp = (v) => Math.round(v) + .5;

  function drawGrid() {
    const step = 40;                       // 网格间距，px（CSS 像素）
    ctx.lineWidth = 1;
    ctx.strokeStyle = 'rgba(120,160,210,.07)';
    ctx.beginPath();
    for (let x = step; x < W; x += step) { ctx.moveTo(crisp(x), 0); ctx.lineTo(crisp(x), H); }
    for (let y = step; y < H; y += step) { ctx.moveTo(0, crisp(y)); ctx.lineTo(W, crisp(y)); }
    ctx.stroke();

    // 边框刻度：外圈一圈短齿，读作"这是一块量程"
    ctx.strokeStyle = 'rgba(120,160,210,.2)';
    ctx.beginPath();
    for (let x = step; x < W; x += step) {
      ctx.moveTo(crisp(x), H); ctx.lineTo(crisp(x), H - (x % (step * 5) === 0 ? 7 : 4));
      ctx.moveTo(crisp(x), 0); ctx.lineTo(crisp(x), (x % (step * 5) === 0 ? 7 : 4));
    }
    for (let y = step; y < H; y += step) {
      ctx.moveTo(0, crisp(y)); ctx.lineTo((y % (step * 5) === 0 ? 7 : 4), crisp(y));
      ctx.moveTo(W, crisp(y)); ctx.lineTo(W - (y % (step * 5) === 0 ? 7 : 4), crisp(y));
    }
    ctx.stroke();

    // 中心十字准星：给"当前位置偏离原点多远"一个参照
    ctx.strokeStyle = 'rgba(120,160,210,.13)';
    ctx.setLineDash([3, 5]);
    ctx.beginPath();
    ctx.moveTo(crisp(W / 2), 0); ctx.lineTo(crisp(W / 2), H);
    ctx.moveTo(0, crisp(H / 2)); ctx.lineTo(W, crisp(H / 2));
    ctx.stroke();
    ctx.setLineDash([]);
  }

  // 用固定种子的伪随机：同一步的候选点位置每次都一样，视觉才稳定
  const seeded = (i, j) => {
    const s = Math.sin(i * 127.1 + j * 311.7) * 43758.5453;
    return s - Math.floor(s);
  };

  function softmax(cands, temp) {
    // temp 越高分布越平；越低越尖（趋近 argmax）
    const logits = cands.map(([, p]) => Math.log(Math.max(p, 1e-6)) / temp);
    const mx = Math.max(...logits);
    const ex = logits.map(l => Math.exp(l - mx));
    const sum = ex.reduce((a, b) => a + b, 0);
    return ex.map(e => e / sum);
  }

  const candPos = (j, p, from) => {
    const ang = seeded(step, j) * Math.PI * 2;
    const dist = .07 + (1 - p) * .13;
    return {x: from.x + Math.cos(ang) * dist, y: from.y + Math.sin(ang) * dist * .8};
  };

  function draw() {
    if (!W) resize();
    if (!W) return;
    ctx.clearRect(0, 0, W, H);

    drawGrid();

    /* --- 轨迹：单条折线，一次 stroke ---------------------------------------
       之前是逐段 stroke 并逐段改色/改粗细，那画出来像一条会发光的丝带。
       仪表画迹线的方式是：一条恒定粗细的线 + 整体透明度衰减，靠"余晖"表达
       时间，不靠彩虹渐变。而且一次 beginPath 比 150 次 stroke 快得多。 */
    if (trail.length > 1) {
      ctx.lineJoin = 'round'; ctx.lineCap = 'butt';
      // 分三段画，越旧越淡 —— 三段足够表达衰减，又不必逐段调用
      const segs = [[0, .34, .1], [.34, .68, .26], [.68, 1, .62]];
      segs.forEach(([a, b, alpha]) => {
        const i0 = Math.floor(trail.length * a), i1 = Math.ceil(trail.length * b);
        if (i1 - i0 < 2) return;
        ctx.strokeStyle = `rgba(90,210,230,${alpha})`;
        ctx.lineWidth = 1.2;
        ctx.beginPath();
        ctx.moveTo(trail[i0].x * W, trail[i0].y * H);
        for (let i = i0 + 1; i < i1; i++) ctx.lineTo(trail[i].x * W, trail[i].y * H);
        ctx.stroke();
      });
    }

    /* --- 每步的落点：方块而不是圆点 ---------------------------------------
       圆点+发光=装饰；小方块+连线=数据点。仪表和图表都用后者。 */
    ctx.fillStyle = 'rgba(20,140,200,.85)';
    anchors.forEach((p) => {
      ctx.fillRect(Math.round(p.x * W) - 1.5, Math.round(p.y * H) - 1.5, 3, 3);
    });

    /* --- 采样瞬间：一次十字闪、不是水波纹 ---------------------------------
       扩散圆环是"特效"语汇。仪表在一个读数落定时的表达是刻线闪一下。 */
    ripples.forEach(r => {
      const a = (1 - r.t) * .8, L = 6 + r.t * 9;
      const x = crisp(r.x * W), y = crisp(r.y * H);
      ctx.strokeStyle = `rgba(45,212,191,${a})`;
      ctx.lineWidth = 1;
      ctx.beginPath();
      ctx.moveTo(x - L, y); ctx.lineTo(x - 3, y);
      ctx.moveTo(x + 3, y); ctx.lineTo(x + L, y);
      ctx.moveTo(x, y - L); ctx.lineTo(x, y - 3);
      ctx.moveTo(x, y + 3); ctx.lineTo(x, y + L);
      ctx.stroke();
    });

    /* --- 候选方向 -----------------------------------------------------------
       去掉了"呼吸"脉动：那是无信息的动，纯粹为了让画面不静。
       改成按概率给出不同的连线样式 —— 概率越低虚线越稀，读作"越不可能"。 */
    if (cands && candIn > 0.01) {
      const ease = 1 - Math.pow(1 - candIn, 3);
      const x0 = pos.x * W, y0 = pos.y * H;
      cands.forEach((c, j) => {
        const cp = candPos(j, probs[j], target);
        const x = x0 + (cp.x * W - x0) * ease;
        const y = y0 + (cp.y * H - y0) * ease;
        const isPick = j === pick;
        ctx.strokeStyle = isPick ? `rgba(45,212,191,${.7 * ease})`
                                 : `rgba(204,120,92,${(.18 + probs[j] * .3) * ease})`;
        ctx.lineWidth = 1;
        // 虚线密度编码概率：高概率接近实线，低概率稀疏
        ctx.setLineDash(isPick ? [] : [2, 2 + (1 - probs[j]) * 5]);
        ctx.beginPath(); ctx.moveTo(crisp(x0), crisp(y0)); ctx.lineTo(crisp(x), crisp(y)); ctx.stroke();
        ctx.setLineDash([]);
        // 候选点：空心方框，选中的填实 —— 和"落点"的实心方块区分开
        const s = 3 + probs[j] * 4;
        ctx.globalAlpha = ease;
        if (isPick) {
          ctx.fillStyle = '#2dd4bf';
          ctx.fillRect(Math.round(x) - s / 2, Math.round(y) - s / 2, s, s);
        } else {
          ctx.strokeStyle = 'rgba(204,120,92,.8)';
          ctx.strokeRect(crisp(x - s / 2), crisp(y - s / 2), s, s);
        }
        // 标签：等宽 + 概率百分比，读作读数而不是标题
        ctx.font = '9.5px ui-monospace,SFMono-Regular,monospace';
        ctx.fillStyle = isPick ? '#2dd4bf' : 'rgba(147,164,196,.66)';
        ctx.fillText(`${c[0]} ${(probs[j] * 100).toFixed(0)}%`, x + s / 2 + 4, y + 3.2);
        ctx.globalAlpha = 1;
      });
    }

    /* --- 当前位置：两条投影虚线，不画点 -----------------------------------
       光点/准星都去掉了。位置靠"投影到两侧坐标轴的虚线"表达 —— 这是工程图
       和示波器标注坐标的标准做法：你读的是刻度上的位置，而不是盯着一个发光物。
       迹线的末端本身就在那里，不需要再压一个标记在上面。 */
    const gx = crisp(pos.x * W), gy = crisp(pos.y * H);
    ctx.strokeStyle = 'rgba(45,212,191,.34)';
    ctx.lineWidth = 1;
    ctx.setLineDash([2, 3]);
    ctx.beginPath();
    ctx.moveTo(0, gy); ctx.lineTo(gx, gy);      // 投到左轴
    ctx.moveTo(gx, H); ctx.lineTo(gx, gy);      // 投到下轴
    ctx.stroke();
    ctx.setLineDash([]);
    // 轴上两个短刻记，标出投影落点
    ctx.strokeStyle = 'rgba(45,212,191,.85)';
    ctx.beginPath();
    ctx.moveTo(0, gy); ctx.lineTo(6, gy);
    ctx.moveTo(gx, H); ctx.lineTo(gx, H - 6);
    ctx.stroke();

    /* --- 角标读数：坐标 + 速度，像仪表那样常驻 --------------------------- */
    ctx.font = '9.5px ui-monospace,SFMono-Regular,monospace';
    ctx.fillStyle = 'rgba(147,164,196,.5)';
    const spd = Math.hypot(vel.x, vel.y) * 1000;
    ctx.fillText(`x ${pos.x.toFixed(3)}  y ${pos.y.toFixed(3)}`, 8, H - 8);
    ctx.textAlign = 'right';
    ctx.fillText(`|v| ${spd.toFixed(1)}`, W - 8, H - 8);
    ctx.textAlign = 'left';
  }

  /* ---- 每帧物理 ----------------------------------------------------------
     弹簧 + 阻尼把 pos 拉向 target。dt 归一化到 60fps 的步长，
     所以 120Hz 屏和 60Hz 屏跑出来的速度一致。 */
  function physics(dt) {
    /* 临界阻尼弹簧（半隐式积分）。
       之前手调 k/damp 的版本是**欠阻尼**的：实测 pos→target 的距离
       94→81→56→24→18→36→44→5→21 一路来回，是"振铃"不是"滑行"。
       欠阻尼在这个积分器里需要 damp ≈ 1−2√k 才临界，k=.055 时约 0.53，
       而当时写的是 0.9，差得远。

       改成按时间常数 tau 推：临界阻尼下位移必定单调趋近，永不过冲，
       且 tau 有物理意义（约 tau*4 毫秒落位），不用再猜参数。 */
    const TAU = 155;                            // ms，越大越"重"
    const n = Math.min(dt, 50);                 // 掉帧时钳住，不要炸
    const w = 1 / TAU;
    // 临界阻尼：加速度 = -2w·v - w²·(x-target)
    ['x', 'y'].forEach(k => {
      const a = -2 * w * vel[k] - w * w * (pos[k] - target[k]);
      vel[k] += a * n;
      pos[k] += vel[k] * n;
    });

    // 待机时的极缓漂移：静止画面也在呼吸
    if (!playing && pick < 0) {
      target.x += Math.sin(tGlobal * .00021) * .00013 * n;
      target.y += Math.cos(tGlobal * .00017) * .00011 * n;
      target.x = Math.max(.1, Math.min(.9, target.x));
      target.y = Math.max(.12, Math.min(.88, target.y));
    }

    // 轨迹缓冲：每帧记一点，上限 150
    trail.push({x:pos.x, y:pos.y});
    if (trail.length > 150) trail.shift();

    if (candIn < 1) candIn = Math.min(1, candIn + .032 * n);   // 候选淡入慢一点，别抢戏

    ripples.forEach(r => { r.t += .022 * n; });
    ripples = ripples.filter(r => r.t < 1);

  }

  function frame(now) {
    rafId = requestAnimationFrame(frame);
    const dt = last ? Math.min(now - last, 50) : 16.67;
    last = now; tGlobal = now;
    physics(dt);
    draw();
    // 自动播放的节拍也走这个循环，不再单独开 setTimeout
    if (playing) {
      acc += dt;
      if (acc >= STEP_MS) { acc = 0; if (!doStep()) return; }
    }
  }

  function renderPred(cands, probs, pickIdx) {
    predBox.innerHTML = '';
    cands.forEach((c, j) => {
      const row = document.createElement('div');
      row.className = 'pred-row' + (j === pickIdx ? ' picked' : '');
      const tok = c[0].replace(/^ /, '<span class="sp">␣</span>');
      row.innerHTML = '<span class="pred-tok">' + tok + '</span>' +
        '<span class="pred-bar"><i style="width:' + (probs[j] * 100).toFixed(1) + '%"></i></span>' +
        '<span class="pred-p">' + (probs[j] * 100).toFixed(1) + '%</span>';
      predBox.appendChild(row);
    });
  }

  /* 一步 = 亮出候选 → 采样 → 把 target 挪过去。
     移动本身交给 physics 每帧插值，这里只改目标。 */
  function doStep() {
    if (step >= STEPS.length) {
      playing = false;
      setBtn(runBtn, 'play', t('js.run'));
      return false;
    }
    const temp = tempIn.checked ? 1.5 : 0.6;
    cands = STEPS[step];
    probs = softmax(cands, temp);
    let r = Math.random(), p = 0, a = 0;
    for (let j = 0; j < probs.length; j++) { a += probs[j]; if (r <= a) { p = j; break; } }
    pick = p;
    candIn = 0;                         // 候选重新入场
    renderPred(cands, probs, pick);
    stepEl.textContent = 'step ' + (step + 1);

    const cp = candPos(pick, probs[pick], target);
    anchors.push({x:target.x, y:target.y});
    target = {x: Math.max(.09, Math.min(.91, cp.x)),
              y: Math.max(.11, Math.min(.89, cp.y))};
    ripples.push({x:target.x, y:target.y, t:0});
    built.push(cands[pick][0]);
    textEl.textContent = built.join('');
    step++;
    return true;
  }

  function reset() {
    playing = false; acc = 0;
    // 每次重置换一条模板 —— 不用 Math.random 挑到同一条也没关系，
    // 用"排除当前"的方式保证连续两次一定不同，否则随机看起来像没生效。
    if (TEMPLATES.length > 1) {
      const others = TEMPLATES.filter(t => t !== STEPS);
      STEPS = others[Math.floor(Math.random() * others.length)];
    }
    step = 0; built = []; anchors = []; trail = []; ripples = [];
    cands = null; probs = null; pick = -1; candIn = 0;
    pos = {x:.5, y:.5}; vel = {x:0, y:0}; target = {x:.5, y:.5};
    textEl.textContent = '';
    stepEl.textContent = 'step 0';
    predBox.innerHTML = '';
    setBtn(runBtn, 'play', t('js.run'));
  }

  function play() {
    if (playing) { reset(); return; }
    if (step >= STEPS.length) reset();
    playing = true; acc = 0;
    setBtn(runBtn, 'reset', lang === 'en' ? 'Reset' : '重置');
    doStep();
  }

  runBtn.onclick = play;
  stepBtn.onclick = () => { playing = false; doStep(); };
  tempIn.addEventListener('change', () => { if (step > 0) reset(); });
  $('#js-dims').textContent = '4096d → 2d';

  resize();
  reset();
  /* 只在进入视口时跑循环 —— 页面滚出去还在 rAF 是白烧电池。
     prefers-reduced-motion 时只画一帧静态图。 */
  if (REDUCED) {
    draw();
  } else {
    const vis = new IntersectionObserver((es) => {
      es.forEach(e => {
        if (e.isIntersecting && !rafId) { last = 0; rafId = requestAnimationFrame(frame); }
        else if (!e.isIntersecting && rafId) { cancelAnimationFrame(rafId); rafId = null; }
      });
    }, {threshold:.05});
    vis.observe(cv);
  }
  window.__jsReset = reset;
  // 只为自动化验证暴露内部状态：像素采样分不清亮点/候选/涟漪，读不准
  window.__jsProbe = () => ({pos:{...pos}, target:{...target}, vel:{...vel},
                             trail:trail.length, step, playing, fps:1000/Math.max(1,tGlobal-last||16)});
})();

/* ==========================================================================
   组件6：提示词缓存
   --------------------------------------------------------------------------
   倍率来自 /api/v1/model-plaza 的实测（opus-5 与 sonnet-5 完全一致）：
     input          1.00×   opus-5 官方 $5.00/M
     write 5m TTL   1.25×   → $6.25/M
     write 1h TTL   2.00×   → $10.00/M
     read           0.10×   → $0.50/M

   为什么不发真请求：真跑一次要烧号池配额，而且要跑出"缓存命中"得连发两次。
   为首页动画烧计费额度不值得。所以标了"按官方公布倍率计算"，数字本身是真的，
   请求是模拟的 —— 这两件事分开说清楚。
   ========================================================================= */
(() => {
  const blocksEl = $('#cc-blocks');
  if (!blocksEl) return;

  const IN_USD = 5.00;          // opus-5 input，$/M tokens
  const R_WRITE = 1.25, R_READ = 0.10;

  // 前缀的分段：名字 + token 数。系统提示词/工具定义/文档是典型的可缓存前缀
  const SEG = [
    {name:'system',    tok:1200},
    {name:'tools',     tok:3400},
    {name:'文档 1',    tok:8600},
    {name:'文档 2',    tok:9200},
    {name:'历史对话',  tok:5400},
  ];
  const TAIL = 180;             // 每次新增的用户输入，不进缓存

  let n = 0;                    // 第几次请求
  let dirtyFrom = -1;           // 从哪一段起失效（-1 = 全部有效）
  let costOn = 0, costOff = 0;

  const fmt = (v) => '$' + v.toFixed(6);

  function render() {
    blocksEl.innerHTML = '';
    SEG.forEach((s, i) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'cc-blk';
      /* 每一段都能点：点哪段，就从那段起失效。
         这比一个"改动前缀开头"的按钮直观得多 —— 你能亲手试出
         "改越靠前的段，失效范围越大"这个规律，而不是被告知。 */
      b.title = lang === 'en' ? 'Edit from here' : '从这段起改动';
      b.onclick = () => {
        if (n === 0) { toast(lang === 'en' ? 'Send one first' : '先发一次请求'); return; }
        dirtyFrom = i;
        render();
        const after = SEG.length - i;
        toast(lang === 'en'
          ? `${after} segment(s) invalidated`
          : `它及之后 ${after} 段全部失效`);
      };
      // 第一次请求：全部是"新增"（要写入）
      // 之后：dirtyFrom 之前命中，之后失效
      if (n === 0) b.classList.add('fresh');
      else if (dirtyFrom >= 0 && i >= dirtyFrom) b.classList.add('dirty');
      else b.classList.add('cached');
      b.textContent = `${s.name} ${s.tok.toLocaleString()}`;
      blocksEl.appendChild(b);
    });
    // 尾部：每次都是新 token，永远不命中
    const t = document.createElement('span');
    t.className = 'cc-blk fresh';
    t.textContent = `本次输入 ${TAIL}`;
    blocksEl.appendChild(t);

    const total = SEG.reduce((a, s) => a + s.tok, 0);
    $('#cc-toks').textContent = (total + TAIL).toLocaleString() + ' tok';
    $('#cc-n').textContent = lang === 'en' ? `call ${n}` : `第 ${n} 次`;
  }

  function paintCost() {
    const scale = Math.max(costOff, 1e-9);
    $('#cc-on').textContent = fmt(costOn);
    $('#cc-off').textContent = fmt(costOff);
    $('#cc-bar-on').style.width = (costOn / scale * 100).toFixed(1) + '%';
    $('#cc-bar-off').style.width = '100%';
    /* 第 1 次调用用缓存其实**更贵** —— 写入付 1.25×，不缓存只付 1.00×。
       缓存要到第 2 次才回本。这里如实显示这个负数，不用 Math.max 抹成 0：
       把首次的成本劣势藏起来，等于骗人，而且用户自己一算就会发现。 */
    const saved = costOff - costOn;
    const el = $('#cc-saved'), pct = $('#cc-pct');
    if (saved < 0) {
      el.textContent = '+' + fmt(-saved);
      el.style.color = 'var(--clay)';
      pct.textContent = lang === 'en' ? 'first write costs more' : '首次写入更贵';
      $('#cc-saved-lbl').textContent = lang === 'en' ? 'extra' : '多付';
    } else {
      el.textContent = fmt(saved);
      el.style.color = '';
      $('#cc-saved-lbl').textContent = t('cc.saved');
      pct.textContent = costOff > 0
        ? (lang === 'en' ? `${(saved / costOff * 100).toFixed(0)}% less` : `少付 ${(saved / costOff * 100).toFixed(0)}%`)
        : '';
    }
  }

  function send() {
    n++;
    const per = (tok, mult) => tok / 1e6 * IN_USD * mult;
    let on = 0;

    SEG.forEach((s, i) => {
      const isHit = n > 1 && !(dirtyFrom >= 0 && i >= dirtyFrom);
      on += isHit ? per(s.tok, R_READ) : per(s.tok, R_WRITE);
    });
    on += per(TAIL, 1);                       // 尾部按普通 input 计
    // 不用缓存：全部按 input 原价，每次都全量重付
    const off = per(SEG.reduce((a, s) => a + s.tok, 0) + TAIL, 1);

    costOn += on;
    costOff += off;
    // 这次请求把失效段重新写入了，所以下次它们就是命中的
    dirtyFrom = -1;
    render(); paintCost();
  }

  function edit() {
    // 改动第 2 段（tools）→ 它及其之后全部失效。
    // 这是缓存最反直觉的一点：前缀是按"精确前缀匹配"的，
    // 改中间一个字节，后面所有段的缓存键都变了，不是只失效被改的那段。
    if (n === 0) { toast(lang === 'en' ? 'Send one first' : '先发一次请求'); return; }
    dirtyFrom = 1;
    render();
    toast(lang === 'en' ? 'Everything after it invalidated' : '它之后的全部失效');
  }

  function reset() {
    n = 0; dirtyFrom = -1; costOn = 0; costOff = 0;
    render(); paintCost();
  }

  $('#cc-send').onclick = send;
  /* 连发 10 次：缓存的价值是**累积**出来的，单次点击看不出趋势。
     用 rAF 逐次推进而不是一次算完，成本条的拉开过程才看得见。 */
  $('#cc-burst').onclick = () => {
    if ($('#cc-burst').disabled) return;
    $('#cc-burst').disabled = true;
    let left = 10;
    const tick = () => {
      send(); left--;
      if (left > 0) setTimeout(tick, 130);
      else $('#cc-burst').disabled = false;
    };
    tick();
  };
  $('#cc-edit').onclick = edit;
  $('#cc-reset').onclick = reset;
  reset();
  window.__ccReset = reset;
})();

/* ---- 启动 --------------------------------------------------------------- */
if (lang === 'en') applyLang(); else { renderModels(); paintModel(); paintCalc(); }
</script>
</body>
</html>
