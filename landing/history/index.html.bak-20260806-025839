  const build = () => {
    const out = [
      {ic:'zap', label:t('ep.title'), sub:'endpoints', act:() => location.hash = '#endpoints'},
      {ic:'database', label:t('mdl.title'), sub:'models',  act:() => location.hash = '#models'},
