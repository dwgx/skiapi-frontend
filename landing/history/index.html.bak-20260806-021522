<!DOCTYPE html>
<html lang="zh-CN" class="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<!-- 图标由 Caddy 的 (favicon) 片段就地服务，不在本目录下。
     声明出来是为了让浏览器直接取 PNG，不必先去探测 /favicon.ico。 -->
<link rel="icon" type="image/png" href="/favicon.png">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<title>SkiAPI — Anthropic 协议兼容网关</title>
<style>
/* ============================================================================
   设计令牌
   ----------------------------------------------------------------------------
   蓝色取自 favicon 的真实像素（深 #000078 → 主 #0048d8/#0060f0 → 亮 #00c0f0），
   所以标签页图标和页面终于是同一个色系。

   青绿沿用了 sub2api 后台的 #2dd4bf，但**降级为信号色**：只用在"活的数据"上
   —— 延迟数字、200 状态、在线心跳。它不再是装饰色，出现即表示"这个数是真的"。

   陶土色 clay 是 Anthropic 品牌色，只在与 Claude 直接相关的元素上出现。
   ========================================================================= */
:root{
  /* 品牌蓝阶 */
  --b-950:#000078; --b-900:#0030c0; --b-700:#0048d8; --b-600:#0060f0;
  --b-500:#0078f0; --b-400:#0090f0; --b-300:#00c0f0;
  /* 信号色：仅用于实时数据 */
  --sig:#2dd4bf; --sig-soft:#5eead4;
  /* Anthropic 陶土色，仅用于 Claude 相关 */
  --clay:#cc785c;
  /* 暗色底：偏蓝的近黑，让它落在蓝色家族里而不是中性灰 */
  --bg:#070b14; --bg-soft:#0a1020; --surface:rgba(255,255,255,.026);
  --surface-2:rgba(255,255,255,.045);
  --line:rgba(255,255,255,.07); --line-lit:rgba(0,120,240,.28);
  --fg:#eef3fb; --fg-mid:#93a4c4; --fg-dim:#5d6f92;
  /* 字体：不加载 webfont —— 单文件自托管页面要么依赖 CDN（CSP 不允许），
     要么内嵌字体文件（体积翻倍）。系统栈在两个平台上都够好。 */
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",system-ui,sans-serif;
  --mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,"Cascadia Code","Fira Code",monospace;
  /* 圆角：卡片 8、面板 10、标签全圆。取自 Anthropic(8) 与 Vercel(6) 的区间 */
  --r-sm:6px; --r:8px; --r-lg:10px; --r-xl:14px; --r-full:999px;
  /* 缓动：swift 末值 1.1 会轻微过冲（Vercel 的手法），用于交互反馈；
     glide 无过冲（Linear 的曲线），用于入场揭示。 */
  --swift:cubic-bezier(.175,.885,.32,1.1);
  --glide:cubic-bezier(.25,.46,.45,.94);
  /* 按压/离手要"到位就停"，不能回弹 —— 回弹在按钮上读作廉价。
     这条曲线末段快速收敛，没有过冲。 */
  --out:cubic-bezier(.2,0,0,1);
  /* 渐变只留给 h1 里那一个强调词。按钮、卡片、进度条全部改用实色 + 分层阴影。 */
  --grad:linear-gradient(135deg,var(--b-700),var(--b-400) 55%,var(--b-300));
}
html:not(.dark){
  --bg:#fbfcfe; --bg-soft:#f2f6fc; --surface:rgba(10,20,40,.028);
  --surface-2:rgba(10,20,40,.05);
  --line:rgba(8,20,45,.09); --line-lit:rgba(0,96,240,.3);
  --fg:#08101f; --fg-mid:#47597a; --fg-dim:#75879f;
  --sig:#0d9488; --sig-soft:#14b8a6;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth;-webkit-text-size-adjust:100%}
body{
  background:var(--bg);color:var(--fg);font-family:var(--sans);
  -webkit-font-smoothing:antialiased;line-height:1.6;overflow-x:hidden;
  transition:background .4s var(--glide),color .4s var(--glide);
}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:none;cursor:pointer}
.wrap{max-width:1140px;margin:0 auto;padding:0 24px}
section{position:relative;z-index:1}
::selection{background:rgba(0,120,240,.3)}

/* ---- 字号阶梯 ------------------------------------------------------------
   五个参考站的共同做法：字重压低 + 负字距随字号放大。
   Vercel 到 -6%、Codex -3%、Linear/OpenRouter -2.2~2.5%。这里取 -4% 起。 */
h1{font-size:clamp(2.4rem,5.4vw,4.2rem);font-weight:500;letter-spacing:-.04em;line-height:1.05}
h2{font-size:clamp(1.6rem,3vw,2.3rem);font-weight:500;letter-spacing:-.03em;line-height:1.15}
h3{font-size:1.02rem;font-weight:600;letter-spacing:-.011em}
.mono{font-family:var(--mono);font-variant-ligatures:none}

/* ---- 环境光层 ------------------------------------------------------------
   Apple HIG 讲材质要"按语义选，不按呈现的颜色选"。这里的语义是深度：
   光球只负责把 hero 与下方内容分层，所以只在 hero 区可见、透明度极低。 */
.ambient{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.orb{position:absolute;border-radius:50%;filter:blur(100px);opacity:.42}
.orb-1{top:-200px;right:-120px;width:540px;height:540px;
  background:radial-gradient(circle,rgba(0,96,240,.3),transparent 70%)}
.orb-2{top:36%;left:-220px;width:480px;height:480px;
  background:radial-gradient(circle,rgba(0,192,240,.13),transparent 70%)}
.orb-3{top:8%;left:44%;width:360px;height:360px;
  background:radial-gradient(circle,rgba(0,0,120,.3),transparent 72%)}
html:not(.dark) .orb{opacity:.3}
.grid-bg{position:absolute;inset:0;
  background-image:linear-gradient(rgba(120,160,255,.05) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(120,160,255,.05) 1px,transparent 1px);
  background-size:56px 56px;
  mask-image:radial-gradient(ellipse 75% 55% at 50% 0%,#000 30%,transparent 75%);
  -webkit-mask-image:radial-gradient(ellipse 75% 55% at 50% 0%,#000 30%,transparent 75%)}

/* ---- 导航 --------------------------------------------------------------- */
#nav{position:sticky;top:0;z-index:50;
  background:color-mix(in srgb,var(--bg) 78%,transparent);
  backdrop-filter:blur(18px) saturate(1.6);-webkit-backdrop-filter:blur(18px) saturate(1.6);
  border-bottom:1px solid transparent;transition:border-color .3s var(--glide)}
#nav.stuck{border-bottom-color:var(--line)}
.nav-in{display:flex;align-items:center;justify-content:space-between;height:60px;gap:16px}
.logo{display:flex;align-items:center;gap:9px;font-weight:600;font-size:15.5px;letter-spacing:-.015em}
.logo-mark{width:25px;height:25px;border-radius:7px;background:var(--b-600);
  display:grid;place-items:center;color:#fff;font-size:12.5px;font-weight:700;
  box-shadow:0 2px 10px rgba(0,96,240,.4)}
.nav-actions{display:flex;align-items:center;gap:7px}

/* ---- 图标 ---------------------------------------------------------------
   currentColor 让图标跟随文字色，尺寸用 em 让它跟随字号 —— 这样一个 .ico
   规则就够用，不必为每个位置写一遍尺寸。 */
.ico{width:1em;height:1em;flex:none;fill:none;stroke:currentColor;stroke-width:2;
  stroke-linecap:round;stroke-linejoin:round;vertical-align:-.125em}
.ico-sm{width:.86em;height:.86em}
.ico-lg{width:1.15em;height:1.15em}

/* ---- 按钮 ---------------------------------------------------------------
   实色填充 + 分层阴影，**不用渐变**。
   渐变按钮是 AI 生成页面最典型的特征之一，而且它掩盖了真正让按钮"可按"的
   东西：顶部一道 1px 的内高光（模拟受光面）+ 底部一道暗投影（模拟离地）。
   按下时高光收掉、投影压扁、整体下沉 1px —— 这才是触感的来源。

   边框一律用 inset box-shadow 而不是 border：不占布局盒模型，
   hover 改变粗细不会引起 1px 的位置抖动。

   时长按角色分层，不是全站一个 .3s：
     按压反馈 90ms（要跟手）· 悬停 180ms · 位移 220ms。 */
.btn{display:inline-flex;align-items:center;gap:7px;height:35px;padding:0 15px;
  border-radius:var(--r);font-size:13.5px;font-weight:500;letter-spacing:-.008em;
  white-space:nowrap;
  transition:background .18s var(--glide),color .18s var(--glide),
             box-shadow .18s var(--glide),transform .09s var(--out)}
.btn-ghost{color:var(--fg-mid)}
.btn-ghost:hover{color:var(--fg);background:var(--surface-2)}
.btn-solid{background:var(--b-600);color:#fff;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.22),
             0 1px 1px rgba(2,8,20,.5),
             0 2px 6px -1px rgba(2,8,20,.4)}
.btn-solid:hover{background:var(--b-500);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.26),
             0 1px 1px rgba(2,8,20,.5),
             0 4px 12px -2px rgba(0,96,240,.45)}
.btn-solid:active{transform:translateY(1px);background:var(--b-700);
  box-shadow:inset 0 1px 2px rgba(2,8,20,.45)}
.btn-line{box-shadow:inset 0 0 0 1px var(--line);color:var(--fg)}
.btn-line:hover{box-shadow:inset 0 0 0 1px var(--line-lit);background:var(--surface)}
.btn-line:active{transform:translateY(1px);background:var(--surface-2)}
.btn-lg{height:43px;padding:0 21px;font-size:14.5px;border-radius:var(--r-lg)}
.icon-btn{width:33px;height:33px;border-radius:var(--r);color:var(--fg-mid);
  display:grid;place-items:center;font-size:12px;font-weight:600;
  transition:background .18s var(--glide),color .18s var(--glide),transform .09s var(--out)}
.icon-btn:hover{color:var(--fg);background:var(--surface-2)}
.icon-btn:active{transform:translateY(1px)}
/* 键盘可达性：参考站普遍用 focus-visible 而非 focus，避免鼠标点击也出现描边 */
.btn:focus-visible,.icon-btn:focus-visible,.ep:focus-visible,.chip:focus-visible{
  outline:2px solid var(--b-400);outline-offset:2px}

/* ---- 揭示动画 ----------------------------------------------------------- */
.rv{opacity:0;transform:translateY(14px);
  transition:opacity .6s var(--glide),transform .6s var(--glide)}
.rv.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){
  .rv{opacity:1;transform:none;transition:none}
  *{animation-duration:.01ms !important;transition-duration:.01ms !important}
}
/* 打印/截图不滚动，IntersectionObserver 永不触发，整页会是空白。
   打印样式里强制可见；JS 侧另有超时兜底。 */
@media print{
  .rv{opacity:1 !important;transform:none !important}
  .ambient,#nav,.stream-foot,.js-foot,.race-foot{display:none}
}

/* ---- Hero --------------------------------------------------------------- */
.hero{padding:76px 0 40px}
.hero-grid{display:grid;grid-template-columns:1fr 1fr;gap:52px;align-items:center}
@media (max-width:940px){.hero-grid{grid-template-columns:1fr;gap:36px}.hero{padding:48px 0 28px}}
.eyebrow{display:inline-flex;align-items:center;gap:8px;height:27px;padding:0 12px;
  border-radius:var(--r-full);background:var(--surface-2);
  box-shadow:inset 0 0 0 1px var(--line);
  font-size:12.5px;color:var(--fg-mid);margin-bottom:20px}
.eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--sig);
  box-shadow:0 0 0 3px color-mix(in srgb,var(--sig) 22%,transparent);
  animation:pulse 2.4s var(--glide) infinite}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
/* 渐变文字只用在这一个强调词上。整句连同 span 一起走 i18n：
   中英文强调词的位置不同，拆成"前缀+固定词"会在另一语言下语序错乱。 */
.accent{background:var(--grad);-webkit-background-clip:text;background-clip:text;
  -webkit-text-fill-color:transparent;color:transparent}
.lede{font-size:clamp(.98rem,1.5vw,1.12rem);color:var(--fg-mid);margin:18px 0 26px;max-width:33em}
.hero-cta{display:flex;gap:11px;flex-wrap:wrap}
.note{margin-top:17px;font-size:12.8px;color:var(--fg-dim)}
.note b{color:var(--fg-mid);font-weight:600}

/* ---- 终端 ---------------------------------------------------------------
   等号两侧不能是 flex 兄弟节点：flex 的 gap 会在 "=" 后插入可见空格，
   渲染成 `VAR= value`，用户照着抄的命令是坏的。所以嵌在同一个 span 里。 */
.term{border-radius:var(--r-xl);overflow:hidden;background:var(--bg-soft);
  box-shadow:inset 0 0 0 1px var(--line),0 24px 60px -20px rgba(0,0,0,.55)}
.term-bar{display:flex;align-items:center;gap:7px;height:35px;padding:0 13px;
  background:var(--surface);border-bottom:1px solid var(--line)}
.term-bar i{width:9.5px;height:9.5px;border-radius:50%;background:var(--line);flex:none}
.term-bar span{margin-left:6px;font-size:11.5px;color:var(--fg-dim);font-family:var(--mono)}
.term-body{padding:15px 16px;font-family:var(--mono);font-size:12.6px;line-height:1.95;
  min-height:236px}
.ln{display:flex;align-items:baseline;gap:7px;flex-wrap:wrap}
.ln.gap{margin-top:11px}
.c-p{color:var(--b-300)}.c-k{color:#c792ea}.c-hi{color:var(--fg)}
.c-v{color:var(--sig-soft)}.c-s{color:var(--clay)}.c-d{color:var(--fg-dim)}
.c-ok{color:var(--sig)}
.tag{display:inline-block;padding:0 6px;border-radius:4px;font-size:10.5px;font-weight:600}
.t-200{background:color-mix(in srgb,var(--sig) 17%,transparent);color:var(--sig)}
.cur{display:inline-block;width:7.5px;height:15px;background:var(--b-300);
  animation:blink 1.15s step-end infinite;vertical-align:text-bottom}
@keyframes blink{50%{opacity:0}}

/* ---- 组件1：SSE 流式可视化 ----------------------------------------------
   这是页面的主交互。流式是这个产品最核心的能力，也是最难用文字讲清的，
   所以让它自己演出来：token 逐个到达、计数器跳动、速率实时算。 */
.stream{margin-top:13px;border-radius:var(--r-lg);background:var(--bg-soft);
  box-shadow:inset 0 0 0 1px var(--line);overflow:hidden}
.stream-head{display:flex;align-items:center;justify-content:space-between;
  padding:9px 13px;border-bottom:1px solid var(--line);background:var(--surface)}
.stream-title{display:flex;align-items:center;gap:8px;font-size:11.6px;color:var(--fg-mid);
  font-family:var(--mono)}
.stream-live{width:6px;height:6px;border-radius:50%;background:var(--fg-dim)}
.stream.on .stream-live{background:var(--sig);
  box-shadow:0 0 0 3px color-mix(in srgb,var(--sig) 22%,transparent);
  animation:pulse 1.5s var(--glide) infinite}
.stream-stats{display:flex;gap:14px;font-family:var(--mono);font-size:11.4px}
.stat b{color:var(--sig);font-weight:600;font-variant-numeric:tabular-nums}
.stat span{color:var(--fg-dim)}
.stream-body{padding:12px 13px;min-height:74px;display:flex;flex-wrap:wrap;
  gap:4px;align-content:flex-start}
/* 每个 token 一个 pill，入场时从下方浮起 —— 这是"流"的视觉隐喻 */
.tok{display:inline-block;padding:1.5px 6px;border-radius:5px;font-family:var(--mono);
  font-size:11.6px;background:var(--surface-2);color:var(--fg);
  box-shadow:inset 0 0 0 1px var(--line);
  animation:tokIn .32s var(--swift) both}
@keyframes tokIn{from{opacity:0;transform:translateY(7px) scale(.94)}to{opacity:1;transform:none}}
.tok.think{color:var(--clay);background:color-mix(in srgb,var(--clay) 11%,transparent);
  box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--clay) 26%,transparent)}
.tok.json{color:#c792ea;background:rgba(199,146,234,.1);
  box-shadow:inset 0 0 0 1px rgba(199,146,234,.24)}
/* 空格标记：空格是 token 的一部分，不是分隔符 */
.tok .sp{color:var(--fg-dim);opacity:.45}
/* 流进终端里，所以不要再套一层背景 */
.term-body .stream-body{padding:9px 0 4px;min-height:52px}
.stream-foot{display:flex;align-items:center;gap:9px;padding:9px 13px;
  border-top:1px solid var(--line)}
.mini-btn{height:27px;padding:0 11px;border-radius:var(--r-sm);font-size:11.8px;
  font-weight:500;box-shadow:inset 0 0 0 1px var(--line);color:var(--fg-mid);
  transition:all .2s var(--swift)}
.mini-btn:hover{color:var(--fg);background:var(--surface-2);box-shadow:inset 0 0 0 1px var(--line-lit)}
.mini-btn.primary{background:var(--b-600);color:#fff;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.2),0 1px 1px rgba(2,8,20,.45)}
.mini-btn.primary:hover{transform:translateY(-1px);box-shadow:0 5px 18px rgba(0,96,240,.42)}
.stream-hint{font-size:11.4px;color:var(--fg-dim);margin-left:auto}

/* ---- j space ------------------------------------------------------------
   左边是 canvas 画的二维投影，右边是概率条。
   配色直接取 smartcli 的 ocean 主题（fx/theme.py 里的 RGB stops），
   跟 favicon 的蓝带几乎重合 —— 两边本来就是同一套色。 */
.js{display:grid;grid-template-columns:1.25fr 1fr;gap:14px;align-items:stretch}
@media (max-width:900px){.js{grid-template-columns:1fr}}
.js-left,.js-right{border-radius:var(--r-lg);background:var(--bg-soft);
  box-shadow:inset 0 0 0 1px var(--line);overflow:hidden;display:flex;flex-direction:column}
.js-hd{display:flex;align-items:center;gap:9px;padding:9px 13px;
  border-bottom:1px solid var(--line);background:var(--surface)}
.js-lbl{font-size:11.6px;font-weight:600;color:var(--fg-mid);letter-spacing:-.01em}
.js-dim{margin-left:auto;font-size:10.6px;color:var(--fg-dim)}
/* 高度写死：resize() 按 CSS 盒子设 backing store，height:auto 会让两者互相追逐 */
#js-canvas{display:block;width:100%;height:300px;flex:1;background:
  radial-gradient(ellipse 70% 70% at 50% 50%,rgba(0,96,240,.07),transparent 72%)}
@media (max-width:900px){#js-canvas{height:240px}}
.js-legend{display:flex;gap:14px;padding:9px 13px;border-top:1px solid var(--line);
  font-size:10.8px;color:var(--fg-dim);flex-wrap:wrap}
.js-legend span{display:inline-flex;align-items:center;gap:5px}
.js-k{width:8px;height:8px;border-radius:50%;flex:none}
.js-k.cur{background:#5ad2e6;box-shadow:0 0 8px #5ad2e6}
.js-k.path{background:#148cc8;opacity:.55}
.js-k.cand{background:var(--clay);opacity:.75}

/* token 预测：概率条 */
.pred{padding:11px 13px;display:grid;gap:6px;flex:1;align-content:start}
.pred-row{display:grid;grid-template-columns:auto 1fr auto;align-items:center;gap:9px;
  font-family:var(--mono);font-size:11.6px;
  padding:4px 7px;border-radius:var(--r-sm);transition:background .2s var(--glide)}
.pred-row.picked{background:color-mix(in srgb,var(--b-500) 15%,transparent)}
.pred-tok{color:var(--fg);min-width:46px}
.pred-row.picked .pred-tok{color:var(--b-300);font-weight:600}
/* 空格在分词器眼里是 token 的一部分，不是分隔符 —— 用 ␣ 显式画出来 */
.pred-tok .sp{color:var(--fg-dim);opacity:.5}
.pred-bar{height:5px;border-radius:var(--r-full);background:var(--surface-2);
  box-shadow:inset 0 0 0 1px var(--line);overflow:hidden}
.pred-bar i{display:block;height:100%;border-radius:var(--r-full);
  background:#1a5f9e;
  transition:width .3s var(--glide)}
.pred-row.picked .pred-bar i{background:var(--b-300)}
.pred-p{color:var(--fg-dim);font-variant-numeric:tabular-nums;min-width:38px;text-align:right}
.js-out{display:flex;align-items:baseline;gap:8px;padding:10px 13px;
  border-top:1px solid var(--line);min-height:40px;flex-wrap:wrap}
.js-out-lbl{font-size:10.6px;color:var(--fg-dim);flex:none}
.js-out-text{font-size:12.2px;color:var(--fg);line-height:1.7}
.js-foot{display:flex;align-items:center;gap:10px;margin-top:13px;flex-wrap:wrap}

/* ---- 信号条 ------------------------------------------------------------- */
.strip{border-top:1px solid var(--line);border-bottom:1px solid var(--line);
  background:var(--surface);padding:13px 0}
.strip-in{display:flex;align-items:center;gap:15px;flex-wrap:wrap;
  font-size:13px;color:var(--fg-mid)}
.live{display:inline-flex;align-items:center;gap:8px;font-weight:600;color:var(--fg)}
.live i{width:7px;height:7px;border-radius:50%;background:var(--sig);
  box-shadow:0 0 0 3.5px color-mix(in srgb,var(--sig) 20%,transparent);
  animation:pulse 2.2s var(--glide) infinite}

/* ---- 区块通用 ----------------------------------------------------------- */
.sec{padding:66px 0}
@media (max-width:940px){.sec{padding:46px 0}}
.sec-head{margin-bottom:30px}
.sec-sub{color:var(--fg-mid);margin-top:9px;font-size:14.6px}

/* ---- 组件2：延迟竞速 ----------------------------------------------------
   两个接入点的延迟做成赛道条，实测值到了就一起填充。比单独两个数字更直观：
   访客一眼看出"哪个更近"，而不用自己比较毫秒数。 */
.ep-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}
@media (max-width:760px){.ep-grid{grid-template-columns:1fr}}
.ep{position:relative;text-align:left;padding:15px 16px;border-radius:var(--r-lg);
  background:var(--surface);box-shadow:inset 0 0 0 1px var(--line);
  transition:all .24s var(--swift);overflow:hidden}
.ep:hover{background:var(--surface-2);box-shadow:inset 0 0 0 1px var(--line-lit);
  transform:translateY(-2px)}
.ep[aria-pressed="true"]{box-shadow:inset 0 0 0 1.5px var(--b-500),
  0 8px 26px -10px rgba(0,96,240,.5)}
.ep-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:7px}
.ep-host{font-family:var(--mono);font-size:13.4px;font-weight:600;letter-spacing:-.01em}
.ep-badge{font-size:10.6px;padding:2px 7px;border-radius:var(--r-full);
  background:color-mix(in srgb,var(--b-500) 17%,transparent);color:var(--b-300);
  font-weight:600;white-space:nowrap}
.ep-badge.dim{background:var(--surface-2);color:var(--fg-dim)}
.ep-geo{font-size:12.2px;color:var(--fg-dim);margin-bottom:11px}
.ep-lat{font-family:var(--mono);font-size:19px;font-weight:600;color:var(--sig);
  font-variant-numeric:tabular-nums;letter-spacing:-.02em}
.ep-lat.pending{font-size:12.4px;font-weight:400;color:var(--fg-dim)}
.ep-lat.failed{font-size:12.4px;font-weight:400;color:var(--fg-dim)}
.ep-lat small{font-size:11.5px;font-weight:400;color:var(--fg-dim);margin-left:2px}
/* 赛道：宽度由 JS 按相对延迟设置，最快的那个铺满 */
.ep-track{position:absolute;left:0;bottom:0;height:2.5px;width:0;
  background:var(--b-400);transition:width 1s var(--glide);border-radius:0 2px 0 0}
.ep-fastest{display:inline-flex;align-items:center;gap:4px;font-size:10.6px;
  color:var(--sig);font-weight:600;margin-left:8px}

/* 复制条 */
.ep-bar{display:flex;align-items:center;gap:11px;margin-top:11px;padding:11px 14px;
  border-radius:var(--r);background:var(--bg-soft);box-shadow:inset 0 0 0 1px var(--line);
  font-family:var(--mono);font-size:12.7px;overflow:hidden}
.ep-snip{flex:1;min-width:0;overflow-x:auto;white-space:nowrap;scrollbar-width:none}
.ep-snip::-webkit-scrollbar{display:none}
.ep-snip-lbl{display:inline-block;font-family:var(--sans);font-size:10.6px;
  color:var(--fg-dim);margin-right:9px;padding:1.5px 6px;border-radius:4px;
  background:var(--surface-2)}
.ep-snip b{color:var(--b-300);font-weight:600}
.ep-copy{flex:none;height:28px;padding:0 12px;border-radius:var(--r-sm);
  font-family:var(--sans);font-size:11.8px;font-weight:500;color:var(--fg-mid);
  box-shadow:inset 0 0 0 1px var(--line);transition:all .2s var(--swift)}
.ep-copy:hover{color:var(--fg);background:var(--surface-2)}
.ep-copy.done{color:var(--sig);box-shadow:inset 0 0 0 1px color-mix(in srgb,var(--sig) 45%,transparent)}

/* ---- 组件3：模型切换器 --------------------------------------------------
   点一个模型，终端里的命令原地改写。把"换模型只改 model 字段"从一句话
   变成一个可以自己动手点的动作。 */
.mdl-switch{display:flex;gap:7px;flex-wrap:wrap;margin-bottom:15px}
.chip{height:30px;padding:0 13px;border-radius:var(--r-full);font-size:12.4px;
  font-weight:500;color:var(--fg-mid);background:var(--surface);
  box-shadow:inset 0 0 0 1px var(--line);transition:all .22s var(--swift);
  font-family:var(--mono);letter-spacing:-.01em;
  display:inline-flex;align-items:center;gap:6px}
.chip:hover{color:var(--fg);background:var(--surface-2);transform:translateY(-1.5px)}
.chip[aria-pressed="true"]{color:#fff;background:var(--b-600);
  box-shadow:0 3px 14px rgba(0,96,240,.36)}
.chip-claude[aria-pressed="true"]{background:var(--clay)}
.chip .chip-tag{font-family:var(--sans);font-size:9.6px;padding:1px 5px;
  border-radius:var(--r-full);background:rgba(255,255,255,.16);font-weight:600}
.mdl-out{border-radius:var(--r-lg);background:var(--bg-soft);
  box-shadow:inset 0 0 0 1px var(--line);padding:14px 15px;
  font-family:var(--mono);font-size:12.7px;line-height:2}
.mdl-out .swap{color:var(--sig-soft);transition:color .3s var(--glide)}
.mdl-out .swap.flash{color:var(--b-300);text-shadow:0 0 14px rgba(0,192,240,.7)}
.mdl-meta-row{display:flex;gap:16px;flex-wrap:wrap;margin-top:11px;
  padding-top:11px;border-top:1px solid var(--line);font-size:11.8px;color:var(--fg-dim)}
.mdl-meta-row b{color:var(--fg-mid);font-weight:600;font-family:var(--mono)}

/* ---- 自绘勾选框 ---------------------------------------------------------
   隐藏原生 input 但保留它：语义（role/checked）、键盘（空格切换）、
   表单行为全部免费继承，只把外观换掉。用 opacity:0 + 绝对定位而不是
   display:none —— 后者会让元素退出无障碍树，读屏软件就找不到它了。

   对勾用 SVG path + stroke-dashoffset 描出来。不用字体里的 ✓：
   那个字形在 Windows / macOS / Android 上差别很大，还会被 emoji 字体劫持。 */
.ck{display:inline-flex;align-items:center;gap:8px;cursor:pointer;position:relative;
  font-size:11.8px;color:var(--fg-mid);user-select:none;
  height:26px;padding:0 11px 0 9px;border-radius:var(--r-full);
  box-shadow:inset 0 0 0 1px var(--line);transition:all .22s var(--swift)}
.ck:hover{color:var(--fg);background:var(--surface-2)}
.ck-in{position:absolute;opacity:0;width:0;height:0;margin:0;pointer-events:none}
.ck-box{width:14px;height:14px;border-radius:4px;flex:none;position:relative;
  box-shadow:inset 0 0 0 1.5px var(--line);
  transition:box-shadow .2s var(--swift),background .2s var(--swift)}
.ck-box svg{position:absolute;inset:0;width:14px;height:14px;fill:none;
  stroke:#fff;stroke-width:2.1;stroke-linecap:round;stroke-linejoin:round}
.ck-box svg path{
  /* 路径总长约 13.6，先整段偏移藏起来，勾选时归零 = 描画出来 */
  stroke-dasharray:14;stroke-dashoffset:14;
  transition:stroke-dashoffset .26s var(--swift)}
.ck-in:checked ~ .ck-box{background:var(--b-600);
  box-shadow:inset 0 1px 0 rgba(255,255,255,.25)}
.ck-in:checked ~ .ck-box svg path{stroke-dashoffset:0}
.ck-in:checked ~ .ck-code,.ck-in:checked ~ .ck-lbl{color:var(--b-300)}
.ck:has(.ck-in:checked){box-shadow:inset 0 0 0 1px var(--line-lit);
  background:color-mix(in srgb,var(--b-500) 12%,transparent)}
/* 键盘焦点必须看得见 —— input 本身不可见，所以描在外层 */
.ck:has(.ck-in:focus-visible){outline:2px solid var(--b-400);outline-offset:2px}
.ck-code{font-family:var(--mono);font-weight:600;transition:color .2s var(--glide)}
.ck-lbl{transition:color .2s var(--glide)}

/* ---- [1m] 后缀 --------------------------------------------------------- */
.mdl-cmd-line{display:flex;align-items:center;gap:7px;flex-wrap:wrap}
.mdl-cmd-line #mdl-copy{margin-left:auto;font-family:var(--sans)}
.ctx-sfx{color:var(--b-300);font-weight:600;transition:color .3s var(--glide)}
.ctx-sfx.flash{text-shadow:0 0 14px rgba(0,192,240,.7)}
.mdl-meta-sep{width:1px;height:14px;background:var(--line);flex:none}
.mdl-more{display:flex;align-items:center;gap:13px;margin-top:14px;flex-wrap:wrap}
.mdl-more-note{font-size:11.8px;color:var(--fg-dim);font-family:var(--mono)}

/* ---- 合并后的终端：状态挪进标题栏 -------------------------------------- */
.term-stats{margin-left:auto;display:flex;align-items:center;gap:11px;
  font-family:var(--mono);font-size:11px}
.term-stats .stat{display:flex;align-items:center;gap:3px}
.term-stats .stat b{color:var(--sig);font-weight:600;font-variant-numeric:tabular-nums}
.term-stats .stat span{color:var(--fg-dim)}
.c-q{color:var(--sig-soft)}
#term-tail{margin-top:4px}
/* 模板切换：小圆点按钮排在播放键右边 */
.tpl-row{display:flex;gap:5px;margin-left:auto;flex-wrap:wrap}
.tpl{height:24px;padding:0 9px;border-radius:var(--r-full);font-size:10.8px;
  font-family:var(--mono);color:var(--fg-dim);
  box-shadow:inset 0 0 0 1px var(--line);transition:all .2s var(--swift)}
.tpl:hover{color:var(--fg);background:var(--surface-2)}
.tpl[aria-pressed="true"]{color:var(--b-300);
  box-shadow:inset 0 0 0 1px var(--line-lit);
  background:color-mix(in srgb,var(--b-500) 13%,transparent)}


/* ---- 组件5：双轨竞速 ----------------------------------------------------
   同一个提示词、两个模型一起跑。讲的是访客真正纠结的问题（选哪个模型），
   而不是他们还没开始用就要估的月消耗量。 */
.race{border-radius:var(--r-xl);background:var(--bg-soft);
  box-shadow:inset 0 0 0 1px var(--line);padding:20px 22px;display:grid;gap:17px}
@media (max-width:600px){.race{padding:16px 15px;gap:14px}}
.race-hd{display:flex;align-items:center;gap:9px;margin-bottom:8px}
.race-name{font-size:12.8px;font-weight:600;letter-spacing:-.012em}
.race-tag{font-size:10.4px;padding:1.5px 7px;border-radius:var(--r-full);font-weight:600;
  background:color-mix(in srgb,var(--clay) 16%,transparent);color:var(--clay)}
.race-tag.sig{background:color-mix(in srgb,var(--sig) 16%,transparent);color:var(--sig)}
.race-bar{display:block;height:5px;border-radius:var(--r-full);background:var(--surface-2);
  box-shadow:inset 0 0 0 1px var(--line);overflow:hidden}
.race-fill{display:block;height:100%;width:0;border-radius:var(--r-full);
  background:var(--clay);transition:width .12s linear}
.race-fill.sonnet{background:var(--b-400)}
.race-out{margin-top:9px;min-height:38px;font-family:var(--mono);font-size:11.8px;
  line-height:1.75;color:var(--fg-mid);display:flex;flex-wrap:wrap;gap:3px;align-content:flex-start}
.race-out .tok{font-size:11.4px;padding:1px 5px}
.race-stats{display:flex;gap:15px;margin-top:8px;font-family:var(--mono);font-size:11.4px;
  color:var(--fg-dim)}
.race-stats b{color:var(--sig);font-weight:600;font-variant-numeric:tabular-nums}
.race-lane.win .race-stats b{color:var(--sig)}
.race-lane.win .race-name::after{content:'';display:inline-block;
  width:5px;height:5px;border-radius:50%;background:var(--sig);
  margin-left:6px;vertical-align:middle}
.race-foot{display:flex;align-items:center;gap:10px;padding-top:15px;
  border-top:1px solid var(--line)}

/* ---- 组件6：命令面板 ⌘K ------------------------------------------------
   前沿站点的标配（OpenRouter 就有）。这里不做花活，只做真正有用的：
   跳区块、复制端点、切模型。 */
.pal-mask{position:fixed;inset:0;z-index:100;display:none;
  background:rgba(4,8,16,.62);backdrop-filter:blur(5px);-webkit-backdrop-filter:blur(5px);
  padding-top:14vh}
.pal-mask.open{display:block;animation:fade .2s var(--glide)}
@keyframes fade{from{opacity:0}to{opacity:1}}
.pal{max-width:520px;margin:0 auto;border-radius:var(--r-xl);overflow:hidden;
  background:var(--bg-soft);box-shadow:0 0 0 1px var(--line),0 30px 80px -20px rgba(0,0,0,.75);
  animation:palIn .26s var(--swift)}
@keyframes palIn{from{opacity:0;transform:translateY(-14px) scale(.97)}to{opacity:1;transform:none}}
.pal-in{width:100%;height:48px;padding:0 17px;background:none;border:none;outline:none;
  color:var(--fg);font-size:14.5px;font-family:var(--sans);
  border-bottom:1px solid var(--line)}
.pal-in::placeholder{color:var(--fg-dim)}
.pal-list{max-height:290px;overflow-y:auto;padding:7px}
.pal-item{display:flex;align-items:center;gap:11px;padding:9px 12px;border-radius:var(--r);
  font-size:13.2px;cursor:pointer;color:var(--fg-mid)}
.pal-item[aria-selected="true"]{background:var(--surface-2);color:var(--fg)}
.pal-ic{width:22px;height:22px;border-radius:6px;display:grid;place-items:center;flex:none;
  background:var(--surface-2);font-size:11px;font-family:var(--mono);color:var(--b-300)}
.pal-item .sub{margin-left:auto;font-size:11px;color:var(--fg-dim);font-family:var(--mono)}
.pal-empty{padding:22px;text-align:center;font-size:12.6px;color:var(--fg-dim)}
kbd{font-family:var(--mono);font-size:10.6px;padding:2px 5px;border-radius:4px;
  background:var(--surface-2);box-shadow:inset 0 0 0 1px var(--line);color:var(--fg-mid)}

/* ---- 卡片 / 表格 / CTA / 页脚 ------------------------------------------- */
.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:13px}
@media (max-width:860px){.g3{grid-template-columns:1fr}}
.card{padding:19px 20px;border-radius:var(--r-lg);background:var(--surface);
  box-shadow:inset 0 0 0 1px var(--line);transition:all .26s var(--swift)}
.card:hover{background:var(--surface-2);box-shadow:inset 0 0 0 1px var(--line-lit);
  transform:translateY(-2.5px)}
.card-ic{width:33px;height:33px;border-radius:9px;display:grid;place-items:center;
  margin-bottom:13px;background:color-mix(in srgb,var(--b-500) 15%,transparent)}
.card-ic svg{width:17px;height:17px;fill:none;stroke:var(--b-300);stroke-width:1.7}
.card p{color:var(--fg-mid);font-size:13.4px;margin-top:7px;line-height:1.7}
.cmp{border-radius:var(--r-lg);overflow:hidden;box-shadow:inset 0 0 0 1px var(--line)}
.cmp table{width:100%;border-collapse:collapse;font-size:13.4px}
.cmp th,.cmp td{padding:13px 15px;text-align:left;border-bottom:1px solid var(--line)}
.cmp thead th{background:var(--surface);font-size:12.2px;font-weight:600;color:var(--fg-mid)}
.cmp tbody th{font-weight:500;color:var(--fg-mid);width:26%}
.cmp tr:last-child th,.cmp tr:last-child td{border-bottom:none}
.col-them{color:var(--fg-dim)}
.col-us{color:var(--fg);background:color-mix(in srgb,var(--b-500) 7%,transparent);font-weight:500}
thead .col-us{color:var(--b-300);font-weight:600}
@media (max-width:640px){.cmp table{font-size:12.4px}.cmp th,.cmp td{padding:10px 11px}}
.cta{padding:66px 0 76px}
.cta-box{text-align:center;padding:44px 30px;border-radius:var(--r-xl);
  background:radial-gradient(ellipse 80% 130% at 50% 0%,rgba(0,96,240,.16),transparent 72%),var(--surface);
  box-shadow:inset 0 0 0 1px var(--line)}
.cta-box p{color:var(--fg-mid);margin:13px 0 24px;font-size:14.6px}
footer{border-top:1px solid var(--line);padding:26px 0;background:var(--surface)}
.foot-in{display:flex;align-items:center;justify-content:space-between;gap:16px;
  flex-wrap:wrap;font-size:12.6px;color:var(--fg-dim)}
.foot-links{display:flex;gap:17px;flex-wrap:wrap}
.foot-links a{transition:color .2s var(--glide)}
.foot-links a:hover{color:var(--fg)}
/* 复制成功的浮层提示 */
.toast{position:fixed;bottom:26px;left:50%;transform:translate(-50%,80px);z-index:120;
  padding:10px 17px;border-radius:var(--r);background:var(--bg-soft);
  box-shadow:0 0 0 1px var(--line),0 14px 40px -10px rgba(0,0,0,.6);
  font-size:13px;opacity:0;transition:all .3s var(--swift);pointer-events:none}
.toast.show{opacity:1;transform:translate(-50%,0)}
</style>
</head>
<body>
<!-- ============================================================================
     图标精灵：lucide 的真实路径数据（MIT），内联而不是走 iconfont CDN。
     两个原因：一是应用下发的 CSP 只放行 'self'，任何外链字体/脚本都会被拦；
     二是 lucide 正是这个项目前端已有的依赖（lucide-react），路径数据同源，
     所以落地页和面板画出来的图标是同一套字形，不会一个圆头一个方头。

     lucide 的标准属性：viewBox 0 0 24 24 / fill none / stroke currentColor /
     stroke-width 2 / linecap round / linejoin round。写在 <svg> 上由 <use> 继承。
     ========================================================================= -->
<svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false"><defs>
  <symbol id="i-play" viewBox="0 0 24 24"><path d="M5 5a2 2 0 0 1 3.008-1.728l11.997 6.998a2 2 0 0 1 .003 3.458l-12 7A2 2 0 0 1 5 19z"/></symbol>
  <symbol id="i-stop" viewBox="0 0 24 24"><rect width="18" height="18" x="3" y="3" rx="2"/></symbol>
  <symbol id="i-reset" viewBox="0 0 24 24"><path d="M3 12a9 9 0 1 0 9-9 9.75 9.75 0 0 0-6.74 2.74L3 8"/><path d="M3 3v5h5"/></symbol>
  <symbol id="i-arrow-right" viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></symbol>
  <symbol id="i-check" viewBox="0 0 24 24"><path d="M20 6 9 17l-5-5"/></symbol>
  <symbol id="i-copy" viewBox="0 0 24 24"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></symbol>
  <symbol id="i-zap" viewBox="0 0 24 24"><path d="M15.914 4a1.5 1.5 0 00-2.474-1.561l-9 9A1.5 1.5 0 005.5 14h4.002a.5.5 0 01.471.666L8.086 20a1.5 1.5 0 002.475 1.56l9-9A1.5 1.5 0 0018.5 10h-3.997a.5.5 0 01-.472-.667z"/></symbol>
  <symbol id="i-database" viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/></symbol>
  <symbol id="i-moon" viewBox="0 0 24 24"><path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/></symbol>
  <symbol id="i-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/></symbol>
  <symbol id="i-activity" viewBox="0 0 24 24"><path d="M22 12h-2.48a2 2 0 0 0-1.93 1.46l-2.35 8.36a.25.25 0 0 1-.48 0L9.24 2.18a.25.25 0 0 0-.48 0l-2.35 8.36A2 2 0 0 1 4.49 12H2"/></symbol>
  <symbol id="i-chevron-right" viewBox="0 0 24 24"><path d="m9 18 6-6-6-6"/></symbol>
</defs></svg>

<div class="ambient">
  <div class="grid-bg"></div>
  <div class="orb orb-1"></div><div class="orb orb-2"></div>
</div>

<nav id="nav">
  <div class="wrap nav-in">
    <a class="logo" href="#top"><span class="logo-mark">S</span><span>SkiAPI</span></a>
    <div class="nav-actions">
      <button class="btn btn-ghost" id="pal-open" title="⌘K">
        <span data-i="nav.search">搜索</span> <kbd>⌘K</kbd>
      </button>
      <button class="icon-btn" id="lang" title="切换语言">ZH</button>
      <button class="icon-btn" id="theme" title="切换主题" aria-label="切换主题"><svg class="ico" aria-hidden="true"><use href="#i-moon"/></svg></button>
      <a class="btn btn-ghost" href="/login" data-i="nav.login">登录</a>
      <a class="btn btn-solid" href="/login" data-i="nav.start">开始使用</a>
    </div>
  </div>
</nav>

<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div>
      <div class="eyebrow"><span class="dot"></span><span data-i="hero.eyebrow">Anthropic 协议兼容网关</span></div>
      <!-- 整句连同 <span class="accent"> 一起走 i18n：中英文里强调词位置不同，
           拆成"前缀 + 固定词"会在另一语言下语序错乱。 -->
