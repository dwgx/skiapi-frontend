let lang = localStorage.getItem('lang') || 'zh';
const ZH = {};
$$('[data-i]').forEach(el => { ZH[el.dataset.i] = el.innerHTML; });

function applyLang() {
  const dict = lang === 'en' ? I18N.en : ZH;
  $$('[data-i]').forEach(el => {
    const v = dict[el.dataset.i];
    if (v !== undefined) el.innerHTML = v;
  });
  document.documentElement.lang = lang === 'en' ? 'en' : 'zh-CN';
  $('#lang').textContent = lang === 'en' ? 'EN' : 'ZH';
  renderModels();
  paintModel();
  paintCalc();
  // 这两个控件的内容依赖语言，切换后要重刷
  window.__sseReset?.();
  window.__jsReset?.();
}
$('#lang').onclick = () => {
  lang = lang === 'en' ? 'zh' : 'en';
  localStorage.setItem('lang', lang);
  applyLang();
};
const t = (k) => (lang === 'en' ? I18N.en[k] : ZH[k]) || k;

/* ---- 揭示动画 ----------------------------------------------------------- */
const io = new IntersectionObserver((es) => {
  es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
}, {threshold:.12, rootMargin:'0px 0px -40px 0px'});
$$('.rv').forEach((el,i) => { el.style.transitionDelay = (i % 4) * 55 + 'ms'; io.observe(el); });
/* 首屏内的元素立刻显形，不等 observer 回调 —— 否则首次绘制会闪一下空白。 */
$$('.rv').forEach(el => {
  const r = el.getBoundingClientRect();
  if (r.top < innerHeight && r.bottom > 0) el.classList.add('in');
});
/* 兜底：任何不滚动的渲染场景（打印、截图工具、Lighthouse、部分内嵌浏览器）
   都不会触发 observer。3 秒后无条件全部显形，宁可少个动画也不能白页。 */
setTimeout(() => $$('.rv').forEach(el => el.classList.add('in')), 3000);

/* 导航滚动到顶部以下才显示分隔线 */
const nav = $('#nav');
addEventListener('scroll', () => nav.classList.toggle('stuck', scrollY > 8), {passive:true});

/* ---- toast ------------------------------------------------------------- */
let toastTimer;
function toast(msg) {
  const el = $('#toast');
  el.textContent = msg;
  el.classList.add('show');
  clearTimeout(toastTimer);
  toastTimer = setTimeout(() => el.classList.remove('show'), 1800);
}
</script>
<script>
'use strict';
/* ==========================================================================
   组件1：SSE 流式可视化
   流式是这个产品最核心、最难用文字讲清的能力，所以让它自己演。
   纯本地动画，不发请求 —— 落地页的 CSP connect-src 只放行 /health 那两个源，
   而且真发一次生成请求要消耗号池配额，为了首页动画去烧配额不值得。
   界面上明确标了"演示动画，非真实请求"，不含糊其辞。
   ========================================================================= */
const SSE_TPL = {
  chat: {
    label:'chat', prompt:'"讲讲这个网关"', promptEn:'"explain this gateway"',
    toks:['一个','标准','Anthropic','端点','，','背后','接','全部','模型','。'],
    toksEn:['One',' standard',' Anthropic',' endpoint',',',' every',' model',' behind',' it','.'],
  },
  think: {
    label:'thinking', prompt:'"这题怎么解"', promptEn:'"how do I solve this"',
    pre:['(','先','看','约束','条件',')'], preEn:['(','check',' the',' constraints',')'],
    toks:['答案','是','把','base_url','换掉','。'],
    toksEn:['Answer',':',' swap',' the',' base_url','.'],
  },
  tool: {
    label:'tool_use', prompt:'"查一下余额"', promptEn:'"check my balance"',
    json:['{"','name','":"','get_balance','","','input','":{}}'],
    toks:['余额','充足','，','可以','继续','。'],
    toksEn:['Balance',' is',' fine',',',' go',' ahead','.'],
  },
  code: {
    label:'code', prompt:'"写个 curl"', promptEn:'"write me a curl"',
    toks:['curl',' -X',' POST',' \\\n  ','$BASE','/v1','/messages'],
    toksEn:['curl',' -X',' POST',' \\\n  ','$BASE','/v1','/messages'],
  },
};

(() => {
  const body = $('#s-body'), term = $('#how');
  const btn = $('#s-run'), live = $('#s-live'), row = $('#tpl-row');
  const tokEl = $('#s-tok'), rateEl = $('#s-rate'), promptEl = $('#term-prompt');
  const labelEl = $('#term-label');
  let timer = null, n = 0, t0 = 0, cur = 'chat';

  function renderTabs() {
    row.innerHTML = '';
    Object.entries(SSE_TPL).forEach(([k, v]) => {
      const b = document.createElement('button');
      b.type = 'button'; b.className = 'tpl';
      b.setAttribute('aria-pressed', String(k === cur));
      b.textContent = v.label;
      b.onclick = () => { cur = k; renderTabs(); reset(); run(); };
      row.appendChild(b);
    });
  }

  function reset() {
    clearTimeout(timer); timer = null;
    body.innerHTML = ''; n = 0;
    tokEl.textContent = '0'; rateEl.textContent = '0';
    term.classList.remove('on'); live.classList.remove('on');
    const tpl = SSE_TPL[cur];
    promptEl.textContent = lang === 'en' ? tpl.promptEn : tpl.prompt;
    labelEl.textContent = 'text/event-stream · ' + tpl.label;
    setBtn(btn, 'play', t('s.run'));
  }

  function run() {
    if (timer) { reset(); return; }
    const tpl = SSE_TPL[cur];
    body.innerHTML = ''; n = 0; t0 = performance.now();
    live.classList.add('on');
    setBtn(btn, 'stop', lang === 'en' ? 'Stop' : '停止');
    // 每个模板拼出自己的序列：[文本, 种类] —— 种类决定 pill 的配色
    const en = lang === 'en';
    const seq = [];
    (en ? tpl.preEn : tpl.pre)?.forEach(w => seq.push([w, 'think']));
    (en ? tpl.jsonEn || tpl.json : tpl.json)?.forEach(w => seq.push([w, 'json']));
    (en ? tpl.toksEn : tpl.toks).forEach(w => seq.push([w, '']));

    const step = (i) => {
      if (i >= seq.length) {
        clearTimeout(timer); timer = null;
        live.classList.remove('on');
        setBtn(btn, 'play', t('s.run'));
        return;
      }
      const [w, kind] = seq[i];
      const el = document.createElement('span');
      el.className = 'tok' + (kind ? ' ' + kind : '');
      // 空格是 token 的一部分而不是分隔符，用 ␣ 显式画出来
      el.innerHTML = w.replace(/^ /, '<span class="sp">␣</span>').replace(/\n/g, '⏎');
      body.appendChild(el);
      n++;
      tokEl.textContent = String(n);
      const secs = (performance.now() - t0) / 1000;
      rateEl.textContent = secs > 0 ? (n / secs).toFixed(1) : '0';
      // 抖动的间隔比匀速更像真的流：真实 SSE 的 token 间隔本来就不均匀
      timer = setTimeout(() => step(i + 1), 52 + Math.random() * 120);
    };
    step(0);
  }
  btn.onclick = run;
  renderTabs(); reset();
  window.__sseReset = reset;   // 语言切换时重刷提示词
})();

/* ==========================================================================
   组件2：延迟竞速
   两个端点的 /health 都实测，最快的那个赛道铺满、标 fastest。

   已知问题：/health 目前不返回 Access-Control-Allow-Origin，浏览器跨域读不到
   响应，fetch 会 reject。所以这里必须优雅降级 —— 探测失败时显示"无法探测"而
   不是假装有数字。在 Caddy 给 /health 补一个 ACAO 头之后，这段就会自动开始工作。
   ========================================================================= */
(() => {
  const eps = $$('.ep');
  const results = new Map();

  function paint() {
    const ok = [...results.entries()].filter(([,v]) => typeof v === 'number');
    if (!ok.length) return;
    const best = Math.min(...ok.map(([,v]) => v));
    eps.forEach(ep => {
      const host = ep.dataset.host, v = results.get(host);
      const latEl = ep.querySelector('.ep-lat'), track = ep.querySelector('.ep-track');
      if (typeof v !== 'number') return;
      latEl.className = 'ep-lat';
      latEl.innerHTML = v + '<small>ms</small>' +
        (v === best && ok.length > 1 ? '<span class="ep-fastest"><svg class="ico ico-sm" aria-hidden="true">'
        + '<use href="#i-zap"/></svg>' + t('ep.fastest') + '</span>' : '');
      // 越快越长：best 铺满，其余按反比
      track.style.width = Math.max(12, (best / v) * 100) + '%';
    });
  }

  async function probe(ep) {
    const host = ep.dataset.host;
    const latEl = ep.querySelector('.ep-lat');
    const t0 = performance.now();
    try {
      const ctl = new AbortController();
      const timeout = setTimeout(() => ctl.abort(), 6000);
      await fetch('https://' + host + '/health', {cache:'no-store', signal:ctl.signal});
      clearTimeout(timeout);
      results.set(host, Math.round(performance.now() - t0));
    } catch {
      // 跨域被拦或网络不通都会走到这里。不猜、不编数字。
      results.set(host, null);
      latEl.className = 'ep-lat failed';
      latEl.textContent = t('ep.failed');
    }
    paint();
  }
  eps.forEach(probe);

  /* 选中端点 → 同步所有展示 URL */
  function select(ep) {
    eps.forEach(e => e.setAttribute('aria-pressed', String(e === ep)));
    const url = 'https://' + ep.dataset.host;
    $('#ep-url').textContent = url;
    $('#ep-url-plain').textContent = url;
    $('#term-url').textContent = url;
  }
  eps.forEach(ep => ep.addEventListener('click', () => select(ep)));

  /* 复制 */
  async function copy(text, btn) {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      // 非 HTTPS 或权限被拒时 clipboard API 不可用，退回选中文本让用户自己按 ⌘C
      const ta = document.createElement('textarea');
      ta.value = text; document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); } catch {}
      ta.remove();
    }
    const orig = btn.textContent;
    setBtn(btn, 'check', ''); btn.classList.add('done');
    toast(t('toast.copied'));
    setTimeout(() => { btn.textContent = orig; btn.classList.remove('done'); }, 1400);
  }
  $('#ep-copy').onclick = (e) => copy('export ANTHROPIC_BASE_URL=' + $('#ep-url').textContent, e.currentTarget);
  $('#ep-copy-url').onclick = (e) => copy($('#ep-url-plain').textContent, e.currentTarget);
})();
</script>
<script>
'use strict';
/* ==========================================================================
   组件3：模型切换器
   把"换模型只改 model 字段"从一句话变成一个能点的动作。
   ========================================================================= */
let curModel = MODELS[0];

function renderModels() {
  const box = $('#mdl-switch');
  if (!box) return;
  box.innerHTML = '';
  MODELS.forEach(m => {
    const b = document.createElement('button');
    b.type = 'button';
    b.className = 'chip' + (m.claude ? ' chip-claude' : '');
