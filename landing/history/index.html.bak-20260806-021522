    box.appendChild(b);
  });
}

let use1m = false;

function modelString() { return curModel.id + (use1m ? CTX_1M : ''); }

function paintModel(flash) {
  const cmd = $('#mdl-cmd'), tm = $('#term-model'), meta = $('#term-meta');
  if (!cmd) return;
