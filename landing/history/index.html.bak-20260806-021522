    toast(t('toast.copied'));
    setTimeout(() => { btn.textContent = orig; btn.classList.remove('done'); }, 1400);
  };
})();

/* ==========================================================================
   组件5：双轨竞速
   两条轨道同时推进。Sonnet 先到（更快），Opus 后到但输出更长（推理更深）——
   这是两个模型真实的取舍方向，不是随机数。
   纯本地动画，界面上标了"非真实请求"：真跑两次生成要烧号池配额。
   ========================================================================= */
function paintCalc() { /* 保留空实现：applyLang() 会调用它，改语言时不该报错 */ }

(() => {
  const btn = $('#race-run');
  if (!btn) return;
  const lanes = $$('.race-lane').map(el => ({
    el,
    fill: el.querySelector('.race-fill'),
    out:  el.querySelector('.race-out'),
    tEl:  el.querySelector('.race-t'),
    rEl:  el.querySelector('.race-r'),
    // Sonnet 更快但输出短，Opus 更慢但更长 —— 反映真实取舍
    isSonnet: el.dataset.lane === 'sonnet',
  }));
  const TEXT = {
    sonnet: ['用','Sonnet','：','快','、','够用','。'],
    opus:   ['用','Opus','：','推理','更','深','，','长','任务','更','稳','。'],
  };
  let timers = [], running = false;

  function reset() {
    timers.forEach(clearTimeout); timers = [];
    lanes.forEach(l => {
      l.fill.style.width = '0';
      l.out.innerHTML = '';
      l.tEl.textContent = '—';
      l.rEl.textContent = '—';
      l.el.classList.remove('win');
    });
  }

  function run() {
    if (running) { running = false; reset(); setBtn(btn, 'play', t('race.run')); return; }
    reset();
    running = true;
    setBtn(btn, 'reset', lang === 'en' ? 'Reset' : '重置');
    let done = 0;

    lanes.forEach(l => {
      const words = l.isSonnet ? TEXT.sonnet : TEXT.opus;
      const gap = l.isSonnet ? 95 : 165;   // Sonnet 每个 token 更快
      const t0 = performance.now();
      const step = (i) => {
        if (!running) return;
        if (i >= words.length) {
          done++;
          // 先跑完的标 win
          if (done === 1) l.el.classList.add('win');
          if (done === lanes.length) { running = false; setBtn(btn, 'play', t('race.run')); }
          return;
        }
        const sp = document.createElement('span');
        sp.className = 'tok';
        sp.textContent = words[i];
        l.out.appendChild(sp);
        l.fill.style.width = ((i + 1) / words.length * 100) + '%';
        const secs = (performance.now() - t0) / 1000;
        l.tEl.textContent = secs.toFixed(1);
        l.rEl.textContent = (( i + 1) / secs).toFixed(1);
        timers.push(setTimeout(() => step(i + 1), gap + Math.random() * 60));
      };
      step(0);
    });
  }
  btn.onclick = run;
})();

/* ==========================================================================
   组件6：命令面板 ⌘K
   只放真正有用的动作：跳区块、复制端点、切模型、切主题。
   ========================================================================= */
(() => {
  const mask = $('#pal-mask'), input = $('#pal-in'), list = $('#pal-list');
  let items = [], sel = 0;

  const build = () => {
    const out = [
      {ic:'zap', label:t('ep.title'), sub:'endpoints', act:() => location.hash = '#endpoints'},
      {ic:'database', label:t('mdl.title'), sub:'models',  act:() => location.hash = '#models'},
      {ic:'copy', label:t('pal.copy') + ' ' + $('#ep-url-plain').textContent, sub:'copy',
       act:async () => { await navigator.clipboard.writeText($('#ep-url-plain').textContent).catch(()=>{}); toast(t('toast.copied')); }},
      {ic:'moon', label:t('pal.theme'), sub:'theme', act:() => tBtn.click()},
    ];
    MODELS.forEach(m => out.push({
      ic:'M', label:m.id, sub:t('pal.model'),
      act:() => { curModel = m; renderModels(); paintModel(true); }
    }));
    return out;
  };

  function render(q) {
    const all = build();
    items = q ? all.filter(i => (i.label + ' ' + i.sub).toLowerCase().includes(q.toLowerCase())) : all;
    sel = 0;
    if (!items.length) { list.innerHTML = '<div class="pal-empty">' + t('pal.empty') + '</div>'; return; }
    list.innerHTML = '';
    items.forEach((it, i) => {
      const row = document.createElement('div');
      row.className = 'pal-item';
      row.setAttribute('role', 'option');
      row.setAttribute('aria-selected', String(i === sel));
      row.innerHTML = '<span class="pal-ic"><svg class="ico" aria-hidden="true"><use href="#i-' +
                      it.ic + '"/></svg></span><span>' + it.label +
                      '</span><span class="sub">' + it.sub + '</span>';
      row.onclick = () => { it.act(); close(); };
      list.appendChild(row);
    });
  }
  const rows = () => [...list.querySelectorAll('.pal-item')];
  function move(d) {
    if (!items.length) return;
    sel = (sel + d + items.length) % items.length;
    rows().forEach((r, i) => r.setAttribute('aria-selected', String(i === sel)));
    rows()[sel]?.scrollIntoView({block:'nearest'});
  }
  function open() { mask.classList.add('open'); input.value = ''; render(''); input.focus(); }
  function close() { mask.classList.remove('open'); }

  $('#pal-open').onclick = open;
  input.oninput = () => render(input.value);
  mask.onclick = (e) => { if (e.target === mask) close(); };
  input.onkeydown = (e) => {
    if (e.key === 'ArrowDown') { move(1); e.preventDefault(); }
    else if (e.key === 'ArrowUp') { move(-1); e.preventDefault(); }
    else if (e.key === 'Enter') { items[sel]?.act(); close(); }
    else if (e.key === 'Escape') close();
  };
  addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); open(); }
    else if (e.key === 'Escape' && mask.classList.contains('open')) close();
  });
})();

/* ==========================================================================
   j space
   --------------------------------------------------------------------------
   概念：模型吐 token 之前，推理发生在一个几千维的向量空间里。
   token 只是它往外的投影 —— 你看到的文字是果，这里的运动是因。

   画法：
   - 左边 canvas 是那个空间的二维投影（真实是 4096 维，投到平面上看）。
     亮点是当前状态，淡线是走过的轨迹，陶土色的点是这一步的候选方向。
   - 右边是下一个 token 的概率分布。采样发生的瞬间，分布塌缩成一个词，
     左边的点随之跳到新位置 —— 两边是同一件事的两个视角。
   - temperature 高时候选更分散、采样更随机；低时几乎总取最大那个。

   配色取 smartcli fx/theme.py 的 ocean stops。
   ========================================================================= */
(() => {
  const cv = $('#js-canvas');
  if (!cv) return;
  const ctx = cv.getContext('2d');
  const predBox = $('#pred'), textEl = $('#js-text'), stepEl = $('#js-step');
  const runBtn = $('#js-run'), stepBtn = $('#js-step-btn'), tempIn = $('#js-temp');

  // ocean 主题的 RGB stops，和 favicon 的蓝带几乎重合
  const OCEAN = [[3,10,40],[10,60,130],[20,140,200],[90,210,230],[220,250,255]];
  const oceanAt = (t) => {
    t = Math.max(0, Math.min(1, t)) * (OCEAN.length - 1);
    const i = Math.min(OCEAN.length - 2, Math.floor(t)), f = t - i;
    const a = OCEAN[i], b = OCEAN[i + 1];
    return `rgb(${a[0]+(b[0]-a[0])*f|0},${a[1]+(b[1]-a[1])*f|0},${a[2]+(b[2]-a[2])*f|0})`;
  };

  // 每一步的候选 token 与基础概率（示意值，不是真实模型输出）
  const STEPS = [
    [['一个',.62],['标准',.19],['把',.11],['SkiAPI',.08]],
    [['标准',.55],['统一',.24],['单一',.13],['普通',.08]],
    [['Anthropic',.71],['OpenAI',.13],['HTTP',.10],['REST',.06]],
    [['端点',.66],['接口',.20],['协议',.09],['地址',.05]],
    [['，',.58],['。',.22],['就',.12],['即',.08]],
    [['背后',.49],['后面',.27],['里面',.15],['下游',.09]],
    [['接',.61],['连',.21],['是',.11],['有',.07]],
    [['全部',.64],['所有',.23],['各家',.09],['多个',.04]],
    [['模型',.83],['上游',.10],['厂商',.05],['服务',.02]],
    [['。',.91],['了',.05],['们',.03],['呢',.01]],
  ];

  /* ---- 动画状态 ----------------------------------------------------------
     丝滑的关键：位置不是每步跳一次，而是每帧被一个弹簧拉向目标。
     采样只负责移动 target，pos 自己追上去 —— 所以看到的是滑行，不是闪现。 */
  let step = 0, built = [], playing = false;
  let pos = {x:.5, y:.5}, vel = {x:0, y:0}, target = {x:.5, y:.5};
  let trail = [];            // 每帧一个点的环形缓冲，不是每步一个 —— 曲线才连续
  let anchors = [];          // 每步落点，用来画节点
  let cands = null, probs = null, pick = -1;
  let candIn = 0;            // 候选点的入场进度 0→1
  let ripples = [];          // 采样瞬间从新位置扩散的圈
  let dust = [];             // 背景漂浮的尘埃，借 fx 的 perlin/nebula 那种底噪
  let rafId = null, last = 0, acc = 0, tGlobal = 0;
  const STEP_MS = 900;       // 自动播放时每步间隔
  const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* DPR 感知：canvas 的 CSS 宽是 100%，backing store 必须按实际像素来，
     否则在 Retina 上一切都是糊的。 */
  let W = 0, H = 0;
  function resize() {
    const r = cv.getBoundingClientRect();
    if (!r.width) return;
    const dpr = Math.min(devicePixelRatio || 1, 2);
    W = r.width; H = r.height || 300;
    cv.width = Math.round(W * dpr);
    cv.height = Math.round(H * dpr);
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
  }
  addEventListener('resize', resize, {passive:true});

  // 背景尘埃：极慢的漂移，给空间一点体积感
  for (let i = 0; i < 46; i++) {
    dust.push({x:Math.random(), y:Math.random(),
               vx:(Math.random()-.5)*.004, vy:(Math.random()-.5)*.004,
               r:Math.random()*1.3+.4, a:Math.random()*.32+.06});
  }

  // 用固定种子的伪随机：同一步的候选点位置每次都一样，视觉才稳定
  const seeded = (i, j) => {
    const s = Math.sin(i * 127.1 + j * 311.7) * 43758.5453;
    return s - Math.floor(s);
  };

  function softmax(cands, temp) {
    // temp 越高分布越平；越低越尖（趋近 argmax）
    const logits = cands.map(([, p]) => Math.log(Math.max(p, 1e-6)) / temp);
    const mx = Math.max(...logits);
    const ex = logits.map(l => Math.exp(l - mx));
    const sum = ex.reduce((a, b) => a + b, 0);
    return ex.map(e => e / sum);
  }

  const candPos = (j, p, from) => {
    const ang = seeded(step, j) * Math.PI * 2;
    const dist = .07 + (1 - p) * .13;
    return {x: from.x + Math.cos(ang) * dist, y: from.y + Math.sin(ang) * dist * .8};
  };

  function draw() {
    if (!W) resize();
    if (!W) return;
    ctx.clearRect(0, 0, W, H);

    // --- 背景尘埃 ---
    dust.forEach(d => {
      ctx.fillStyle = `rgba(120,190,230,${d.a})`;
      ctx.beginPath(); ctx.arc(d.x * W, d.y * H, d.r, 0, 7); ctx.fill();
    });

    // --- 轨迹：每帧一个点的缓冲，画成一条连续曲线 ---
    if (trail.length > 1) {
      ctx.lineJoin = 'round'; ctx.lineCap = 'round';
      for (let i = 1; i < trail.length; i++) {
        const f = i / trail.length;            // 越新越亮越粗
        ctx.strokeStyle = oceanAt(.32 + f * .42);
        ctx.globalAlpha = f * f * .8;          // 平方衰减：尾巴淡得更自然
        ctx.lineWidth = .5 + f * 2.1;
        ctx.beginPath();
        ctx.moveTo(trail[i-1].x * W, trail[i-1].y * H);
        ctx.lineTo(trail[i].x * W, trail[i].y * H);
        ctx.stroke();
      }
      ctx.globalAlpha = 1;
    }

    // --- 每步的落点 ---
    anchors.forEach((p, i) => {
      const f = anchors.length > 1 ? i / (anchors.length - 1) : 1;
      ctx.fillStyle = oceanAt(.3 + f * .35);
      ctx.globalAlpha = .35 + f * .4;
      ctx.beginPath(); ctx.arc(p.x * W, p.y * H, 2.3, 0, 7); ctx.fill();
    });
    ctx.globalAlpha = 1;

    // --- 采样瞬间的扩散圈 ---
    ripples.forEach(r => {
      ctx.strokeStyle = `rgba(90,210,230,${(1 - r.t) * .5})`;
      ctx.lineWidth = 1.4 * (1 - r.t) + .3;
      ctx.beginPath(); ctx.arc(r.x * W, r.y * H, r.t * 40, 0, 7); ctx.stroke();
    });

    // --- 候选方向：从当前位置长出去，带入场进度与呼吸 ---
    if (cands && candIn > 0.01) {
      const ease = 1 - Math.pow(1 - candIn, 3);
      cands.forEach((c, j) => {
        const cp = candPos(j, probs[j], target);
        const x0 = pos.x * W, y0 = pos.y * H;
        // 呼吸：未被选中的候选轻微脉动，暗示"它们还在竞争"
        const breathe = pick < 0 ? 1 + Math.sin(tGlobal * .0028 + j * 1.7) * .07 : 1;
        const x = x0 + (cp.x * W - x0) * ease * breathe;
        const y = y0 + (cp.y * H - y0) * ease * breathe;
        const isPick = j === pick;
        ctx.strokeStyle = isPick ? `rgba(90,210,230,${.55 * ease})`
                                 : `rgba(204,120,92,${.3 * ease})`;
        ctx.lineWidth = isPick ? 1.6 : 1;
        ctx.setLineDash(isPick ? [] : [2.5, 3]);
        ctx.beginPath(); ctx.moveTo(x0, y0); ctx.lineTo(x, y); ctx.stroke();
        ctx.setLineDash([]);
        ctx.globalAlpha = ease;
        ctx.fillStyle = isPick ? '#5ad2e6' : 'rgba(204,120,92,.78)';
        const rr = (2 + probs[j] * 5) * (isPick ? 1.25 : 1);
        ctx.beginPath(); ctx.arc(x, y, rr, 0, 7); ctx.fill();
        ctx.font = '10px ui-monospace,monospace';
        ctx.fillStyle = isPick ? '#5ad2e6' : 'rgba(147,164,196,.72)';
        ctx.fillText(c[0], x + 7, y + 3.5);
        ctx.globalAlpha = 1;
      });
    }

    // --- 当前状态：光晕随速度拉伸，动起来才有"惯性" ---
    const spd = Math.hypot(vel.x, vel.y);
    const glow = 20 + Math.min(spd * 900, 16);
    const gx = pos.x * W, gy = pos.y * H;
    const g = ctx.createRadialGradient(gx, gy, 0, gx, gy, glow);
    g.addColorStop(0, 'rgba(90,210,230,.5)');
    g.addColorStop(.5, 'rgba(20,140,200,.16)');
    g.addColorStop(1, 'rgba(90,210,230,0)');
    ctx.fillStyle = g;
    ctx.beginPath(); ctx.arc(gx, gy, glow, 0, 7); ctx.fill();
    ctx.fillStyle = '#dcfaff';
    ctx.beginPath(); ctx.arc(gx, gy, 3.6 + Math.min(spd * 200, 1.6), 0, 7); ctx.fill();
  }

  /* ---- 每帧物理 ----------------------------------------------------------
     弹簧 + 阻尼把 pos 拉向 target。dt 归一化到 60fps 的步长，
     所以 120Hz 屏和 60Hz 屏跑出来的速度一致。 */
  function physics(dt) {
    /* 临界阻尼弹簧（半隐式积分）。
       之前手调 k/damp 的版本是**欠阻尼**的：实测 pos→target 的距离
       94→81→56→24→18→36→44→5→21 一路来回，是"振铃"不是"滑行"。
       欠阻尼在这个积分器里需要 damp ≈ 1−2√k 才临界，k=.055 时约 0.53，
       而当时写的是 0.9，差得远。

       改成按时间常数 tau 推：临界阻尼下位移必定单调趋近，永不过冲，
       且 tau 有物理意义（约 tau*4 毫秒落位），不用再猜参数。 */
    const TAU = 155;                            // ms，越大越"重"
    const n = Math.min(dt, 50);                 // 掉帧时钳住，不要炸
    const w = 1 / TAU;
    // 临界阻尼：加速度 = -2w·v - w²·(x-target)
    ['x', 'y'].forEach(k => {
      const a = -2 * w * vel[k] - w * w * (pos[k] - target[k]);
      vel[k] += a * n;
      pos[k] += vel[k] * n;
    });

    // 待机时的极缓漂移：静止画面也在呼吸
    if (!playing && pick < 0) {
      target.x += Math.sin(tGlobal * .00021) * .00013 * n;
      target.y += Math.cos(tGlobal * .00017) * .00011 * n;
      target.x = Math.max(.1, Math.min(.9, target.x));
      target.y = Math.max(.12, Math.min(.88, target.y));
    }

    // 轨迹缓冲：每帧记一点，上限 150
    trail.push({x:pos.x, y:pos.y});
    if (trail.length > 150) trail.shift();

    if (candIn < 1) candIn = Math.min(1, candIn + .032 * n);   // 候选淡入慢一点，别抢戏

    ripples.forEach(r => { r.t += .022 * n; });
    ripples = ripples.filter(r => r.t < 1);

    dust.forEach(d => {
      d.x += d.vx * n * .01; d.y += d.vy * n * .01;
      if (d.x < 0) d.x += 1; if (d.x > 1) d.x -= 1;
      if (d.y < 0) d.y += 1; if (d.y > 1) d.y -= 1;
    });
  }

  function frame(now) {
    rafId = requestAnimationFrame(frame);
    const dt = last ? Math.min(now - last, 50) : 16.67;
    last = now; tGlobal = now;
    physics(dt);
    draw();
    // 自动播放的节拍也走这个循环，不再单独开 setTimeout
    if (playing) {
      acc += dt;
      if (acc >= STEP_MS) { acc = 0; if (!doStep()) return; }
    }
  }

  function renderPred(cands, probs, pickIdx) {
    predBox.innerHTML = '';
    cands.forEach((c, j) => {
      const row = document.createElement('div');
      row.className = 'pred-row' + (j === pickIdx ? ' picked' : '');
      const tok = c[0].replace(/^ /, '<span class="sp">␣</span>');
      row.innerHTML = '<span class="pred-tok">' + tok + '</span>' +
        '<span class="pred-bar"><i style="width:' + (probs[j] * 100).toFixed(1) + '%"></i></span>' +
        '<span class="pred-p">' + (probs[j] * 100).toFixed(1) + '%</span>';
      predBox.appendChild(row);
    });
  }

  /* 一步 = 亮出候选 → 采样 → 把 target 挪过去。
     移动本身交给 physics 每帧插值，这里只改目标。 */
  function doStep() {
    if (step >= STEPS.length) {
      playing = false;
      setBtn(runBtn, 'play', t('js.run'));
      return false;
    }
    const temp = tempIn.checked ? 1.5 : 0.6;
    cands = STEPS[step];
    probs = softmax(cands, temp);
    let r = Math.random(), p = 0, a = 0;
    for (let j = 0; j < probs.length; j++) { a += probs[j]; if (r <= a) { p = j; break; } }
    pick = p;
    candIn = 0;                         // 候选重新入场
    renderPred(cands, probs, pick);
    stepEl.textContent = 'step ' + (step + 1);

    const cp = candPos(pick, probs[pick], target);
    anchors.push({x:target.x, y:target.y});
    target = {x: Math.max(.09, Math.min(.91, cp.x)),
              y: Math.max(.11, Math.min(.89, cp.y))};
    ripples.push({x:target.x, y:target.y, t:0});
    built.push(cands[pick][0]);
    textEl.textContent = built.join('');
    step++;
    return true;
  }

  function reset() {
    playing = false; acc = 0;
    step = 0; built = []; anchors = []; trail = []; ripples = [];
    cands = null; probs = null; pick = -1; candIn = 0;
    pos = {x:.5, y:.5}; vel = {x:0, y:0}; target = {x:.5, y:.5};
    textEl.textContent = '';
    stepEl.textContent = 'step 0';
    predBox.innerHTML = '';
    setBtn(runBtn, 'play', t('js.run'));
  }

  function play() {
    if (playing) { reset(); return; }
    if (step >= STEPS.length) reset();
    playing = true; acc = 0;
    setBtn(runBtn, 'reset', lang === 'en' ? 'Reset' : '重置');
    doStep();
  }

  runBtn.onclick = play;
  stepBtn.onclick = () => { playing = false; doStep(); };
  tempIn.addEventListener('change', () => { if (step > 0) reset(); });
  $('#js-dims').textContent = '4096d → 2d';

  resize();
  reset();
  /* 只在进入视口时跑循环 —— 页面滚出去还在 rAF 是白烧电池。
     prefers-reduced-motion 时只画一帧静态图。 */
  if (REDUCED) {
    draw();
  } else {
    const vis = new IntersectionObserver((es) => {
      es.forEach(e => {
        if (e.isIntersecting && !rafId) { last = 0; rafId = requestAnimationFrame(frame); }
        else if (!e.isIntersecting && rafId) { cancelAnimationFrame(rafId); rafId = null; }
      });
    }, {threshold:.05});
    vis.observe(cv);
  }
  window.__jsReset = reset;
  // 只为自动化验证暴露内部状态：像素采样分不清亮点/候选/涟漪，读不准
  window.__jsProbe = () => ({pos:{...pos}, target:{...target}, vel:{...vel},
                             trail:trail.length, step, playing, fps:1000/Math.max(1,tGlobal-last||16)});
})();

/* ---- 启动 --------------------------------------------------------------- */
if (lang === 'en') applyLang(); else { renderModels(); paintModel(); paintCalc(); }
</script>
</body>
</html>
