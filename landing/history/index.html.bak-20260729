<!DOCTYPE html>
<html lang="zh-CN" class="dark">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>SkiAPI — Anthropic 协议兼容网关</title>
<style>
/* ============ tokens ============
   primary 青绿沿用 sub2api 后台色板，保证落地页与面板同一套视觉语言。
   clay 是 Anthropic 品牌陶土色，只在与 Claude 直接相关的元素上出现。 */
:root{
  --primary-300:#5eead4; --primary-400:#2dd4bf; --primary-500:#14b8a6; --primary-600:#0d9488;
  --clay:#cc785c; --clay-soft:#e0a48b;
  --bg:#050c0b; --bg-soft:#08120f; --surface:rgba(255,255,255,.024);
  --line:rgba(255,255,255,.07); --line-strong:rgba(45,212,191,.22);
  --fg:#f2f7f6; --fg-mid:#9fb3b0; --fg-dim:#66807c;
  --mono:ui-monospace,SFMono-Regular,Menlo,"Fira Code",monospace;
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",sans-serif;
}
html:not(.dark){
  --bg:#fbfdfd; --bg-soft:#f2f8f7; --surface:rgba(255,255,255,.72);
  --line:rgba(15,23,42,.09); --line-strong:rgba(13,148,136,.25);
  --fg:#0b1a18; --fg-mid:#4a615d; --fg-dim:#7d938f;
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  background:var(--bg); color:var(--fg); font-family:var(--sans);
  -webkit-font-smoothing:antialiased; line-height:1.6; overflow-x:hidden;
  transition:background .4s ease,color .4s ease;
}
.wrap{max-width:1120px;margin:0 auto;padding:0 24px}
section{position:relative;z-index:1}
a{color:inherit;text-decoration:none}

/* ============ ambient background ============ */
.ambient{position:fixed;inset:0;z-index:0;pointer-events:none;overflow:hidden}
.orb{position:absolute;border-radius:50%;filter:blur(90px);opacity:.5}
.orb-1{top:-180px;right:-140px;width:520px;height:520px;background:radial-gradient(circle,rgba(20,184,166,.28),transparent 70%)}
.orb-2{top:42%;left:-200px;width:460px;height:460px;background:radial-gradient(circle,rgba(204,120,92,.15),transparent 70%)}
.orb-3{bottom:-160px;right:10%;width:480px;height:480px;background:radial-gradient(circle,rgba(20,184,166,.14),transparent 70%)}
.grid-bg{
  position:absolute;inset:0;
  background-image:linear-gradient(rgba(45,212,191,.045) 1px,transparent 1px),
                   linear-gradient(90deg,rgba(45,212,191,.045) 1px,transparent 1px);
  background-size:64px 64px;
  mask-image:radial-gradient(ellipse 80% 60% at 50% 0%,#000 40%,transparent 100%);
}
/* ============ nav ============ */
nav{
  position:sticky;top:0;z-index:50;backdrop-filter:blur(16px);
  background:color-mix(in srgb,var(--bg) 82%,transparent);
  border-bottom:1px solid transparent;transition:border-color .3s
}
nav.scrolled{border-bottom-color:var(--line)}
.nav-in{display:flex;align-items:center;justify-content:space-between;height:64px}
.logo{display:flex;align-items:center;gap:10px;font-weight:650;font-size:15.5px;letter-spacing:-.01em}
.logo-mark{
  width:30px;height:30px;border-radius:9px;display:grid;place-items:center;
  background:linear-gradient(135deg,var(--primary-400),var(--primary-600));
  color:#03110f;font-weight:800;font-size:15px;font-family:var(--mono);
  box-shadow:0 4px 14px rgba(20,184,166,.3)
}
.nav-actions{display:flex;align-items:center;gap:6px}
.icon-btn{
  display:grid;place-items:center;width:34px;height:34px;border:0;border-radius:9px;
  background:transparent;color:var(--fg-mid);cursor:pointer;transition:.2s;font-size:14px;font-family:var(--sans)
}
.icon-btn:hover{background:var(--surface);color:var(--fg)}
.btn{
  display:inline-flex;align-items:center;gap:7px;border:0;cursor:pointer;
  font-family:var(--sans);font-weight:560;white-space:nowrap;transition:.24s cubic-bezier(.4,0,.2,1)
}
.btn-ghost{padding:7px 14px;border-radius:9px;font-size:13.5px;color:var(--fg-mid)}
.btn-ghost:hover{background:var(--surface);color:var(--fg)}
.btn-solid{
  padding:8px 17px;border-radius:10px;font-size:13.5px;
  background:linear-gradient(135deg,var(--primary-400),var(--primary-600));color:#03110f;font-weight:640;
  box-shadow:0 4px 16px rgba(20,184,166,.26)
}
.btn-solid:hover{transform:translateY(-1px);box-shadow:0 7px 22px rgba(20,184,166,.38)}
.btn-lg{padding:13px 26px;border-radius:12px;font-size:15px}
.btn-line{
  padding:13px 24px;border-radius:12px;font-size:15px;
  border:1px solid var(--line-strong);background:var(--surface);color:var(--fg)
}
.btn-line:hover{border-color:var(--primary-400);transform:translateY(-1px)}

/* ============ reveal-on-scroll ============ */
.rv{opacity:0;transform:translateY(26px);transition:opacity .7s cubic-bezier(.16,1,.3,1),transform .7s cubic-bezier(.16,1,.3,1)}
.rv.in{opacity:1;transform:none}

/* ============ hero ============ */
.hero{padding:80px 0 60px}
.hero-grid{display:grid;grid-template-columns:1fr 1.05fr;gap:56px;align-items:center}
.eyebrow{
  display:inline-flex;align-items:center;gap:8px;margin-bottom:22px;
  padding:5px 13px 5px 8px;border-radius:999px;font-size:12.5px;color:var(--clay-soft);
  border:1px solid rgba(204,120,92,.28);background:rgba(204,120,92,.07)
}
.eyebrow .dot{width:6px;height:6px;border-radius:50%;background:var(--clay);box-shadow:0 0 0 3px rgba(204,120,92,.18)}
h1{font-size:clamp(37px,4.7vw,57px);line-height:1.07;font-weight:700;letter-spacing:-.032em;margin-bottom:20px}
h1 .accent{
  background:linear-gradient(105deg,var(--primary-300),var(--primary-500));
  -webkit-background-clip:text;background-clip:text;-webkit-text-fill-color:transparent
}
.lede{font-size:17px;color:var(--fg-mid);max-width:30em;margin-bottom:32px}
.hero-cta{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:20px}
.note{font-size:13px;color:var(--fg-dim)}
.note b{color:var(--primary-300);font-weight:600}

/* ============ terminal：演“限流被吃掉” ============
   这是页面唯一的动画主体，所以给足节奏——每行之间留够阅读时间，
   429 那行要停顿得让人真的注意到，切号之后才是 200。 */
.term{
  border-radius:14px;overflow:hidden;font-family:var(--mono);
  background:linear-gradient(160deg,#0d1b1a,#050e0d);
  border:1px solid rgba(45,212,191,.14);
  box-shadow:0 30px 60px -22px rgba(0,0,0,.7),0 0 0 1px rgba(255,255,255,.03),0 0 50px rgba(20,184,166,.07);
  transform:perspective(1500px) rotateY(-3.5deg) rotateX(2deg);
  transition:transform .5s cubic-bezier(.16,1,.3,1)
}
.term:hover{transform:perspective(1500px) rotateY(0) rotateX(0) translateY(-4px)}
.term-bar{
  display:flex;align-items:center;gap:7px;padding:11px 15px;
  background:rgba(255,255,255,.028);border-bottom:1px solid rgba(255,255,255,.05)
}
.term-bar i{width:11px;height:11px;border-radius:50%;display:block}
.term-bar i:nth-child(1){background:#ef4444}
.term-bar i:nth-child(2){background:#eab308}
.term-bar i:nth-child(3){background:#22c55e}
.term-bar span{flex:1;text-align:center;font-size:11.5px;color:#5c7a76;margin-right:44px}
/* 终端底色恒为深色，文字色不能继承随主题翻转的 --fg，
   否则浅色模式下未着色的文本会变近黑，在深底上不可见。 */
.term-body{padding:18px 20px;font-size:12.5px;line-height:1.95;color:#c8dbd8;min-height:270px}
.ln{opacity:0;animation:lnIn .4s cubic-bezier(.16,1,.3,1) forwards;display:flex;gap:7px;align-items:baseline;flex-wrap:wrap}
@keyframes lnIn{from{opacity:0;transform:translateY(4px)}to{opacity:1;transform:none}}
.ln.gap{margin-top:9px}
.tag{
  font-size:10.5px;padding:1px 6px;border-radius:4px;font-weight:650;flex-shrink:0;
  letter-spacing:.02em
}
.t-req{color:#38bdf8;background:rgba(56,189,248,.14)}
.t-429{color:#f87171;background:rgba(248,113,113,.16)}
.t-sw{color:#fbbf24;background:rgba(251,191,36,.15)}
.t-200{color:#22c55e;background:rgba(34,197,94,.15)}
.c-p{color:#22c55e;font-weight:700}
.c-d{color:#4d6b67;font-style:italic}
.c-hi{color:#c8dbd8}
.c-k{color:#38bdf8}
.c-s{color:#fbbf24}
.c-v{color:var(--primary-300)}
.c-warn{color:#f0a58a}
.c-ok{color:#86efac}
/* 早先给这段加了 line-through，但删除线表示"作废"，
   而这里的语义是"该账号被搁置到 3h12m 后"——读起来像渲染坏了。 */
.paused{color:#8a6a5e}
.cur{display:inline-block;width:7px;height:13px;background:#22c55e;animation:bl 1.1s step-end infinite}
@keyframes bl{0%,50%{opacity:1}51%,100%{opacity:0}}
/* 动画节奏：8 行，总时长 ~6.2s，然后 loop 重放。
   429 出现后刻意停 1.1s 再切号，让"出事了"这一拍立住。 */
.ln:nth-child(1){animation-delay:.3s}
.ln:nth-child(2){animation-delay:.85s}
.ln:nth-child(3){animation-delay:1.4s}
.ln:nth-child(4){animation-delay:2.5s}
.ln:nth-child(5){animation-delay:3.15s}
.ln:nth-child(6){animation-delay:3.8s}
.ln:nth-child(7){animation-delay:4.6s}
.ln:nth-child(8){animation-delay:5.3s}

/* ============ single-line model note ============ */
.strip{border-top:1px solid var(--line);border-bottom:1px solid var(--line);background:var(--bg-soft);padding:19px 0}
.strip-in{display:flex;align-items:center;justify-content:center;gap:10px;flex-wrap:wrap;font-size:14px;color:var(--fg-mid)}
.strip-in b{color:var(--fg);font-weight:620}
.strip-in .live{
  display:inline-flex;align-items:center;gap:6px;font-size:12px;color:var(--primary-300);
  padding:3px 10px;border-radius:999px;border:1px solid rgba(45,212,191,.26);background:rgba(20,184,166,.08)
}
.strip-in .live i{
  width:6px;height:6px;border-radius:50%;background:var(--primary-400);
  box-shadow:0 0 0 3px rgba(45,212,191,.18);animation:pulse 2.2s ease-in-out infinite
}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.45}}

/* ============ models ============
   Claude 三族占主行、其他厂商降级成 chip 一排，
   视觉权重直接对应"Claude 为主，其他为副"。 */
.mdl-main{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-bottom:22px}
.mdl-card{
  padding:22px;border-radius:15px;border:1px solid var(--line);background:var(--surface);
  transition:.32s cubic-bezier(.16,1,.3,1)
}
.mdl-card:hover{border-color:var(--line-strong);transform:translateY(-3px)}
.mdl-fam{font-size:12.5px;color:var(--clay-soft);font-weight:600;letter-spacing:.02em;margin-bottom:12px}
.mdl-list{display:flex;align-items:baseline;gap:9px;flex-wrap:wrap;margin-bottom:11px;font-family:var(--mono)}
.mdl-list b{
  font-size:26px;font-weight:700;color:var(--fg);letter-spacing:-.02em;line-height:1
}
/* Haiku 只有一个版本，大号数字单独出现时看不出"这是最新版"，
   加一个 latest 标记让三张卡的数字语义一致。 */
/* 选择器要比 .mdl-list span 更具体，否则灰色版本号的样式会盖掉这里的青色。 */
.mdl-list span.mdl-latest{
  font-family:var(--sans);font-size:10.5px;color:var(--primary-300);
  padding:2px 7px;border-radius:999px;border:1px solid rgba(45,212,191,.26);
  background:rgba(20,184,166,.08);align-self:center
}
.mdl-list span{
  font-size:13px;color:var(--fg-dim);padding:2px 7px;border-radius:6px;
  border:1px solid var(--line);background:rgba(255,255,255,.02)
}
.mdl-meta{font-size:13px;color:var(--fg-mid)}
.mdl-alt{
  display:flex;align-items:center;gap:8px;flex-wrap:wrap;justify-content:center;
  padding-top:20px;border-top:1px solid var(--line)
}
.mdl-alt-label{font-size:13px;color:var(--fg-dim);margin-right:4px}
.chip{
  font-size:12.5px;color:var(--fg-mid);padding:5px 12px;border-radius:999px;
  border:1px solid var(--line);background:var(--surface);font-family:var(--mono)
}
.chip-auto{
  color:var(--primary-300);border-color:rgba(45,212,191,.28);
  background:rgba(20,184,166,.08);font-family:var(--sans)
}

/* ============ endpoints ============
   延迟刻意不写死：服务端量到的数字是「从源站看」的排序，对亚洲用户恰好相反，
   而且节点一换就过时。所以由浏览器现场测，用户量到的是自己的真实链路。 */
.ep-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:16px;margin-bottom:18px}
.ep{
  position:relative;padding:20px 22px;border-radius:15px;border:1px solid var(--line);
  background:var(--surface);cursor:pointer;text-align:left;width:100%;
  font-family:var(--sans);transition:.28s cubic-bezier(.16,1,.3,1)
}
.ep:hover{border-color:var(--line-strong);transform:translateY(-2px)}
.ep[aria-pressed="true"]{border-color:var(--primary-400);background:rgba(20,184,166,.06)}
.ep-top{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:9px}
.ep-host{font-family:var(--mono);font-size:14.5px;color:var(--fg);font-weight:600}
.ep-geo{font-size:12.5px;color:var(--fg-mid);margin-bottom:14px}
.ep-lat{
  display:inline-flex;align-items:baseline;gap:5px;font-family:var(--mono);
  font-size:19px;font-weight:700;color:var(--primary-300);letter-spacing:-.01em
}
.ep-lat u{font-family:var(--sans);font-size:11.5px;font-weight:500;color:var(--fg-dim);text-decoration:none}
.ep-lat.pending{color:var(--fg-dim);font-size:13px;font-weight:500}
.ep-lat.failed{color:var(--clay-soft);font-size:13px;font-weight:500}
.ep-badge{
  font-size:10.5px;padding:2px 8px;border-radius:999px;white-space:nowrap;
  color:var(--primary-300);border:1px solid rgba(45,212,191,.28);background:rgba(20,184,166,.08)
}
.ep-badge.dim{color:var(--fg-dim);border-color:var(--line);background:transparent}
.ep-bar{
  display:flex;align-items:center;gap:12px;flex-wrap:wrap;justify-content:center;
  padding-top:18px;border-top:1px solid var(--line)
}
/* 刻意不用 flex + gap：等号右边的 <b> 会变成 flex 兄弟节点，gap 在 "=" 后渲染出
   一个可见空格（`VAR= value`），照着屏幕抄的命令就是坏的。整条命令保持单一
   inline 文本流。终端那段有同样的注释，是同一个坑。 */
.ep-snip{
  display:block;padding:11px 14px;border-radius:11px;
  border:1px solid var(--line);background:var(--bg-soft);
  font-family:var(--mono);font-size:12.5px;color:var(--fg-mid);
  overflow-x:auto;white-space:nowrap;flex:1;min-width:0
}
.ep-snip b{color:var(--primary-300);font-weight:600}
.ep-copy{
  flex:none;padding:6px 12px;border-radius:8px;border:1px solid var(--line-strong);
  background:var(--surface);color:var(--fg);font-size:12px;cursor:pointer;
  font-family:var(--sans);transition:.2s
}
.ep-copy:hover{border-color:var(--primary-400)}
@media(max-width:720px){.ep-grid{grid-template-columns:1fr}}

/* ============ sections ============ */
.sec{padding:80px 0}
.sec-head{text-align:center;margin-bottom:44px}
h2{font-size:clamp(25px,3vw,33px);font-weight:680;letter-spacing:-.024em;margin-bottom:11px}
.sec-sub{color:var(--fg-mid);font-size:15.5px}

.g4{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
.g3{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
.card{
  padding:24px 22px;border-radius:15px;border:1px solid var(--line);
  background:var(--surface);backdrop-filter:blur(8px);transition:.32s cubic-bezier(.16,1,.3,1)
}
.card:hover{border-color:var(--line-strong);transform:translateY(-3px);box-shadow:0 18px 38px -18px rgba(0,0,0,.5)}
.card h3{font-size:16px;font-weight:620;margin-bottom:8px;letter-spacing:-.012em}
.card p{font-size:13.5px;color:var(--fg-mid);line-height:1.68}
.card-ic{
  width:40px;height:40px;border-radius:11px;display:grid;place-items:center;margin-bottom:15px;
  background:rgba(204,120,92,.11);border:1px solid rgba(204,120,92,.2)
}
.card-ic.teal{background:rgba(20,184,166,.11);border-color:rgba(20,184,166,.22)}
.card-ic svg{width:19px;height:19px;fill:none;stroke:var(--clay-soft);stroke-width:1.7}
.card-ic.teal svg{stroke:var(--primary-400)}

/* ============ comparison ============ */
.cmp{border:1px solid var(--line);border-radius:15px;overflow:hidden;background:var(--surface)}
table{width:100%;border-collapse:collapse;font-size:14px}
th,td{padding:15px 20px;text-align:left;border-bottom:1px solid var(--line)}
tr:last-child th,tr:last-child td{border-bottom:0}
thead th{font-size:12.5px;font-weight:600;color:var(--fg-dim);background:rgba(255,255,255,.016);letter-spacing:.02em}
tbody th{font-weight:560;color:var(--fg-mid);width:20%}
.col-them{color:var(--fg-dim);width:36%}
.col-us{color:var(--fg);font-weight:560;width:44%;background:rgba(20,184,166,.045)}
thead .col-us{color:var(--primary-300);font-weight:640}
.col-us::before{content:'✓ ';color:var(--primary-400);font-weight:700}
thead .col-us::before{content:none}

/* ============ cta + footer ============ */
.cta{padding:84px 0;text-align:center}
.cta-box{
  padding:52px 32px;border-radius:20px;position:relative;overflow:hidden;
  border:1px solid var(--line-strong);
  background:radial-gradient(ellipse 70% 100% at 50% 0%,rgba(20,184,166,.1),transparent 70%),var(--surface)
}
.cta-box h2{margin-bottom:12px}
.cta-box p{color:var(--fg-mid);margin-bottom:28px;font-size:15.5px}
footer{border-top:1px solid var(--line);padding:30px 0;font-size:13px;color:var(--fg-dim)}
.foot-in{display:flex;align-items:center;justify-content:space-between;gap:16px;flex-wrap:wrap}
.foot-in a:hover{color:var(--fg)}
.foot-links{display:flex;gap:18px}

/* ============ responsive ============ */
@media(max-width:900px){
  .hero{padding:52px 0 44px}
  .hero-grid{grid-template-columns:1fr;gap:38px}
  .term{transform:none}
  .g4,.g3,.mdl-main{grid-template-columns:1fr}
  .sec{padding:58px 0}
  table{font-size:13px}th,td{padding:12px 13px}
  .foot-in{justify-content:center;text-align:center}
}
@media(max-width:480px){
  /* 窄屏下长 URL 一行放不下，缩字号并允许任意字符断行。 */
  .term-body{font-size:11px;padding:14px 13px;line-height:1.85;overflow-wrap:anywhere;min-height:0}
  /* 导航栏在 390px 上装不下「接入点 + ZH + 主题 + 登录 + 立即开始」，
     整行会溢出 25px 让全页横向可滚。锚点链接是这几个里最不重要的一个
     （下面就是那一节，滚下去就看到），所以窄屏优先保住 CTA。 */
  [data-i="nav.ep"]{display:none}
}
@media(prefers-reduced-motion:reduce){
  *{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important}
  .rv,.ln{opacity:1;transform:none}
}
</style>
</head>
<body>
<div class="ambient">
  <div class="grid-bg"></div>
  <div class="orb orb-1"></div><div class="orb orb-2"></div><div class="orb orb-3"></div>
</div>

<nav id="nav">
  <div class="wrap nav-in">
    <a class="logo" href="#top"><span class="logo-mark">S</span><span>SkiAPI</span></a>
    <div class="nav-actions">
      <a class="btn btn-ghost" href="#endpoints" data-i="nav.ep">接入点</a>
      <button class="icon-btn" id="lang" title="切换语言">ZH</button>
      <button class="icon-btn" id="theme" title="切换主题">☾</button>
      <a class="btn btn-ghost" href="/login" data-i="nav.login">登录</a>
      <a class="btn btn-solid" href="/login" data-i="nav.start">立即开始</a>
    </div>
  </div>
</nav>

<section class="hero" id="top">
  <div class="wrap hero-grid">
    <div>
      <div class="eyebrow"><span class="dot"></span><span data-i="hero.eyebrow">Anthropic 协议兼容网关</span></div>
      <!-- 整句连同 <span class="accent"> 一起走 i18n：中英文里强调词位置不同，
           拆成"前缀 + 固定词"会在另一语言下重复出现。 -->
      <h1 data-i="hero.h1">改两个环境变量，<span class="accent">直接开用</span></h1>
      <p class="lede" data-i="hero.lede">标准 Anthropic Messages 协议。Claude Code、官方 SDK、任何兼容客户端，把 base_url 指过来就能跑，代码一行不用改。</p>
      <div class="hero-cta">
        <a class="btn btn-solid btn-lg" href="/login"><span data-i="hero.cta1">立即开始</span> <span>→</span></a>
        <a class="btn btn-line" href="#how" data-i="hero.cta2">查看接入方式</a>
      </div>
      <p class="note" data-i="hero.note">注册即送试用额度 · 按量计费，<b>用多少付多少</b></p>
    </div>

    <div class="term" id="how">
      <div class="term-bar"><i></i><i></i><i></i><span>terminal</span></div>
      <div class="term-body" id="tbody">
        <div class="ln"><span class="c-d" data-i="t.l0"># 两个环境变量，就这些</span></div>
        <!-- 等号两侧不能是 flex 兄弟节点：flex gap 会在 "=" 后插入可见空格，
             渲染成 `VAR= value`，照着抄的命令是坏的。所以嵌在同一个 span 里。 -->
        <div class="ln"><span class="c-p">$</span><span class="c-k">export</span><span class="c-hi">ANTHROPIC_BASE_URL=<span class="c-v">https://api.skiapi.dev</span></span></div>
        <div class="ln"><span class="c-p">$</span><span class="c-k">export</span><span class="c-hi">ANTHROPIC_AUTH_TOKEN=<span class="c-s">sk-••••••••</span></span></div>
        <div class="ln gap"><span class="c-p">$</span><span class="c-hi">claude</span></div>
        <div class="ln"><span class="tag t-200">200</span><span class="c-ok" data-i="t.l4">已连接</span><span class="c-d" data-i="t.l4b">claude-opus-5 · 1M 上下文</span></div>
        <div class="ln gap"><span class="c-d" data-i="t.l5"># 换模型只改 model 字段，不用换端点</span></div>
        <div class="ln"><span class="c-p">$</span><span class="c-hi">claude</span><span class="c-k">--model</span><span class="c-v">claude-sonnet-4-5</span></div>
        <div class="ln"><span class="c-p">$</span><span class="cur"></span></div>
      </div>
    </div>
  </div>
</section>

<div class="strip">
  <div class="wrap strip-in">
    <span class="live"><i></i><b>Claude Opus 5</b></span>
    <span data-i="strip.note">已可用 · 一个密钥调用全部模型，无需分别申请</span>
  </div>
</div>

<section class="sec" id="models">
  <div class="wrap">
    <div class="sec-head rv">
      <h2 data-i="mdl.title">已支持的模型</h2>
      <p class="sec-sub" data-i="mdl.sub">Claude 全系为主，另有多家可选</p>
    </div>
    <div class="mdl-main rv">
      <div class="mdl-card">
        <div class="mdl-fam">Claude Opus</div>
        <div class="mdl-list"><b>5</b><span class="mdl-latest" data-i="mdl.latest">最新</span><span>4.8</span><span>4.7</span><span>4.6</span><span>4.5</span></div>
        <div class="mdl-meta" data-i="mdl.opus">最强推理 · 至高 1M 上下文</div>
      </div>
      <div class="mdl-card">
        <div class="mdl-fam">Claude Sonnet</div>
        <div class="mdl-list"><b>5</b><span class="mdl-latest" data-i="mdl.latest">最新</span><span>4.5</span></div>
        <div class="mdl-meta" data-i="mdl.sonnet">日常主力 · 速度与质量均衡</div>
      </div>
      <div class="mdl-card">
        <div class="mdl-fam">Claude Haiku</div>
        <div class="mdl-list"><b>4.5</b><span class="mdl-latest" data-i="mdl.latest">最新</span></div>
        <div class="mdl-meta" data-i="mdl.haiku">轻量快速 · 适合高频调用</div>
      </div>
    </div>
    <div class="mdl-alt rv">
      <span class="mdl-alt-label" data-i="mdl.also">还支持</span>
      <span class="chip">GPT-5.6 Sol</span><span class="chip">GPT-5.6 Luna</span><span class="chip">GPT-5.6 Terra</span>
      <span class="chip chip-auto" data-i="mdl.think">每个 Claude 另有 thinking 版</span>
    </div>
  </div>
</section>

<section class="sec" id="endpoints" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head rv">
      <h2 data-i="ep.title">选一个接入点</h2>
      <p class="sec-sub" data-i="ep.sub">同一个密钥、同一套协议，就近接入即可</p>
    </div>
    <div class="ep-grid rv">
      <button class="ep" type="button" data-host="api.skiapi.dev" aria-pressed="true">
        <div class="ep-top">
          <span class="ep-host">api.skiapi.dev</span>
          <span class="ep-badge" data-i="ep.direct">源站直连</span>
        </div>
        <div class="ep-geo" data-i="ep.geo.api">美国 · 盐湖城</div>
        <div class="ep-lat pending" data-i="ep.measuring">测量中…</div>
      </button>
      <button class="ep" type="button" data-host="as.skiapi.dev" aria-pressed="false">
        <div class="ep-top">
          <span class="ep-host">as.skiapi.dev</span>
          <span class="ep-badge dim" data-i="ep.relay">亚洲中继</span>
        </div>
        <div class="ep-geo" data-i="ep.geo.as">日本 · 东京</div>
        <div class="ep-lat pending" data-i="ep.measuring">测量中…</div>
      </button>
    </div>
    <div class="ep-bar rv">
      <div class="ep-snip">export ANTHROPIC_BASE_URL=<b id="ep-url">https://api.skiapi.dev</b></div>
      <button class="ep-copy" type="button" id="ep-copy" data-i="ep.copy">复制</button>
    </div>
  </div>
</section>

<section class="sec" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head rv"><h2 data-i="sol.title">我们帮你解决</h2><p class="sec-sub" data-i="sol.sub">简单三步，开始省心使用 Claude</p></div>
    <div class="g3 rv">
      <div class="card"><div class="card-ic teal"><svg viewBox="0 0 24 24"><path d="M21 2l-2 2m-7.61 7.61a5.5 5.5 0 11-7.778 7.778 5.5 5.5 0 017.777-7.777zm0 0L15.5 7.5m0 0l3 3L22 7l-3-3m-3.5 3.5L19 4" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <h3 data-i="sol.1t">一键接入</h3><p data-i="sol.1d">一个 API 密钥即可调用全系 Claude 模型，无需分别申请。</p></div>
      <div class="card"><div class="card-ic teal"><svg viewBox="0 0 24 24"><path d="M20 21v-2a4 4 0 00-4-4H8a4 4 0 00-4 4v2M12 3a4 4 0 100 8 4 4 0 000-8z" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <h3 data-i="sol.2t">协议统一</h3><p data-i="sol.2d">全部走标准 Anthropic Messages 格式，换模型只改 model 字段。</p></div>
      <div class="card"><div class="card-ic teal"><svg viewBox="0 0 24 24"><path d="M2.25 18.75a60 60 0 0115.8 2.1c.72.2 1.45-.34 1.45-1.1v-1M3.75 4.5H20.25M15 10.5a3 3 0 11-6 0 3 3 0 016 0z" stroke-linecap="round" stroke-linejoin="round"/></svg></div>
        <h3 data-i="sol.3t">用多少付多少</h3><p data-i="sol.3d">按实际使用量计费，支持设置配额上限，团队用量一目了然。</p></div>
    </div>
  </div>
</section>

<section class="sec" style="padding-top:0">
  <div class="wrap">
    <div class="sec-head rv"><h2 data-i="cmp.title">为什么不直接买官方订阅？</h2></div>
    <div class="cmp rv">
      <table>
        <thead><tr><th data-i="cmp.h0">对比项</th><th class="col-them" data-i="cmp.h1">分别对接各家</th><th class="col-us">SkiAPI</th></tr></thead>
        <tbody>
          <tr><th data-i="cmp.r1">接入成本</th><td class="col-them" data-i="cmp.r1a">每家一套 SDK、鉴权、错误码</td><td class="col-us" data-i="cmp.r1b">一个密钥，一套协议</td></tr>
          <tr><th data-i="cmp.r3">付费方式</th><td class="col-them" data-i="cmp.r3a">各家分别充值、分别计费</td><td class="col-us" data-i="cmp.r3b">统一余额，按量付费</td></tr>
          <tr><th data-i="cmp.r4">客户端兼容</th><td class="col-them" data-i="cmp.r4a">Claude Code 只认 Anthropic 协议</td><td class="col-us" data-i="cmp.r4b">全部模型都能用 Claude Code 调</td></tr>
        </tbody>
      </table>
    </div>
  </div>
</section>

<section class="cta">
  <div class="wrap"><div class="cta-box rv">
    <h2 data-i="cta.title">准备好开始了吗？</h2>
    <p data-i="cta.sub">注册即可获得免费试用额度，几分钟内把 Claude 接进你的工作流</p>
    <a class="btn btn-solid btn-lg" href="/login"><span data-i="cta.btn">免费注册</span> <span>→</span></a>
  </div></div>
</section>

<footer>
  <div class="wrap foot-in">
    <span>© 2026 SkiAPI. <span data-i="foot.rights">保留所有权利。</span></span>
    <div class="foot-links">
      <a href="https://github.com/Wei-Shaw/sub2api" target="_blank" rel="noopener noreferrer">GitHub</a>
      <a href="/key-usage" data-i="foot.usage">用量查询</a>
      <a href="/legal/terms" data-i="foot.terms">服务条款</a>
    </div>
  </div>
</footer>
<script>
// 主题：与后台共用 localStorage 的 'theme' 键，跨落地页/面板保持一致。
const root = document.documentElement, tBtn = document.getElementById('theme');
const saved = localStorage.getItem('theme');
const dark0 = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
root.classList.toggle('dark', dark0);
tBtn.textContent = dark0 ? '☾' : '☀';
tBtn.onclick = () => {
  const d = root.classList.toggle('dark');
  localStorage.setItem('theme', d ? 'dark' : 'light');
  tBtn.textContent = d ? '☾' : '☀';
};

const nav = document.getElementById('nav');
addEventListener('scroll', () => nav.classList.toggle('scrolled', scrollY > 8), {passive:true});

const io = new IntersectionObserver((es) => {
  es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
}, {threshold:.12, rootMargin:'0px 0px -8% 0px'});
document.querySelectorAll('.rv').forEach(el => io.observe(el));

// 终端动画循环重放：CSS animation-delay 只在首次生效，
// 所以整段重启靠移除再插回节点来强制重新触发。
// 只在终端可见时循环，滚走后停掉，避免后台无谓重排。
// 不用定时器循环：每轮重放会把 8 行全部重置成 opacity:0，
// 在 animation-delay 生效前有一段整块空白，正在阅读的人会看到终端每 8 秒闪空一次，
// 像坏掉而不像动画。改为播放一次，滚离后再回来时才重放。
function replay() {
  // 重新查询：上一轮 replaceWith 之后旧引用已脱离文档。
  const cur = document.getElementById('tbody');
  if (cur) cur.replaceWith(cur.cloneNode(true));
}
let wasAway = false;
new IntersectionObserver((es) => {
  const vis = es[0].isIntersecting;
  if (!vis) { wasAway = true; return; }
  if (wasAway) { wasAway = false; replay(); }
}, {threshold:.3}).observe(document.getElementById('how'));

// ============ 接入点：浏览器现场测延迟 ============
// 为什么不在页面里写死数字：服务端量到的是「从盐湖城源站看」的排序，
// 而亚洲用户的排序恰好相反；节点一变数字还会过时。让每个访客量自己的链路，
// 得到的才是对他有意义的那个数。
const EP_URL = document.getElementById('ep-url');
const EP_BTNS = [...document.querySelectorAll('.ep')];

function pickEndpoint(host) {
  EP_BTNS.forEach(b => b.setAttribute('aria-pressed', String(b.dataset.host === host)));
  EP_URL.textContent = 'https://' + host;
}
EP_BTNS.forEach(b => b.onclick = () => pickEndpoint(b.dataset.host));

document.getElementById('ep-copy').onclick = async (e) => {
  const txt = 'export ANTHROPIC_BASE_URL=' + EP_URL.textContent;
  try { await navigator.clipboard.writeText(txt); } catch { return; }
  const btn = e.currentTarget, was = btn.textContent;
  btn.textContent = lang === 'zh' ? '已复制' : 'Copied';
  setTimeout(() => { btn.textContent = was; }, 1400);
};

// 取 3 次里的最小值：单次采样会被 TLS 握手和调度抖动带偏，最小值最接近链路本身。
// 用 no-store + 随机串绕开缓存，否则第 2、3 次量的是本地缓存。
async function timeHost(host) {
  let best = Infinity;
  for (let i = 0; i < 3; i++) {
    const t0 = performance.now();
    try {
      await fetch(`https://${host}/health?_=${Math.random()}`, {cache:'no-store', mode:'cors'});
    } catch { return null; }
    best = Math.min(best, performance.now() - t0);
  }
  return Math.round(best);
}

// 测量结果存在这里而不是只写进 DOM：切换语言时 applyLang 会按 data-i 重刷所有
// 节点，测出来的数字和“最快/无法连接”这类动态文案没有 data-i，必须在那之后
// 由这里重新渲染一遍，否则语言切过去之后动态文案还是原来那门语言。
const EP_STATE = new Map();   // host -> ms | null
let EP_WINNER = null;

const EP_TXT = {
  zh:{fail:'无法连接', fastest:'最快'},
  en:{fail:'unreachable', fastest:'fastest'}
};

function renderEndpoints() {
  const t = EP_TXT[lang] || EP_TXT.zh;
  EP_BTNS.forEach(btn => {
    if (!EP_STATE.has(btn.dataset.host)) return;   // 还没测完，保留 data-i 的“测量中”
    const ms = EP_STATE.get(btn.dataset.host);
    const el = btn.querySelector('.ep-lat');
    el.classList.remove('pending');
    el.removeAttribute('data-i');
    if (ms === null) { el.classList.add('failed'); el.textContent = t.fail; }
    else { el.classList.remove('failed'); el.innerHTML = `${ms} <u>ms</u>`; }

    const b = btn.querySelector('.ep-badge');
    if (btn.dataset.host === EP_WINNER) {
      b.classList.remove('dim');
      b.removeAttribute('data-i');
      b.textContent = t.fastest;
    }
  });
}

async function measureAll() {
  await Promise.all(EP_BTNS.map(async btn => {
    EP_STATE.set(btn.dataset.host, await timeHost(btn.dataset.host));
  }));
  // 自动选最快的那个——用户不必自己比较数字。
  const ranked = [...EP_STATE.entries()].filter(([,ms]) => ms !== null).sort((a,b) => a[1] - b[1]);
  if (ranked.length) { EP_WINNER = ranked[0][0]; pickEndpoint(EP_WINNER); }
  renderEndpoints();
}
// 滚到该区才测：避免所有访客一进站就对两个入口各发 3 个请求。
new IntersectionObserver((es, o) => {
  if (es[0].isIntersecting) { o.disconnect(); measureAll(); }
}, {threshold:.25}).observe(document.getElementById('endpoints'));

// 双语：中文为默认，英文覆盖表只在切换时应用。
const EN = {
  'nav.login':'Log in','nav.start':'Get started','nav.ep':'Endpoints',
  'hero.eyebrow':'Anthropic-protocol compatible gateway',
  'hero.h1':'Two env vars, <span class="accent">and you’re running</span>',
  'hero.lede':'Standard Anthropic Messages protocol. Claude Code, the official SDKs, any compatible client — point base_url here and it just works. No code changes.',
  'hero.cta1':'Get started','hero.cta2':'See how it works',
  'hero.note':'Free trial credit on signup · metered — <b>pay for what you use</b>',
  't.l0':'# two environment variables, that’s it',
  't.l4':'connected','t.l4b':'claude-opus-5 · 1M context',
  't.l5':'# switching models means changing the model field, not the endpoint',
  'strip.note':'live now · one key calls every model, no separate applications',
  'mdl.title':'Models available','mdl.sub':'The full Claude family, plus others to choose from',
  'mdl.opus':'Deepest reasoning · up to 1M context',
  'mdl.sonnet':'Everyday workhorse · balanced speed and quality',
  'mdl.haiku':'Light and fast · built for high-frequency calls',
  'mdl.also':'also supported','mdl.think':'every Claude also has a thinking variant','mdl.latest':'latest',
  'ep.title':'Pick an endpoint','ep.sub':'Same key, same protocol — just connect to whichever is closer',
  'ep.direct':'direct to origin','ep.relay':'Asia relay',
  'ep.geo.api':'United States · Salt Lake City','ep.geo.as':'Japan · Tokyo',
  'ep.measuring':'measuring…','ep.copy':'Copy',
  'sol.title':'Here’s how we fix it','sol.sub':'Three steps to a calmer Claude setup',
  'sol.1t':'One key, all models','sol.1d':'A single API key calls the entire Claude family. No separate applications.',
  'sol.2t':'One protocol','sol.2d':'Everything speaks standard Anthropic Messages. Switching models means changing one field.',
  'sol.3t':'Pay for what you use','sol.3d':'Metered billing, quota ceilings, and per-member usage you can actually read.',
  'cmp.title':'Why not wire up each vendor yourself?',
  'cmp.h0':'','cmp.h1':'Integrating each vendor',
  'cmp.r1':'Integration cost','cmp.r1a':'A separate SDK, auth, and error model per vendor','cmp.r1b':'One key, one protocol',
  'cmp.r3':'Billing','cmp.r3a':'Top up and track each vendor separately','cmp.r3b':'One balance, metered',
  'cmp.r4':'Client support','cmp.r4a':'Claude Code only speaks the Anthropic protocol','cmp.r4b':'Every model works through Claude Code',
  'cta.title':'Ready to start?','cta.sub':'Sign up for free trial credit and wire Claude into your workflow in minutes',
  'cta.btn':'Sign up free',
  'foot.rights':'All rights reserved.','foot.usage':'Usage lookup','foot.terms':'Terms'
};
// hero.note 含 <b>，用 innerHTML 存取；其余走 textContent 避免注入面。
const HTML_KEYS = new Set(['hero.note','hero.h1']);
const TITLE = {zh:'SkiAPI — Anthropic 协议兼容网关', en:'SkiAPI — Anthropic-protocol compatible gateway'};
const ZH = new Map();
function collect() {
  document.querySelectorAll('[data-i]').forEach(n => {
    if (!ZH.has(n.dataset.i)) ZH.set(n.dataset.i, HTML_KEYS.has(n.dataset.i) ? n.innerHTML : n.textContent);
  });
}
collect();
let lang = localStorage.getItem('landing_lang') || 'zh';
const lBtn = document.getElementById('lang');
function applyLang() {
  lBtn.textContent = lang === 'zh' ? 'ZH' : 'EN';
  root.lang = lang === 'zh' ? 'zh-CN' : 'en';
  document.title = TITLE[lang];
  // 终端节点每 CYCLE 被替换，所以每次都重新查询而不是缓存节点引用。
  document.querySelectorAll('[data-i]').forEach(n => {
    const k = n.dataset.i;
    const v = lang === 'zh' ? ZH.get(k) : (EN[k] ?? ZH.get(k));
    if (v === undefined) return;
    if (HTML_KEYS.has(k)) n.innerHTML = v; else n.textContent = v;
  });
  // 动态文案没有 data-i，上面这轮刷不到，必须在它之后补渲染一次。
  renderEndpoints();
}
lBtn.onclick = () => { lang = lang === 'zh' ? 'en' : 'zh'; localStorage.setItem('landing_lang', lang); applyLang(); };
if (lang === 'en') applyLang();
// 终端重放后新克隆的节点是中文原文，英文模式下需要补翻。
new MutationObserver(() => { if (lang === 'en') applyLang(); })
  .observe(document.querySelector('.term'), {childList:true});
</script>
</body>
</html>
