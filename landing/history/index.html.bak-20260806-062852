<script>
'use strict';
/* ==========================================================================
   核心层：主题 · i18n · 揭示 · 进度 · toast
   --------------------------------------------------------------------------
   全站只向 window 暴露一个对象：window.SKI。三个后注入的 toy 通过它拿到
   翻译、toast、图标与揭示观察器，不必各自再实现一套。

   window.SKI 的稳定契约（注入的 toy 可以依赖）：
     SKI.$（querySelector）· SKI.$$（querySelectorAll → 数组）
     SKI.t(key)                取当前语言的文案，缺键回落到 key 本身
     SKI.lang()                'zh' | 'en'
     SKI.addI18n(lang, obj)    注册自己的文案（en 必须注册，zh 从 DOM 自动快照）
     SKI.onLangChange(fn)      语言切换后回调，用来重绘自己的内容
     SKI.captureZH(root)       把 root 内 [data-i] 的中文原文补进快照
     SKI.setIcon(el, name)     只换 <use> 的 href
     SKI.setBtn(el, name, txt) 重建「图标 + 文字」
     SKI.toast(msg)            浮层提示
     SKI.copy(text, btn)       复制并给按钮打勾
     SKI.reveal(el)            让新加入的 .rv 元素也参与揭示动画
     SKI.paintBars(root)       把 root 内 [data-w] 的进度条填到目标宽度
     SKI.MODELS / SKI.CTX_1M   模型清单与 1M 上下文后缀
   ========================================================================= */
const SKI = (() => {
  const $ = (s, r) => (r || document).querySelector(s);
  const $$ = (s, r) => [...(r || document).querySelectorAll(s)];

  /* ---- 图标辅助 ---------------------------------------------------------
     按钮的文案会随语言和状态变（播放/停止/重置），图标要跟着换。
     用 textContent 会把 <svg> 一起冲掉，所以统一走这两个函数：
     只替换 <use> 的 href，或重建「图标 + 文字」这个结构。 */
  function setIcon(el, name) {
    if (!el) return;
    const use = el.querySelector('use');
    if (use) { use.setAttribute('href', '#i-' + name); return; }
    el.innerHTML = '<svg class="ico" aria-hidden="true"><use href="#i-' + name + '"/></svg>';
  }
  function setBtn(el, name, label) {
    /* 重建整个按钮内容：图标 + 文字。
       label 必须当**纯文本**处理 —— 调用方传的是 t('...') 的结果，那份文案里
       可能带 <svg>（HTML 里写死的），直接拼进 innerHTML 会让图标被套进图标，
       渲染成两个三角叠在一起。 */
    if (!el) return;
    el.textContent = '';
    const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
    svg.setAttribute('class', 'ico ico-sm');
    svg.setAttribute('aria-hidden', 'true');
    const use = document.createElementNS('http://www.w3.org/2000/svg', 'use');
    use.setAttribute('href', '#i-' + name);
    svg.appendChild(use);
    el.appendChild(svg);
    if (label) {
      const sp = document.createElement('span');
      sp.textContent = String(label).replace(/<[^>]*>/g, '').trim();
      el.appendChild(sp);
    }
  }

  /* ---- 模型清单 ---------------------------------------------------------
     单独抽成数组，改一处即可 —— 型号会变，别散落在 DOM 里。
     `[1m]` 是 Claude 的 1M 上下文后缀，写在模型名后面：
       /model claude-opus-5[1m]
     不是独立参数，也不是 --context 之类的开关 —— 就是模型名的一部分。 */
  const MODELS = [
    {id:'claude-opus-5',   fam:'Claude Opus',   ctx:'200K', think:true},
    {id:'claude-sonnet-5', fam:'Claude Sonnet', ctx:'200K', think:true},
  ];
  const CTX_1M = '[1m]';

  /* ---- 主题：与后台共用 localStorage 的 'theme' 键，跨落地页/面板一致 ---- */
  const root = document.documentElement, tBtn = $('#theme');
  let stored = null;
  try { stored = localStorage.getItem('theme'); } catch { stored = null; }
  const dark0 = stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
  root.classList.toggle('dark', dark0);
  setIcon(tBtn, dark0 ? 'moon' : 'sun');
  tBtn.addEventListener('click', () => {
    const d = root.classList.toggle('dark');
    try { localStorage.setItem('theme', d ? 'dark' : 'light'); } catch {}
    setIcon(tBtn, d ? 'moon' : 'sun');
  });

  /* ---- i18n -------------------------------------------------------------
     中文是 DOM 里的原文，开页时快照一次；英文是下面这份字典。
     注入的 toy 用 SKI.addI18n('en', {...}) 把自己的英文并进来，
     中文由 captureZH() 从它们的 DOM 里自动取。 */
  const I18N = {en:{}, zh:{}};
  const ZH = {};
  /* 只在 JS 里出现、DOM 里没有对应 [data-i] 节点的键，必须显式给中文 ——
     captureZH() 是从 DOM 抓的，抓不到这些。基线漏了这一步，于是中文界面上
     直接显示 "mdl.yes" / "ep.fastest" / "pal.model" 这种裸键名。 */
  Object.assign(I18N.zh, {
    'ep.fastest':'最快','ep.failed':'无法探测',
    'mdl.yes':'支持','mdl.no':'—',
    'pal.empty':'没有匹配项','pal.goto':'跳转到','pal.copy':'复制',
    'pal.model':'模型','pal.theme':'切换主题',
    'toast.copied':'已复制','toast.model':'已切换到',
    's.hint':'演示动画，非真实请求',
  });
  let lang = 'zh';
  try { lang = localStorage.getItem('lang') || 'zh'; } catch {}
  const listeners = [];

  function captureZH(scope) {
    $$('[data-i]', scope).forEach(el => {
      const k = el.dataset.i;
      // 只补新键，绝不覆盖 —— 覆盖会在英文态下把英文存成"中文原文"
      if (!(k in ZH)) ZH[k] = el.innerHTML;
    });
  }
  /* look() 缺键时返回 undefined，t() 缺键时回落到 key 本身。
     两个都要：写回 DOM 必须用 look() —— 若回落成 key，缺一条英文就会把界面上
     那句话替换成 "cc.title" 这种字面量。t() 用在按钮文案那类地方，
     回落到 key 至少还能看出是哪一条缺了。 */
  const look = (k) => {
    if (lang === 'en') return I18N.en[k] !== undefined ? I18N.en[k] : undefined;
    return I18N.zh[k] !== undefined ? I18N.zh[k] : ZH[k];
  };
  const t = (k) => {
    const v = look(k);
    if (v !== undefined) return v;
    return ZH[k] !== undefined ? ZH[k] : k;
  };
  function applyLang() {
    $$('[data-i]').forEach(el => {
      const v = look(el.dataset.i);
      if (v !== undefined) el.innerHTML = v;
    });
    root.lang = lang === 'en' ? 'en' : 'zh-CN';
    $('#lang').textContent = lang === 'en' ? 'EN' : 'ZH';
    listeners.forEach(fn => { try { fn(lang); } catch (err) { console.error('[i18n] listener failed', err); } });
    /* 基线里 toy 用的是 window.__xxxReset 这一套钩子。名字保留可用：
       分开构建的 toy 只要沿用旧名字，语言切换后照样会被重刷。 */
    ['__sseReset', '__jsReset', '__raceReset', '__ccReset'].forEach(n => {
      try { window[n]?.(); } catch (err) { console.error('[i18n] ' + n + ' failed', err); }
    });
  }
  $('#lang').addEventListener('click', () => {
    lang = lang === 'en' ? 'zh' : 'en';
    try { localStorage.setItem('lang', lang); } catch {}
    applyLang();
  });

  /* ---- toast ----------------------------------------------------------- */
  let toastTimer;
  function toast(msg) {
    const el = $('#toast');
    el.textContent = msg;
    el.classList.add('show');
    clearTimeout(toastTimer);
    toastTimer = setTimeout(() => el.classList.remove('show'), 1800);
  }

  /* ---- 复制 -------------------------------------------------------------
     非 HTTPS 或权限被拒时 clipboard API 不可用，退回选中文本让用户自己按 ⌘C。 */
  async function copy(text, btn) {
    try {
      await navigator.clipboard.writeText(text);
    } catch {
      const ta = document.createElement('textarea');
      ta.value = text;
      ta.setAttribute('aria-hidden', 'true');
      ta.style.position = 'fixed';
      ta.style.opacity = '0';
      document.body.appendChild(ta);
      ta.select();
      try { document.execCommand('copy'); } catch (err) { console.warn('[copy] fallback failed', err); }
      ta.remove();
    }
    toast(t('toast.copied'));
    if (!btn) return;
    const orig = btn.textContent;
    setBtn(btn, 'check', '');
    btn.classList.add('done');
    setTimeout(() => { btn.textContent = orig; btn.classList.remove('done'); }, 1400);
  }

  /* ---- 进度条填充 -------------------------------------------------------
     宽度写在 data-w（百分比）上，进入视口后才填 —— 条"长出来"的过程本身
     就是这个组件要传达的信息，一开页就已经填满的话没人看得见。 */
  function paintBars(scope) {
    $$('[data-w]', scope).forEach(el => { el.style.width = el.dataset.w + '%'; });
  }

  /* ---- 揭示动画 --------------------------------------------------------- */
  const io = new IntersectionObserver((es) => {
    es.forEach(e => {
      if (!e.isIntersecting) return;
      e.target.classList.add('in');
      paintBars(e.target);
      io.unobserve(e.target);
    });
  }, {threshold:.12, rootMargin:'0px 0px -40px 0px'});
  function reveal(el) {
    if (!el || el.classList.contains('in')) return;
    io.observe(el);
    // 首屏内的元素立刻显形，不等 observer 回调 —— 否则首次绘制会闪一下空白
    const r = el.getBoundingClientRect();
    if (r.top < innerHeight && r.bottom > 0) { el.classList.add('in'); paintBars(el); }
  }

  /* ---- 导航：分隔线 + 阅读进度 ------------------------------------------
     进度条用 transform 而不是 width：transform 只走合成，不触发布局，
     滚动时每帧都改宽度会让整页反复重排。 */
  const nav = $('#nav'), prog = $('#scroll-prog');
  let ticking = false;
  function onScroll() {
    nav.classList.toggle('stuck', scrollY > 8);
    const max = document.documentElement.scrollHeight - innerHeight;
    const p = max > 0 ? Math.min(1, Math.max(0, scrollY / max)) : 0;
    prog.style.transform = 'scaleX(' + p.toFixed(4) + ')';
    prog.setAttribute('aria-valuenow', String(Math.round(p * 100)));
    ticking = false;
  }
  addEventListener('scroll', () => {
    if (ticking) return;
    ticking = true;
    requestAnimationFrame(onScroll);
  }, {passive:true});
  addEventListener('resize', onScroll, {passive:true});

  captureZH(document);

  return {
    $, $$, setIcon, setBtn, toast, copy, reveal, paintBars, captureZH,
    MODELS, CTX_1M,
    lang: () => lang,
    t,
    applyLang,
    addI18n(l, obj) {
      if (!I18N[l]) I18N[l] = {};
      Object.assign(I18N[l], obj || {});
    },
    onLangChange(fn) { if (typeof fn === 'function') listeners.push(fn); },
    onScroll,
    /* 基线里 applyLang() 会调用 paintCalc()。保留空实现，注入的 toy 若沿用
       旧调用点不会报错。 */
    paintCalc() {},
  };
})();
window.SKI = SKI;
/* 兼容层：三个 toy 是按基线的全局名字（$ / t / toast / setBtn / lang）分开
   构建的，这里把同一批函数按旧名字也挂到 window 上，免得它们各自实现一遍
   或直接崩掉。除此之外不再往 window 上写任何东西。 */
window.$ = SKI.$;
window.$$ = SKI.$$;
window.t = SKI.t;
window.toast = SKI.toast;
window.setIcon = SKI.setIcon;
window.setBtn = SKI.setBtn;
window.MODELS = SKI.MODELS;
window.CTX_1M = SKI.CTX_1M;
Object.defineProperty(window, 'lang', {get:() => SKI.lang(), configurable:true});
</script>
