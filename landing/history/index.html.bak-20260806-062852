   --------------------------------------------------------------------------
   旧版是一个点在二维平面上的随机游走。它失败的原因是结构性的、不是参数没调好：
   每步只移动画布宽度的 7–20%，十步之后整条轨迹还挤在一个角落，约七成画布是空的，
   读起来是一团随机曲线，而不是"模型在选词"。

   这一版把同一件事画成格阵：
     X 轴 = 生成步；每列 = 那一步的候选 token，按概率降序占据 4 个槽位；
     条长/字重/透明度 = 概率；被采样选中的那个点亮，跨列连成实线折线。
   未被选中的候选**不删掉**，只压暗 —— 组件要落地的一句话是：
   每一步都有别的可能，它走了这一条。

   另外画一条贪心路径（永远贴着 rank 0 那一行，所以是一条直的虚线）。
   采样路径在第 6/7/9 步偏离它 —— 两条线之间的落差就是"偶然性"本身。

   temperature 滑杆把这句话变成可操作的：低温分布变尖（那条路看起来是必然），
   高温分布变平（同一条路只是碰巧）。**示例路径固定不变**，变的只是它的可能性 ——
   路径跟着漂会让人以为在看另一个句子，比较不出温度做了什么。
   ========================================================================= */
(() => {
  'use strict';

  const SEC = '#jspace';
  const N_CAND = 4;                    // 每步画几个候选。4 个在 390px 下仍能读全 token

  /* 候选表：[token, T=1 时的基准概率]，按概率降序。pick = 被采样选中的下标。
     probs 只是示意值，但**必须同一步内可互换**：无论走哪个候选，句子都读得通，
     否则演示的是语法错误而不是采样。同时刻意混了三种步：
     近乎确定的（base_url 74%、逗号 83%）、真正分叉的（指/换/改 44/26/19）、
     以及三处非 argmax 的采样 —— 后者是折线唯一的形状来源。 */
  const STEPS = [
    {pick:0, c:[['把',.58],['将',.19],['用',.13],['让',.10]]},
    {pick:0, c:[['base_url',.74],['BASE_URL',.12],['endpoint',.09],['api_base',.05]]},
    {pick:2, c:[['指',.44],['换',.26],['改',.19],['配',.11]]},
    {pick:0, c:[['过来',.61],['到这',.21],['向这',.11],['过去',.07]]},
    {pick:0, c:[['，',.83],['。',.09],['；',.05],['就',.03]]},
    {pick:0, c:[['代码',.41],['业务',.29],['客户端',.19],['应用',.11]]},
    {pick:1, c:[['一行',.38],['一个字',.27],['半行',.20],['什么',.15]]},
    {pick:0, c:[['都',.52],['也',.28],['全',.13],['就',.07]]},
    {pick:1, c:[['不用',.35],['不必',.31],['无需',.21],['不得',.13]]},
    {pick:0, c:[['改',.88],['动',.06],['碰',.04],['写',.02]]},
  ];

  /* 温度档位：19 档离散值，不是连续浮点。
     连续值拖起来会抖，而且两个极端很难精确落到；离散档位一拖到底就是 0.10 / 3.00。
     中间在 0.6–1.6 之间加密 —— 分布形状变化最明显的区间在那里。
     index 9 = 1.00 正好是中点，所以 CSS 里那根默认刻记写 left:50% 是准的。 */
  const T_TABLE = [0.10,0.20,0.30,0.40,0.50,0.62,0.72,0.82,0.91,
                   1.00,1.12,1.26,1.42,1.60,1.85,2.10,2.40,2.70,3.00];
  const T_DEFAULT_IDX = 9;
  // 动画节拍：每列 340ms，十列约 3.4s，末尾留 500ms 静止再停循环
  const COL_MS = 340, HOLD_MS = 500;

  /* 画布上的文案没有 DOM 节点可挂 data-i，只能在 JS 侧带一份。
     语言每帧从 <html lang> 读 —— 页面切语言时不需要通知这个组件。 */
  const TXT = {
    zh:{step:'步', pdesc:'概率 高 → 低', base:'基准', now:'当前',
        greedy:'贪心路径（永远取最高）', chosen:'已选',
        srHead:(t)=>`温度 ${t} 时的候选分布，共 ${STEPS.length} 步：`,
        srStep:(i,tok,p,alts)=>`第 ${i} 步选中「${tok}」${p}%，其余候选 ${alts}。`},
    en:{step:'step', pdesc:'probability high → low', base:'base', now:'now',
        greedy:'greedy path (always the top)', chosen:'chosen',
        srHead:(t)=>`Candidate distribution at temperature ${t}, ${STEPS.length} steps:`,
        srStep:(i,tok,p,alts)=>`Step ${i} chose "${tok}" at ${p}%, other candidates ${alts}.`},
  };
  const dict = () => (document.documentElement.lang || 'zh').startsWith('en') ? TXT.en : TXT.zh;

  /* 温度缩放：p_i = softmax(log p_i / T)。T=1 时恰好还原基准分布。
     减最大值再 exp 是为了数值稳定 —— T=0.1 时 logit 会到 -30 量级，直接 exp 会下溢成 0。 */
  const scale = (cands, T) => {
    const logits = cands.map(([, p]) => Math.log(Math.max(p, 1e-9)) / T);
    const mx = Math.max(...logits);
    const ex = logits.map(l => Math.exp(l - mx));
    const sum = ex.reduce((a, b) => a + b, 0);
    return ex.map(e => e / sum);
  };

  /* 有效候选数 = exp(熵)（perplexity）。读作"这一步真正活着的选项有几个"：
     1.0 = 只有一条路，4.0 = 四个都一样可能。比裸熵直观得多。 */
  const perplexity = (ps) => {
    let h = 0;
    for (const p of ps) if (p > 1e-12) h -= p * Math.log(p);
    return Math.exp(h);
  };

  const crisp = (v) => Math.round(v) + 0.5;
  const clamp = (v, a, b) => Math.max(a, Math.min(b, v));
  const easeOut = (t) => 1 - Math.pow(1 - t, 3);

  // roundRect 在 Safari 16 之前没有，arcTo 版本到处都能跑
  function roundRect(ctx, x, y, w, h, r) {
    const rr = Math.min(r, w / 2, h / 2);
    ctx.beginPath();
    ctx.moveTo(x + rr, y);
    ctx.arcTo(x + w, y, x + w, y + h, rr);
    ctx.arcTo(x + w, y + h, x, y + h, rr);
    ctx.arcTo(x, y + h, x, y, rr);
    ctx.arcTo(x, y, x + w, y, rr);
    ctx.closePath();
  }

  /* 颜色从 #jspace 的 computed style 取，所以跟着页面主题走（含亮色模式）。
     CSS 里写的是 var(--accent,#A78BFA) 这种两级回退，getPropertyValue 拿到的
     已经是替换后的结果，页面没定义 --accent 时直接就是 M3 的值。 */
  function readTheme(el) {
    const cs = getComputedStyle(el);
    const g = (n, f) => (cs.getPropertyValue(n) || '').trim() || f;
    return {
      accent:g('--jsp-accent', '#A78BFA'),
      accentDim:g('--jsp-accent-dim', '#7C3AED'),
      text:g('--jsp-text', '#E3E3E3'),
      muted:g('--jsp-muted', '#A0A0A0'),
      subtle:g('--jsp-subtle', '#6E6E6E'),
      mono:g('--jsp-mono', 'ui-monospace,SFMono-Regular,Menlo,monospace'),
    };
  }
  function init(root) {
    if (!root) return;
    /* 幂等：第二次调用先把上一次的东西全撤掉 —— rAF、监听器、两个 observer。
       句柄挂在元素上而不是 window 上，不额外污染全局。 */
    if (typeof root.__jspTeardown === 'function') root.__jspTeardown();

    const cv = root.querySelector('#js-canvas');
    const stage = root.querySelector('.jsp-stage');
    if (!cv || !stage) return;
    const ctx = cv.getContext('2d');
    const tipEl = root.querySelector('#js-tip');
    const srEl = root.querySelector('#js-sr');
    const textEl = root.querySelector('#js-text');
    const runBtn = root.querySelector('#js-run');
    const slider = root.querySelector('#js-temp');
    const tValEl = root.querySelector('#js-t-val');
    const tReadEl = root.querySelector('#js-t-read');
    const effEl = root.querySelector('#js-eff');

    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ac = new AbortController();          // 一次性摘掉所有 DOM 监听
    const sig = {signal:ac.signal};

    let W = 0, H = 0, L = null, theme = readTheme(root);
    let tIdx = T_DEFAULT_IDX, temp = T_TABLE[tIdx];
    let probs = STEPS.map(s => scale(s.c, temp));
    let progress = 0;                          // 0 → STEPS.length，动画进度（单位：列）
    let playing = false, rafId = null, lastTs = 0, visible = false, started = false;
    let hover = null;                          // {i,j} 当前悬停的格子
    let fallbackTimer = null;                  // 不滚动场景的兜底（见文件末）
    const cells = [];                          // 每帧重建的命中框，供 hover 测试

    /* ---- 布局 --------------------------------------------------------------
       ≤700px 转成竖排（步在纵轴、候选在横轴）。原因很实际：390px 宽下横排
       每列只剩 ~30px，"base_url" 这种 8 字符 token 根本放不下，要么截断要么
       缩到看不清。转 90° 之后一格有 ~72px，全都能读全 —— 数据不打折。
       连线走"轨距"（gutter）：chip 之间预留的一条通道，折线只在通道里穿，
       永远不会压在别的候选文字上。 */
    /* 朝向阈值 900px（和基线 .js 那条 @media max-width:900px 同一个断点）。
       为什么不是 700：768px 宽时横排要把 10 列塞进 718px，一格只剩 42px，
       "base_url" 直接画出格子外面 —— 那是结构不够宽，不是字号没调好。
       转成竖排后一格有 ~120px，全都放得下。 */
    function layout(w) {
      const vert = w < 900;
      const n = STEPS.length;
      if (vert) {
        // 竖排：连线走"行间"的纵向轨距，所以轨距从行高里扣，不从格宽里扣
        const padT = 22, padB = 10, padL = 26, padR = 8, gut = 17;
        const rowH = 44, chipH = rowH - gut;
        const colW = (w - padL - padR) / N_CAND;
        // 上限 120：平板上列宽能到 200+，格子跟着长会让 token 和读数被拉到两端
        return {vert, n, padT, padB, padL, padR, gut, rowH, chipH, colW,
                chipW:clamp(colW - 6, 30, 120), h:padT + padB + rowH * n};
      }
      // 横排：连线走"列间"的横向轨距，从格宽里扣；行高全部给格子高度
      const padT = 20, padB = 22, padL = 10, padR = 10, gut = 30;
      const H0 = 288;
      const colW = (w - padL - padR) / n;
      const chipW = Math.max(26, colW - gut);
      const rowH = (H0 - padT - padB) / N_CAND;
      return {vert, n, padT, padB, padL, padR, gut, rowH,
              chipH:clamp(rowH - 17, 26, 44), colW, chipW, h:H0};
    }

    /* 一个格子的盒子 + 两个锚点（连线的入口/出口）。
       竖排是横排的转置：步走纵轴、候选走横轴。 */
    function cell(i, j) {
      const {vert, padT, padL, rowH, colW, chipW, chipH} = L;
      if (vert) {
        const x = padL + colW * j + (colW - chipW) / 2;
        const y = padT + rowH * i + (rowH - chipH) / 2;
        return {x, y, w:chipW, h:chipH,
                inX:x + chipW / 2, inY:y, outX:x + chipW / 2, outY:y + chipH};
      }
      const x = padL + colW * i + (colW - chipW) / 2;
      const y = padT + rowH * j + (rowH - chipH) / 2;
      return {x, y, w:chipW, h:chipH,
              inX:x, inY:y + chipH / 2, outX:x + chipW, outY:y + chipH / 2};
    }

    function resize() {
      const w = Math.round(stage.getBoundingClientRect().width);
      if (!w) return false;
      L = layout(w);
      W = w; H = L.h;
      cv.style.height = H + 'px';
      // backing store 按物理像素来，否则 Retina 上一切都是糊的。上限 2 够了，
      // 3x 只是多烧一倍填充率，肉眼分不出来。
      const dpr = Math.min(devicePixelRatio || 1, 2);
      cv.width = Math.round(W * dpr);
      cv.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      return true;
    }
    /* 低温下概率会掉到 1e-4 量级，四舍五入成 "0%" 是在说谎，显式写 <0.1%。
       1% 以上一律取整：同一列里混着 "7.0%" 和 "13%" 时，小数位读起来像精度不同，
       其实两个数一样准。 */
    const fmtP = (p) => p < 0.001 ? '<0.1%'
                      : p < 0.0095 ? (p * 100).toFixed(1) + '%'
                      : Math.round(p * 100) + '%';

    function recompute() {
      temp = T_TABLE[tIdx];
      probs = STEPS.map(s => scale(s.c, temp));
      const eff = probs.reduce((a, ps) => a + perplexity(ps), 0) / probs.length;
      if (tValEl) tValEl.value = 'T = ' + temp.toFixed(2);
      if (tReadEl) tReadEl.textContent = temp.toFixed(2);
      if (effEl) effEl.textContent = eff.toFixed(1);
    }

    /* 连线：三次贝塞尔，控制点沿"前进方向"外推。
       横排时前进方向是 +x，竖排是 +y —— 所以两个朝向的 S 弯都只在轨距里完成，
       不会横穿别的候选文字。 */
    /* 连线走"轨距"：chip 之间预留的那条通道。
       ------------------------------------------------------------------------
       第一版用一条贝塞尔直接连两个锚点，控制点只沿前进方向外推。跨 1 行还行，
       跨 2 列（竖排 step5 col0 → step6 col2）时曲线鼓出轨距，斜穿过中间那两个
       候选的文字 —— 看起来像连错了。
       改成正交折线：先走出发向、在轨距正中横move、再走进入向，拐角倒圆。
       这样线只可能出现在轨距里，永远压不到任何文字上。 */
    const CORNER = 5;

    function routePts(a, b) {
      const {vert} = L;
      const p1 = {x:a.outX, y:a.outY}, p2 = {x:b.inX, y:b.inY};
      const mid = vert ? (p1.y + p2.y) / 2 : (p1.x + p2.x) / 2;
      const same = vert ? Math.abs(p1.x - p2.x) < 0.5 : Math.abs(p1.y - p2.y) < 0.5;
      if (same) return [p1, p2];
      return vert
        ? [p1, {x:p1.x, y:mid}, {x:p2.x, y:mid}, p2]
        : [p1, {x:mid, y:p1.y}, {x:mid, y:p2.y}, p2];
    }

    // 把折线的每个内拐角替换成一段二次贝塞尔取样点，得到可按弧长截断的点列
    function roundPts(pts, r) {
      if (pts.length < 3) return pts;
      const out = [pts[0]];
      for (let i = 1; i < pts.length - 1; i++) {
        const p = pts[i], a = pts[i - 1], b = pts[i + 1];
        const la = Math.hypot(p.x - a.x, p.y - a.y), lb = Math.hypot(b.x - p.x, b.y - p.y);
        const ra = Math.min(r, la / 2), rb = Math.min(r, lb / 2);
        if (la < 0.5 || lb < 0.5) { out.push(p); continue; }
        const s = {x:p.x + (a.x - p.x) / la * ra, y:p.y + (a.y - p.y) / la * ra};
        const e = {x:p.x + (b.x - p.x) / lb * rb, y:p.y + (b.y - p.y) / lb * rb};
        out.push(s);
        for (let k = 1; k <= 5; k++) {
          const t = k / 6, u = 1 - t;
          out.push({x:u * u * s.x + 2 * u * t * p.x + t * t * e.x,
                    y:u * u * s.y + 2 * u * t * p.y + t * t * e.y});
        }
        out.push(e);
      }
      out.push(pts[pts.length - 1]);
      return out;
    }

    /* 按弧长比例画前 amount 段。逐步画入必须按弧长而不是按点数，
       否则拐角处点密、直段点疏，线会在拐角"卡一下"再突然窜出去。 */
    function connector(a, b, amount) {
      const pts = roundPts(routePts(a, b), CORNER);
      let total = 0;
      const seg = [];
      for (let i = 1; i < pts.length; i++) {
        const d = Math.hypot(pts[i].x - pts[i - 1].x, pts[i].y - pts[i - 1].y);
        seg.push(d); total += d;
      }
      const want = total * clamp(amount, 0, 1);
      ctx.beginPath();
      ctx.moveTo(pts[0].x, pts[0].y);
      let acc = 0;
      for (let i = 0; i < seg.length; i++) {
        if (acc + seg[i] >= want) {
          const t = seg[i] < 0.001 ? 0 : (want - acc) / seg[i];
          ctx.lineTo(pts[i].x + (pts[i + 1].x - pts[i].x) * t,
                     pts[i].y + (pts[i + 1].y - pts[i].y) * t);
          return;
        }
        acc += seg[i];
        ctx.lineTo(pts[i + 1].x, pts[i + 1].y);
      }
    }

    function drawAxis() {
      const {vert, n, padT, padL, padR, rowH, colW} = L;
      const d = dict();
      ctx.font = '9.5px ' + theme.mono;
      ctx.fillStyle = theme.subtle;
      ctx.globalAlpha = 0.85;
      // 「概率 高 → 低」：说明纵轴（横排）/横轴（竖排）的排序方向。
      // 不写这句的话，读者不知道上下是排名还是别的什么。
      ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic';
      ctx.fillText(d.pdesc, padL + 1, 11);
      ctx.globalAlpha = 1;

      ctx.strokeStyle = theme.subtle; ctx.globalAlpha = 0.22; ctx.lineWidth = 1;
      ctx.beginPath();
      if (vert) {
        ctx.moveTo(crisp(padL - 8), padT); ctx.lineTo(crisp(padL - 8), padT + rowH * n);
      } else {
        const y = crisp(padT + rowH * N_CAND + 3);
        ctx.moveTo(padL, y); ctx.lineTo(W - padR, y);
      }
      ctx.stroke();
      ctx.globalAlpha = 1;

      // 步号。它是 X 轴（横排）/ Y 轴（竖排）的刻度，没有它读不出"第几步"
      ctx.fillStyle = theme.subtle;
      for (let i = 0; i < n; i++) {
        const lit = progress > i + 0.4;
        ctx.globalAlpha = lit ? 0.9 : 0.4;
        ctx.fillStyle = lit ? theme.muted : theme.subtle;
        if (vert) {
          ctx.textAlign = 'right';
          ctx.fillText(String(i + 1), padL - 12, padT + rowH * i + rowH / 2 + 3.5);
        } else {
          ctx.textAlign = 'center';
          ctx.fillText(String(i + 1), padL + colW * i + colW / 2, padT + rowH * N_CAND + 16);
        }
      }
      ctx.globalAlpha = 1; ctx.textAlign = 'left';
    }
    /* 一个候选格：token 文字 + 概率条（+ 空间够时的百分数）。
       概率同时编码在三处 —— 条长、文字透明度、以及百分数本身。
       只靠透明度会让低概率项在暗底上直接消失；条长是可比较的量，才是主编码。 */
    function drawChip(i, j, p, isPick, reveal) {
      const c = cell(i, j);
      const {chipW} = L;
      const pad = 5;
      // 未选中项按概率给底透明度：高概率的候选本来就该更显眼
      const alpha = (isPick ? 1 : 0.34 + p * 0.5) * reveal;
      if (alpha <= 0.01) return;

      // 选中格：强调色底板 + 1px 描边。底板让折线从它下面穿过时不糊字
      if (isPick) {
        ctx.globalAlpha = reveal;
        roundRect(ctx, c.x, c.y, c.w, c.h, 6);
        ctx.fillStyle = theme.accent; ctx.globalAlpha = reveal * 0.15; ctx.fill();
        ctx.globalAlpha = reveal * 0.85;
        ctx.strokeStyle = theme.accent; ctx.lineWidth = 1; ctx.stroke();
      }

      /* 字号按格宽推，再用实测宽度收一次 —— "base_url" 比 "把" 宽三倍多。
         百分数用 token 的 0.84 倍字号：等号字号下 "base_url 74%" 在 79px 的格子里
         放不下，于是 step 2 整列除 rank 0 外全都没有百分数，看着像坏了。
         读数本来就是次要信息，小一号既排得下也符合层级。 */
      const label = STEPS[i].c[j][0], pct = fmtP(p);
      const room = c.w - pad * 2;
      let fs = clamp(chipW * 0.135, 8.5, 11.5);
      ctx.font = fs + 'px ' + theme.mono;
      let tw = ctx.measureText(label).width;
      while (tw > room && fs > 7.5) { fs -= 0.5; ctx.font = fs + 'px ' + theme.mono; tw = ctx.measureText(label).width; }
      const pfs = Math.max(7.5, fs * 0.84);
      ctx.font = pfs + 'px ' + theme.mono;
      const pw = ctx.measureText(pct).width;
      /* 读数放不到 token 同一行时，改放到概率条那一行的右端，条子相应缩短。
         直接不画是不行的：step 2 那一列 token 最长（base_url / BASE_URL），
         整列就它没有百分数，看起来像渲染坏了而不像"这里放不下"。 */
      const pctInline = tw + pw + fs * 0.5 <= room;

      const barH = c.h >= 34 ? 4 : 3, gapAboveBar = 4;
      const textY = c.y + (c.h - barH - gapAboveBar) / 2 + fs * 0.36;
      ctx.textAlign = 'left'; ctx.textBaseline = 'alphabetic';
      ctx.globalAlpha = alpha;
      ctx.fillStyle = isPick ? theme.accent : theme.text;
      ctx.font = fs + 'px ' + theme.mono;
      ctx.fillText(label, c.x + pad, textY);

      // 概率条：底槽 + 填充。方角，条长 = 概率。这是唯一可以互相比长短的编码
      const bx = c.x + pad, by = c.y + c.h - barH - 3;
      const bw = (c.w - pad * 2) - (pctInline ? 0 : pw + 4);

      ctx.font = pfs + 'px ' + theme.mono;
      ctx.textAlign = 'right';
      ctx.globalAlpha = alpha * (isPick ? 1 : 0.72);
      ctx.fillStyle = isPick ? theme.accent : theme.muted;
      // 同行放不下就落到条子那一行，垂直对齐到条子中线
      ctx.fillText(pct, c.x + c.w - pad, pctInline ? textY : by + barH / 2 + pfs * 0.36);
      ctx.textAlign = 'left';
      ctx.globalAlpha = reveal * 0.5;
      ctx.fillStyle = theme.subtle;
      ctx.fillRect(bx, by, bw, 1);
      ctx.globalAlpha = reveal * (isPick ? 1 : 0.62);
      ctx.fillStyle = isPick ? theme.accent : theme.accentDim;
      ctx.fillRect(bx, by, Math.max(1, bw * p), barH);
      ctx.globalAlpha = 1;

      cells.push({i, j, x:c.x, y:c.y, w:c.w, h:c.h});
    }

    function draw() {
      if (!L && !resize()) return;
      ctx.clearRect(0, 0, W, H);
      cells.length = 0;
      const n = L.n;
      drawAxis();

      /* 贪心路径：永远取 rank 0，所以它是一条贴着首行/首列的直虚线。
         它的作用是当参照 —— 采样路径在第 6/7/9 步掉下来，落差一眼可见。
         虚线 + 低透明度，读作"没走的那条"。 */
      ctx.strokeStyle = theme.muted; ctx.lineWidth = 1;
      ctx.setLineDash([2, 3]);
      for (let i = 0; i < n - 1; i++) {
        const rev = clamp(progress - i - 0.55, 0, 1);
        if (rev <= 0.01) break;
        ctx.globalAlpha = 0.42 * rev;
        connector(cell(i, 0), cell(i + 1, 0), easeOut(rev));
        ctx.stroke();
      }
      ctx.setLineDash([]); ctx.globalAlpha = 1;

      // 候选格：整列一起淡入，前 55% 的列时间给候选，后段给"选中"和连线
      for (let i = 0; i < n; i++) {
        const rev = clamp((progress - i) / 0.55, 0, 1);
        if (rev <= 0.001) continue;
        const e = easeOut(rev);
        for (let j = 0; j < N_CAND; j++) {
          drawChip(i, j, probs[i][j], j === STEPS[i].pick && progress - i > 0.55, e);
        }
      }

      /* 采样路径：实线、强调色、比虚线粗。画在候选之上但只穿轨距，不压文字。
         这是整个组件的主体 —— "它走了这一条"。 */
      ctx.strokeStyle = theme.accent; ctx.lineWidth = 1.8;
      ctx.lineCap = 'round'; ctx.lineJoin = 'round';
      for (let i = 0; i < n - 1; i++) {
        const rev = clamp(progress - i - 0.55, 0, 1);
        if (rev <= 0.01) break;
        ctx.globalAlpha = 0.9;
        connector(cell(i, STEPS[i].pick), cell(i + 1, STEPS[i + 1].pick), easeOut(rev));
        ctx.stroke();
      }
      ctx.globalAlpha = 1;

      // 已选节点：实心圆。和图例里的实心圆对应，形状本身就是"已选"的标记
      for (let i = 0; i < n; i++) {
        if (progress - i <= 0.55) continue;
        const c = cell(i, STEPS[i].pick);
        const cx = L.vert ? c.x + c.w / 2 : c.x, cy = L.vert ? c.y : c.y + c.h / 2;
        ctx.fillStyle = theme.accent;
        ctx.beginPath(); ctx.arc(cx, cy, 2.6, 0, Math.PI * 2); ctx.fill();
      }

      // 悬停高亮：加一圈描边。颜色之外还有"多了一个环"这个形状差异
      if (hover) {
        const c = cell(hover.i, hover.j);
        ctx.strokeStyle = theme.text; ctx.globalAlpha = 0.55; ctx.lineWidth = 1;
        roundRect(ctx, c.x - 1.5, c.y - 1.5, c.w + 3, c.h + 3, 7);
        ctx.stroke(); ctx.globalAlpha = 1;
      }
    }
    /* 句子：每个 token 一个 span，落定时加 .in 淡入。
       整句 textContent 逐次重写会让浏览器每步重排一次，而且没法只让新的那个淡入。 */
    function buildSentence() {
      if (!textEl) return;
      textEl.textContent = '';
      STEPS.forEach((s) => {
        const tok = s.c[s.pick][0];
        const sp = document.createElement('span');
        // 中西文混排要留四分之一字空隙。base_url 直接贴着"把"和"指"会挤成一团，
        // 这是中文排版的既有规矩，不是审美偏好。
        sp.className = 'jsp-tk' + (/[A-Za-z0-9_]/.test(tok) ? ' lat' : '');
        sp.textContent = tok;
        textEl.appendChild(sp);
      });
    }
    function syncSentence() {
      if (!textEl) return;
      const tk = textEl.children;
      for (let i = 0; i < tk.length; i++) {
        tk[i].classList.toggle('in', progress - i > 0.55);
      }
    }

    /* 无障碍摘要：canvas 只能给一个总标签，逐步的分布靠这段文字给。
       只在温度变化/播完时重建 —— 拖滑杆时逐帧重建 DOM 是纯浪费。 */
    function syncSr() {
      if (!srEl) return;
      const d = dict();
      const parts = [d.srHead(temp.toFixed(2))];
      STEPS.forEach((s, i) => {
        const ps = probs[i];
        const alts = s.c.map((c, j) => j === s.pick ? null : `${c[0]} ${fmtP(ps[j])}`)
                        .filter(Boolean).join('、');
        parts.push(d.srStep(i + 1, s.c[s.pick][0], (ps[s.pick] * 100).toFixed(1), alts));
      });
      srEl.textContent = parts.join(' ');
    }

    function hideTip() {
      if (tipEl && !tipEl.hidden) { tipEl.hidden = true; }
      if (hover) { hover = null; draw(); }
    }

    function showTip(hit, mx, my) {
      if (!tipEl) return;
      const d = dict();
      const [tok, base] = STEPS[hit.i].c[hit.j];
      const p = probs[hit.i][hit.j];
      const isPick = hit.j === STEPS[hit.i].pick;
      tipEl.textContent = '';
      const b = document.createElement('b'); b.textContent = tok;
      tipEl.appendChild(b);
      const meta = document.createElement('i');
      meta.textContent = `  ${d.step} ${hit.i + 1} · ${d.now} ${fmtP(p)} · ${d.base} ${fmtP(base)}`
                       + (isPick ? ` · ${d.chosen}` : '');
      tipEl.appendChild(meta);
      tipEl.hidden = false;
      // 贴边翻转：右侧放不下就画到指针左边，否则 tip 会被 overflow:hidden 截掉
      const tw = tipEl.offsetWidth, th = tipEl.offsetHeight;
      tipEl.style.left = clamp(mx + 12, 4, Math.max(4, W - tw - 4)) + 'px';
      tipEl.style.top = clamp(my - th - 8, 4, Math.max(4, H - th - 4)) + 'px';
    }

    function onMove(e) {
      // 触屏上 pointermove 是滑动的一部分，弹读数会挡住内容
      if (e.pointerType === 'touch') return;
      const r = cv.getBoundingClientRect();
      const mx = e.clientX - r.left, my = e.clientY - r.top;
      const hit = cells.find(c => mx >= c.x && mx <= c.x + c.w && my >= c.y && my <= c.y + c.h);
      if (!hit) { hideTip(); return; }
      if (!hover || hover.i !== hit.i || hover.j !== hit.j) { hover = {i:hit.i, j:hit.j}; draw(); }
      showTip(hit, mx, my);
    }

    function stopLoop() {
      if (rafId !== null) { cancelAnimationFrame(rafId); rafId = null; }
    }

    function frame(ts) {
      const dt = lastTs ? Math.min(ts - lastTs, 64) : 16.7;
      lastTs = ts;
      if (playing) {
        progress += dt / COL_MS;
        if (progress >= STEPS.length + HOLD_MS / COL_MS) {
          progress = STEPS.length; playing = false;
          syncSr();
        }
        draw(); syncSentence();
      }
      if (playing) rafId = requestAnimationFrame(frame);
      else { rafId = null; draw(); syncSentence(); }
    }

    function startLoop() {
      if (rafId !== null || reduced) return;
      lastTs = 0;
      rafId = requestAnimationFrame(frame);
    }

    function replay() {
      if (reduced) { progress = STEPS.length; draw(); syncSentence(); syncSr(); return; }
      progress = 0; playing = true; hideTip();
      startLoop();
    }

    function finish() {                       // 直接落终态，不动画
      progress = STEPS.length; playing = false;
      stopLoop(); draw(); syncSentence(); syncSr();
    }
    /* ---- 绑定 --------------------------------------------------------------
       全部挂在同一个 AbortController 上，teardown 一次 abort 就干净了。 */
    if (slider) {
      slider.value = String(tIdx);
      // input 而不是 change：拖动过程中就要重画，否则看不到分布在变形
      slider.addEventListener('input', () => {
        tIdx = clamp(parseInt(slider.value, 10) || 0, 0, T_TABLE.length - 1);
        recompute();
        // 温度只改分布形状，不重播动画。已经播完就停在终态继续看
        if (!playing && progress > 0 && progress < STEPS.length) progress = STEPS.length;
        draw(); syncSentence();
      }, sig);
      // 摘要重建只在松手/键盘定档后做一次，拖动中不做
      slider.addEventListener('change', syncSr, sig);
    }
    if (runBtn) runBtn.addEventListener('click', replay, sig);
    cv.addEventListener('pointermove', onMove, sig);
    cv.addEventListener('pointerleave', hideTip, sig);
    // 滚动时指针没动但格子动了，读数会停在错位置
    addEventListener('scroll', hideTip, {passive:true, signal:ac.signal});
    /* 打印时强制落终态。这一条补的是另一个洞：动画播到一半时元素被滚出视口，
       循环会（按设计）暂停在中途；此时去打印，纸上就是一张半截的格阵。
       beforeprint 是唯一能在渲染打印页之前介入的时机。 */
    addEventListener('beforeprint', finish, sig);

    /* 尺寸：ResizeObserver 跟着容器（侧栏折叠、字号变化都能捕捉），
       resize 事件只是老浏览器的兜底。用 lastW 挡住同宽回调，避免 RO 自激。 */
    let lastW = 0;
    const onResize = () => {
      const w = Math.round(stage.getBoundingClientRect().width);
      if (w === lastW) return;
      lastW = w;
      theme = readTheme(root);
      if (resize()) { draw(); }
    };
    let ro = null;
    if (typeof ResizeObserver === 'function') {
      ro = new ResizeObserver(onResize);
      ro.observe(stage);
    } else {
      addEventListener('resize', onResize, {passive:true, signal:ac.signal});
    }

    /* canvas 里的颜色是取值时快照下来的，CSS 变量变了它不会自己跟着变。
       页面的主题开关只是往 <html> 上加/去 .dark，不触发 resize、也不触发重绘，
       所以必须显式盯着 class 变化重取一次颜色 —— 否则切主题后画布还是旧配色，
       亮色页面上留一块深色格阵。 */
    const themeMo = new MutationObserver(() => {
      theme = readTheme(root);
      draw();
    });
    themeMo.observe(document.documentElement, {attributes:true, attributeFilter:['class']});

    /* 只在视口内跑 rAF —— 滚出去还在跑是白烧电池。
       同时负责"第一次进入视口自动播一次"。 */
    // boot 里挡了一次 IntersectionObserver 缺失，这里也要挡 —— 漏了这层的话
    // 老浏览器上 boot 直接调 init，然后在这一行抛 "not a constructor"，整个组件死掉
    const hasIO = typeof IntersectionObserver === 'function';
    let vis = null;
    if (!reduced && hasIO) {
      vis = new IntersectionObserver((es) => {
        es.forEach(e => {
          visible = e.isIntersecting;
          if (visible) {
            if (!started) { started = true; replay(); }
            else if (playing) startLoop();
          } else {
            stopLoop(); hideTip();
          }
        });
      }, {threshold:0.12});
      vis.observe(cv);
    }

    root.__jspTeardown = () => {
      ac.abort();
      stopLoop();
      if (ro) ro.disconnect();
      if (vis) vis.disconnect();
      themeMo.disconnect();
      clearTimeout(fallbackTimer);
      delete root.__jspTeardown;
    };

    /* 首屏就绪：先把静态骨架画出来（轴 + 步号），不要留一块空画布。 */
    recompute();
    buildSentence();
    resize();
    /* 页面的 .rv 揭示 observer 若不在（单独嵌用这三个文件时），
       元素会永远停在 opacity:0。自己补一次，和页面的 observer 加同一个 class，
       重复添加无副作用。 */
    root.querySelectorAll('.rv').forEach(el => el.classList.add('in'));

    if (reduced) {
      // 降低动效：直接终态，且**不循环**。一帧画完就没有后续了
      finish();
    } else {
      draw(); syncSr();
    }

    /* init 被调用时元素已经在视口外 —— 说明来路是 boot 的兜底计时器、或调用方
       手动调的。这两种情况下动画没人看得见，直接落终态，别再等一轮。
       正常路径（observer 在元素进入视口那一刻回调）走不到这里。 */
    const r = cv.getBoundingClientRect();
    const onScreen = r.bottom > 0 && r.top < (innerHeight || 0);
    if (!reduced && !onScreen) {
      started = true;
      finish();
    } else if (!reduced && !hasIO) {
      // 没有 IntersectionObserver 就没人负责"进视口时开播"，这里直接开
      started = true;
      replay();
    } else if (!reduced) {
      /* 兜底：元素在视口内但 observer 迟迟不回调（某些内嵌浏览器会这样）。
         3 秒后无条件落终态 —— 宁可少个动画也不能空着。 */
      fallbackTimer = setTimeout(() => {
        if (!started) { started = true; finish(); }
      }, 3000);
    }
  }

  window.initToy_jspace = init;

  /* 自启动：DOMContentLoaded 后找到 #jspace，用 IntersectionObserver 在它第一次
     进入视口时初始化。init 内部还有一个 observer 负责暂停/续跑与首播，
     这里这个只管"什么时候开始存在"，进去过一次就 disconnect。 */
  function boot() {
    const root = document.querySelector(SEC);
    if (!root || root.__jspTeardown) return;
    if (typeof IntersectionObserver !== 'function') { init(root); return; }

    let done = false;
    const go = () => { if (done) return; done = true; clearTimeout(t); io.disconnect(); init(root); };
    const io = new IntersectionObserver((es) => {
      for (const e of es) if (e.isIntersecting) { go(); return; }
    }, {threshold:0.05, rootMargin:'0px 0px -8% 0px'});
    io.observe(root);
    /* 兜底必须在**这一层**，不能放在 init 里面。
       init 只有 observer 回调时才跑，而打印、截图工具、Lighthouse、部分内嵌浏览器
       根本不滚动 —— observer 永不回调，init 永不执行，写在 init 里的兜底计时器
       也就永远不存在，那块画布会一直是空的。实测过：从不滚动的页面上
       3.8 秒后 token 显形数仍是 0、画布墨占比 0.008。 */
    const t = setTimeout(go, 3000);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, {once:true});
  } else {
    boot();
  }
})();

</script>
<script>
/* ============================================================================
   Opus vs Sonnet 竞速
   ----------------------------------------------------------------------------
   核心是速率读数的算法，其余都是壳。

   ## 旧版为什么抖

   旧版算 `rate = i / 累计秒数`。这个式子每一帧都在变小：两个 token 之间
   分子 i 不动、分母一直涨，所以速率逐帧下滑；等下一个 token 落地，i 跳一格，
   速率猛弹回去。喂给读数的是一排锯齿，指针就去追每一个齿。

   ## 为什么对"间隔"做 EMA 而不是对"速率"做

   平滑倒数会失真。rate = 1000/gap 是非线性映射：gap 大（慢）时同样的抖动
   在 rate 上被压缩，gap 小（快）时被放大。直接平滑 rate 等于给两条 lane
   施加了不同强度的滤波 —— 慢的那条看起来过度平滑、快的那条仍然抖。
   平滑 gap 再取倒数，两条 lane 的时间常数才一致。

   ## α 与死区是扫出来的，不是猜的

   2026-08-06 扫 alpha × 死区，每格跑 40 轮 240 token，量三件事：
   显示读数的方向反转次数、底层 EMA 的 sd、阶跃响应收敛到 95% 的样本数。

     alpha  死区   反转    收敛
     0.05   3.0    0.3     83     几乎不抖，但滞后约 2 秒
     0.08   3.0    2.1     32     ← 采用
     0.12   1.5    21.4    23
     0.18   1.0    61.5    18
     0.30   1.0    94.5    11

   取 alpha=0.08 + 死区 3.0：反转降到 2 次上下，收敛 32 个样本
   （Opus 速度下约 0.76 秒），两头都能接受。

   ## 一处需要更正的既有结论

   交接文档说旧式 `i/累计秒数` 会「持续振荡」、改成 EMA 后降到 0-1 次。
   同源对照（同一串到达时间戳喂两个公式）实测**不成立**：

     ema(0.18)  sd=1.92  帧间最大跳 2.88
     naive      sd=0.91  帧间最大跳 1.26     ← 旧式反而更平滑

   原因：旧式是**累计平均**，样本越多越稳，稳态下抖动只有 EMA 的一半。
   它真正的毛病不是抖，是**滞后** —— 平均了从开跑到现在的全部样本，
   速度真的变了它反应不过来，而且开局几个样本会永久拉偏整条曲线。

   所以换 EMA 的理由是「读数要反映当前速度」，不是「旧式抖」。
   而 EMA 换来的响应速度，代价就是噪声 —— 死区是为了补这个代价。
   ========================================================================= */
(() => {
  'use strict';

  /* ---- 参数 --------------------------------------------------------------
     这两个速度是**编的**，不是从网关测来的。真要标真实值，得对两个模型
     跑脚本化请求并记 token 时间戳。别让后人把这两个数当实测数据。 */
  const LANES = {
    opus:   { speed: 42, jitter: 0.25 },
    sonnet: { speed: 91, jitter: 0.25 },
  };
  const TOTAL_TOKENS = 240;
  const EMA_ALPHA = 0.08;
  const MIN_GAP_MS = 1;          // 同一毫秒内两次 RAF 也不能除以 0
  const A11Y_THROTTLE_MS = 1000; // aria-live 每秒最多播一次，不是每个 token
  /* 读数死区：底层值离当前显示值不到 1 tok/s 就不改数字。
     纯显示层滞回，不参与计算。 */
  /* 死区按比例走，不用绝对值。绝对 3.0 在 42 tok/s 上占 7%、在 91 上只占 3.3%，
     结果快的那条 lane 仍然会闪（实测 Opus 0 次、Sonnet 10 次）。
     取 7% 并给一个 2.0 的地板，两条 lane 的稳定度才一致。 */
  const DEADBAND_RATIO = 0.07;
  const DEADBAND_FLOOR = 2.0;
  const deadbandFor = (r) => Math.max(DEADBAND_FLOOR, r * DEADBAND_RATIO);

  const SAMPLE = ('把这段函数改成流式返回。先判断 Accept 头里有没有 ' +
    'text/event-stream，有就走 SSE 分支，逐块 flush；没有就保持原来的 ' +
    '一次性 JSON 响应，两条路共用同一个序列化器。').split('');

  let raf = null;
  let observer = null;
  let bound = false;
  let running = false;

  const reduced = () =>
    window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* ---- 单条 lane 的状态机 ------------------------------------------------ */
  const makeLane = (root, key) => {
    const cfg = LANES[key];
    const el = {
      lane: root.querySelector(`#race-lane-${key}`),
      fill: null, peak: null, out: null, rate: null, time: null, a11y: null,
    };
    if (!el.lane) return null;
    el.fill = el.lane.querySelector('.race-fill');
    el.peak = el.lane.querySelector('.race-peak');
    el.out  = el.lane.querySelector('.race-out');
    el.rate = el.lane.querySelector('.race-r');
    el.time = el.lane.querySelector('.race-t');
    el.a11y = el.lane.querySelector('.race-a11y');
    el.lane.querySelectorAll('.race-total').forEach(n => {
      n.textContent = `${TOTAL_TOKENS} tok`;
    });

    return {
      key, el, cfg,
      i: 0, ema: null, lastAt: 0, peakRate: 0, done: false, shown: null,
      finishedAt: 0, lastA11y: 0,

      reset() {
        this.i = 0; this.ema = null; this.lastAt = 0; this.peakRate = 0; this.shown = null;
        this.done = false; this.finishedAt = 0; this.lastA11y = 0;
        el.fill.style.width = '0%';
        el.peak.style.left = '0%';
        el.peak.classList.remove('on');
        el.out.textContent = '';
        el.rate.textContent = '0';
        el.time.textContent = '0.0';
        el.a11y.textContent = '';
        el.lane.classList.remove('first');
        const nm = el.lane.querySelector('.race-name');
        if (nm) nm.removeAttribute('data-first-label');
      },

      /* 下一个 token 什么时候到。抖动是乘性的，所以慢 lane 的绝对抖动也更大，
         这符合真实观测（慢模型的间隔方差更大）。 */
      nextGap() {
        const base = 1000 / this.cfg.speed;
        const j = 1 + (Math.random() * 2 - 1) * this.cfg.jitter;
        return Math.max(MIN_GAP_MS, base * j);
      },

      /* 一个 token 落地：更新 EMA 与读数 */
      arrive(now) {
        this.i += 1;

        if (this.lastAt > 0) {
          const gap = Math.max(MIN_GAP_MS, now - this.lastAt);
          /* 第一个样本直接**赋值**而不是从 0 混合。
             从 0 起混会让首帧速率冲到荒谬的高位（1000/极小值），
             之后要 ~20 个 token 才压回来 —— 开场就是一次假峰值。 */
          this.ema = this.ema === null ? gap : this.ema + EMA_ALPHA * (gap - this.ema);
        }
        this.lastAt = now;

        const rate = this.ema ? 1000 / this.ema : 0;

        /* 显示死区。EMA 已经把间隔平滑过了，但读数取整之后仍然会闪：
           速率在 42 附近浮动时，底层 ±0.5 的抖动会不断跨越整数边界，
           数字就来回跳 41/42/43。实测（同源对照，240 token）：
             EMA 取倒数   sd=1.92  帧间最大跳 2.88
           所以只有当底层值离"当前显示值"超过按比例算的死区时才改数字。
           这是**只作用于显示**的滞回，不参与任何计算 —— peak、进度、
           a11y 播报都还用未经死区的 rate。 */
        if (this.shown === null || Math.abs(rate - this.shown) >= deadbandFor(rate)) {
          this.shown = Math.round(rate);
        }

        if (rate > this.peakRate) {
          this.peakRate = rate;
          const pct = Math.min(100, (this.i / TOTAL_TOKENS) * 100);
          this.el.peak.style.left = `${pct}%`;
          this.el.peak.classList.add('on');
        }

        this.el.fill.style.width = `${Math.min(100, (this.i / TOTAL_TOKENS) * 100)}%`;
        this.el.rate.textContent = String(this.shown ?? 0);

        const chars = Math.min(SAMPLE.length, Math.ceil(this.i * (SAMPLE.length / TOTAL_TOKENS)));
        const txt = SAMPLE.slice(0, chars).join('');
        this.el.out.innerHTML = '';
        this.el.out.append(document.createTextNode(txt));
        if (chars < SAMPLE.length) {
          const cur = document.createElement('span');
          cur.className = 'cur';
          cur.textContent = '▍';
          this.el.out.append(cur);
        }

        if (this.i >= TOTAL_TOKENS) this.done = true;
      },

      tick(now, startedAt) {
        if (!this.done) this.el.time.textContent = ((now - startedAt) / 1000).toFixed(1);
        /* aria-live 节流：每个 token 都播会把屏读刷成噪音 */
        if (now - this.lastA11y >= A11Y_THROTTLE_MS || this.done) {
          this.lastA11y = now;
          const rate = this.ema ? Math.round(1000 / this.ema) : 0;
          this.el.a11y.textContent = this.done
            ? `${this.key} 完成，${TOTAL_TOKENS} 个 token，平均 ${rate} tok/s`
            : `${this.key} ${this.i} / ${TOTAL_TOKENS} token，${rate} tok/s`;
        }
      },

      /* 终局状态：降低动效时直接跳到这里，不排任何 RAF */
      settle() {
        this.i = TOTAL_TOKENS;
        this.done = true;
        const rate = this.cfg.speed;
        this.ema = 1000 / rate;
        this.peakRate = rate;
        this.shown = rate;
        this.el.fill.style.width = '100%';
        this.el.peak.style.left = '100%';
        this.el.peak.classList.add('on');
        this.el.rate.textContent = String(rate);
        this.el.time.textContent = (TOTAL_TOKENS / rate).toFixed(1);
        this.el.out.textContent = SAMPLE.join('');
        this.el.a11y.textContent =
          `${this.key} 完成，${TOTAL_TOKENS} 个 token，平均 ${rate} tok/s`;
      },
    };
  };

  const FIRST_LABEL = '先到';

  const run = (lanes, btn) => {
    if (running) return;
    running = true;
    if (btn) btn.disabled = true;
    lanes.forEach(l => l.reset());

    const startedAt = performance.now();
    const due = new Map(lanes.map(l => [l.key, startedAt + l.nextGap()]));
    let firstMarked = false;

    const frame = (now) => {
      lanes.forEach(l => {
        if (l.done) return;
        while (!l.done && now >= due.get(l.key)) {
          l.arrive(due.get(l.key));
          due.set(l.key, due.get(l.key) + l.nextGap());
        }
        l.tick(now, startedAt);
        if (l.done && !l.finishedAt) {
          l.finishedAt = now;
          if (!firstMarked) {
            firstMarked = true;
            /* 只标"先到"，不标"更好" —— 这一屏的结论是取舍不是排名 */
            /* 属性必须设在 ::after 所在的元素（.race-name）上 ——
               attr() 只读自己那个元素的属性，设在祖先上取到的是空串，
               页面上就会显示成 "Sonnet ·" 后面什么都没有。实测踩到过。 */
            const nameEl = l.el.lane.querySelector('.race-name');
            if (nameEl) nameEl.setAttribute('data-first-label', FIRST_LABEL);
            l.el.lane.classList.add('first');
          }
        }
      });

      if (lanes.every(l => l.done)) {
        running = false;
        if (btn) btn.disabled = false;
        raf = null;
        return;
      }
      raf = window.requestAnimationFrame(frame);
    };

    raf = window.requestAnimationFrame(frame);
  };

  const stop = () => {
    if (raf !== null) { window.cancelAnimationFrame(raf); raf = null; }
    running = false;
  };

  window.initToy_race = (root) => {
    const host = root || document.getElementById('race');
    if (!host) return;

    const lanes = ['opus', 'sonnet'].map(k => makeLane(host, k)).filter(Boolean);
    if (!lanes.length) return;
    const btn = host.querySelector('#race-run');

    /* 幂等：重复 init 不重复绑事件、不起第二个循环 */
    stop();
    if (observer) { observer.disconnect(); observer = null; }

    if (reduced()) {
      lanes.forEach(l => l.settle());
      const n0 = lanes[0].el.lane.querySelector('.race-name');
      if (n0) n0.setAttribute('data-first-label', FIRST_LABEL);
      lanes[0].el.lane.classList.add('first');
      if (btn && !bound) {
        btn.addEventListener('click', () => lanes.forEach(l => l.settle()));
        bound = true;
      }
      return;
    }

    if (btn && !bound) {
      btn.addEventListener('click', () => { stop(); run(lanes, btn); });
      bound = true;
    }

    /* 首访者不该看到一个空框，所以进视口自动跑一次；
       滚出视口就停，不留后台循环。 */
    let ranOnce = false;
    observer = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) {
          if (!ranOnce) { ranOnce = true; run(lanes, btn); }
        } else {
          stop();
          if (btn) btn.disabled = false;
        }
      });
    }, { threshold: 0.25 });
    observer.observe(host);
  };

  const boot = () => {
    const host = document.getElementById('race');
    if (host) window.initToy_race(host);
  };
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, { once: true });
  } else {
    boot();
  }
})();

</script>
<script>
/* ============================================================================
   组件6：提示词缓存 —— 「1M 上下文为什么不贵」
   ----------------------------------------------------------------------------
   倍率是从 /api/v1/model-plaza 实测出来的，两个模型完全一致：
     input           1.00×
     cache write 5m  1.25×
     cache write 1h  2.00×
     cache read      0.10×    ← 省 90%

   算例（写在这里是为了能被人复核，不是装饰）：
     静态前缀 P = 820,000 tok（整仓代码 + 文档，1M 窗口的典型用法）
     每轮追加 提问 U = 1,000 tok、回答 O = 2,000 tok，且每轮都重发完整历史
     第 n 轮请求的 input 量：H(n) = P + n·U + (n-1)·O

     增量缓存（Claude Code 的实际做法）：断点放在当前最后一条消息之后，
     所以断点之前全部被缓存。于是
       n = 1 : write H(1)                        = 821,000 tok
       n ≥ 2 : read H(n-1) + write (H(n)-H(n-1)) = 读 H(n-1) + 写 3,000
     读+写两项加起来正好是 H(n)，不漏不重。

     换算成"等效 input token"（乘上倍率）后 × 单价。ttl=5m、本站价 $0.40/M：
       n=1  on = 821,000×1.25 = 1,026,250 eff → $0.4105   off = $0.3284
            ↑ 首轮用缓存**更贵** $0.0821，这是这一节要讲的反直觉点
       n=2  on += 821,000×0.10 + 3,000×1.25 = 85,850 eff → 累计 $0.4448
            off 累计 $0.6580                  → 第 2 轮回本
       n=16 on $0.9382 vs off $5.3984         → 少付 82.6%
     ttl=1h（写入 2.00×）首轮多付更多，回本推到第 3 轮。

   为什么不发真请求：跑出一次"缓存命中"至少要连发两次，为首页动画烧号池配额
   不值得。数字按官方公布倍率算，请求是模拟的 —— 底部说明里分开写了。

   价格有两套，**必须分清**：官方 $5.00/M 与本站 $5.00×0.08 = $0.40/M。
   曲线和大号读数一律是本站价（标题里写了"本站价 · 美元"），官方价只出现在
   小字与表格的独立一列里。把官方价当本站价显示是这个项目踩过的坑。
   ========================================================================= */
(() => {
  'use strict';

  const P = 820_000, U = 1_000, O = 2_000, MAX = 16;
  /* 单价用"微美元 / M token"的整数存，不用 5.00 / 0.40 这种浮点：
     $4.105 这类正好落在半分上的值，写成 821000/1e6*5 会得 4.105000000000001
     （进为 4.11），写成 821000*5e-6 会得 4.104999999999999（退为 4.10）。
     定价页面的显示值不能取决于先乘还是先除，所以一律"先整数乘、最后除一次"。 */
  const OFFICIAL_UPM = 5_000_000;                 // $5.00/M
  const GROUP = 0.08;                             // 本站分组倍率
  const SITE_UPM = Math.round(OFFICIAL_UPM * GROUP);   // 400_000 → $0.40/M
  const READ = 0.10, WRITE = {'5m': 1.25, '1h': 2.00};
  const AUTO_TO = 8, INTRO_MS = 2400;          // 入场自动跑到第 8 轮
  const SVGNS = 'http://www.w3.org/2000/svg';

  const H = (n) => P + n * U + (n - 1) * O;

  /* 一次算完 MAX 轮。内部单位是"等效 input token"（token × 倍率），
     到显示层才乘单价 —— 这样同一份序列能同时喂本站价和官方价，
     两套数字不可能算歪成不同的形状。 */
  function series(ttl) {
    const W = WRITE[ttl];
    const rows = [];
    let onEff = 0, offEff = 0, be = null;
    for (let n = 1; n <= MAX; n++) {
      const readTok = n === 1 ? 0 : H(n - 1);
      const writeTok = n === 1 ? H(1) : H(n) - H(n - 1);
      const readEff = readTok * READ, writeEff = writeTok * W;
      onEff += readEff + writeEff;
      offEff += H(n);
      if (be === null && onEff < offEff) be = n;
      rows.push({n, ctx: H(n), readTok, writeTok, readEff, writeEff,
                 turnOn: readEff + writeEff, turnOff: H(n), onEff, offEff});
    }
    return {rows, be};
  }
  const SERIES = {'5m': series('5m'), '1h': series('1h')};

  /* eff（等效 token，整数）× upm（微美元/M，整数）先乘，量级最大约 5e13，
     远在 2^53 之内，所以乘积是精确整数；只在最后除一次并四舍五入。 */
  const money = (eff, upm, dp) => {
    const s = Math.pow(10, dp);
    return Math.round(eff * upm / (1e12 / s)) / s;
  };
  const site4 = (eff) => '$' + money(eff, SITE_UPM, 4).toFixed(4);
  const official2 = (eff) => '$' + money(eff, OFFICIAL_UPM, 2).toFixed(2);
  // 画图只要相对形状，用普通浮点足够；单位是本站价美元
  const siteRaw = (eff) => eff * SITE_UPM / 1e12;
  const tok = (v) => v.toLocaleString('en-US');
  /* 动态文案单独放一份：这个组件是独立文件，不能假设页面的 I18N 表里
     一定有这些键。静态文案还是走 data-i，由页面统一替换。 */
  const STR = {
    zh: {
      turn: (n) => `第 ${n} 轮`, be: (n) => `第 ${n} 轮`,
      off: (v) => `官方价 ${v}`, saved: '已省', extra: '多付',
      less: (p) => `少付 ${p}%`, more: (p) => `贵 ${p}%`,
      tipTurn: (n) => `第 ${n} 轮 · 累计`,
      tipOn: '用缓存', tipOff: '不用缓存',
      // 页面的 applyLang 只改 innerHTML，改不到 aria-label，所以这两个由 JS 设
      aMinus: '减少一轮', aPlus: '增加一轮',
      sumPre: (n, v, w) => `第 ${n} 轮：用缓存反而<b>多付</b> <span class="cc-hl">${v}</span> —— 写入按 ${w}× 计，比不缓存的 1.00× 贵。`,
      sumPost: (n, be, p) => `到第 ${n} 轮已少付 <span class="cc-hl">${p}%</span>：第 <b>${be}</b> 轮追平，之后每轮只按 0.10× 读取，越聊越省。`,
      aria: (n, be, p, crossed) => crossed
        ? `累计成本曲线，共 ${n} 轮。两条线在第 ${be} 轮交叉，此后用缓存更便宜；第 ${n} 轮累计少付 ${p}%。`
        : `累计成本曲线，共 ${n} 轮。用缓存这条线还在上方 —— 首轮写入更贵，要到第 ${be} 轮才交叉。`,
      ctx: (v) => `${v} tok / 轮`,
    },
    en: {
      turn: (n) => `turn ${n}`, be: (n) => `turn ${n}`,
      off: (v) => `official ${v}`, saved: 'saved', extra: 'extra',
      less: (p) => `${p}% less`, more: (p) => `${p}% more`,
      tipTurn: (n) => `turn ${n} · cumulative`,
      tipOn: 'with cache', tipOff: 'without',
      aMinus: 'one turn fewer', aPlus: 'one turn more',
      sumPre: (n, v, w) => `Turn ${n}: caching costs <span class="cc-hl">${v}</span> <b>more</b> — the write is billed at ${w}× against 1.00× uncached.`,
      sumPost: (n, be, p) => `By turn ${n} you pay <span class="cc-hl">${p}%</span> less: the lines cross at turn <b>${be}</b>, and every turn after that reads the prefix at 0.10×.`,
      aria: (n, be, p, crossed) => crossed
        ? `Cumulative cost chart, ${n} turns. The two lines cross at turn ${be}; by turn ${n} caching costs ${p}% less.`
        : `Cumulative cost chart, ${n} turns. The cached line is still higher — the first write costs more and the lines only cross at turn ${be}.`,
      ctx: (v) => `${v} tok / turn`,
    },
  };
  const getLang = () => {
    // 跟页面同一个来源。localStorage 不可用（隐私模式）时退回 zh。
    try { return localStorage.getItem('lang') === 'en' ? 'en' : 'zh'; }
    catch { return 'zh'; }
  };

  /* 已初始化实例的拆卸函数。重复 init 时先拆干净再装 ——
     否则语言切换调一次、IntersectionObserver 再调一次，就会有两个 rAF
     同时在推同一个 DOM。 */
  const MOUNTED = new WeakMap();

  function svgEl(name, attrs) {
    const el = document.createElementNS(SVGNS, name);
    for (const k in attrs) el.setAttribute(k, attrs[k]);
    return el;
  }

  /* y 轴刻度取整到 1/2/5×10^k，避免出现 $0.7317 这种刻度值 */
  function niceStep(raw) {
    const p = Math.pow(10, Math.floor(Math.log10(raw)));
    const f = raw / p;
    return (f <= 1 ? 1 : f <= 2 ? 2 : f <= 5 ? 5 : 10) * p;
  }
  function mount(root) {
    // 幂等：重复 init（语言切换 + 观察器各调一次）先把上一次拆干净
    MOUNTED.get(root)?.();

    const q = (id) => root.querySelector('#' + id);
    const plot = q('cc-plot'), tip = q('cc-tip'), range = q('cc-range');
    if (!plot || !range) return;

    const S = STR[getLang()];
    const REDUCED = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const ac = new AbortController();
    const on = (el, ev, fn, opt) =>
      el.addEventListener(ev, fn, {...opt, signal: ac.signal});

    let ttl = '5m';
    let turn = 1;                 // 面板显示的轮次（整数）
    let prog = 1;                 // 曲线画到哪（可为小数，入场动画用）
    /* 坐标域单独一个变量：入场动画里 turn 每帧都在涨，若坐标域跟着 turn 走，
       图会一边长一边缩放，什么都看不清。所以入场期间把域钉在终点轮次上。 */
    let domainN = 1;
    let raf = 0, introT0 = 0, introRun = false;
    let chromeKey = '';           // 坐标域指纹，变了才重建网格/刻度
    let geo = null;               // 当前坐标换算
    let hoverN = 0;

    const svg = svgEl('svg', {'aria-hidden': 'true', focusable: 'false'});
    const gChrome = svgEl('g', {}), gData = svgEl('g', {}), gHover = svgEl('g', {});
    svg.append(gChrome, gData, gHover);
    plot.insertBefore(svg, tip);

    /* ---- 坐标 -------------------------------------------------------------
       x 轴留 4 轮的最小跨度：只画 1 轮时若把 x 域压到 0..1，
       线只有两个点、看不出"曲线"是什么形状。 */
    function layout() {
      const w = Math.max(180, Math.round(plot.clientWidth));
      const h = Math.max(140, Math.round(plot.clientHeight));
      const padL = w < 420 ? 40 : 46, padR = 12, padT = 15, padB = 21;
      const xMax = Math.max(4, domainN);
      const r = SERIES[ttl].rows[domainN - 1];
      // y 域取两条线里更高的那条：第 1 轮 on > off，只看 off 会把线画出框
      const yTop = Math.max(r.onEff, r.offEff) * 1.08;
      // 除 6 而不是 4：除 4 时 $2.87 的量程只落 3 条网格线，读不出中间位置
      const step = niceStep(siteRaw(yTop) / 6);
      const ticks = [];
      for (let v = 0; v <= siteRaw(yTop) + 1e-9; v += step) ticks.push(v);
      return {w, h, padL, padR, padT, padB, xMax, yTop, ticks,
        X: (n) => padL + (w - padL - padR) * (n / xMax),
        Y: (eff) => h - padB - (h - padT - padB) * (eff / yTop)};
    }
    // 画到 p 轮为止的点列。p 可以是小数：入场时最后一段插值，线才是"长出来"的
    function pointsUpTo(p) {
      const rows = SERIES[ttl].rows;
      const out = [{x: 0, on: 0, off: 0}];
      const full = Math.min(Math.floor(p), MAX);
      for (let i = 1; i <= full; i++) {
        out.push({x: i, on: rows[i - 1].onEff, off: rows[i - 1].offEff});
      }
      const f = p - full;
      if (f > 1e-6 && full < MAX) {
        const a = out[out.length - 1], r = rows[full];
        out.push({x: full + f, on: a.on + (r.onEff - a.on) * f,
                  off: a.off + (r.offEff - a.off) * f});
      }
      return out;
    }

    /* 真正的交叉点在两个整数轮之间（5m 是 x≈1.28）。竖线画在真交点上，
       文字说"第 2 轮"—— 计费是按轮离散的，第 2 轮才是第一个更便宜的轮次。
       画在整数 2 上会看起来像"到第 2 轮才刚要交叉"，是另一个意思。 */
    function crossing() {
      const {rows, be} = SERIES[ttl];
      if (!be) return null;
      const prev = be === 1 ? {onEff: 0, offEff: 0} : rows[be - 2];
      const cur = rows[be - 1];
      const d0 = prev.onEff - prev.offEff, d1 = cur.onEff - cur.offEff;
      const t = d0 / (d0 - d1);
      return {be, x: (be - 1) + t, eff: prev.onEff + (cur.onEff - prev.onEff) * t};
    }

    function buildChrome(g) {
      const key = [g.w, g.h, g.xMax, g.yTop].join('|');
      if (key === chromeKey) return;
      chromeKey = key;
      gChrome.textContent = '';
      svg.setAttribute('viewBox', `0 0 ${g.w} ${g.h}`);

      for (const v of g.ticks) {
        const y = g.Y(v * 1e12 / SITE_UPM);
        gChrome.append(svgEl('line', {class: 'cc-gridline',
          x1: g.padL, x2: g.w - g.padR, y1: y, y2: y}));
        const tx = svgEl('text', {class: 'cc-tick', x: g.padL - 6, y: y + 3.2,
          'text-anchor': 'end'});
        // 小数位统一：混着 $0.00 / $2.0 会看起来像两种精度
        tx.textContent = '$' + v.toFixed(2);
        gChrome.append(tx);
      }
      gChrome.append(svgEl('line', {class: 'cc-ax', x1: g.padL, x2: g.w - g.padR,
        y1: g.h - g.padB, y2: g.h - g.padB}));

      const step = g.xMax <= 6 ? 1 : Math.ceil(g.xMax / 5);
      const marks = new Set([g.xMax]);
      for (let i = 1; i <= g.xMax; i += step) marks.add(i);
      for (const i of [...marks].sort((a, b) => a - b)) {
        const tx = svgEl('text', {class: 'cc-tick cc-tick-t', x: g.X(i),
          y: g.h - g.padB + 13, 'text-anchor': 'middle'});
        tx.textContent = String(i);
        gChrome.append(tx);
      }
    }
    function drawData(g, p) {
      gData.textContent = '';
      const pts = pointsUpTo(p);
      const path = (key) => pts.map(d => `${g.X(d.x)},${g.Y(d[key])}`).join(' ');

      // 用缓存那条线下方填一层极淡的面：一眼看出"下面这块是省下来的"
      const area = pts.map(d => `${g.X(d.x)},${g.Y(d.on)}`).join(' ')
        + ` ${g.X(pts[pts.length - 1].x)},${g.Y(0)} ${g.X(0)},${g.Y(0)}`;
      gData.append(svgEl('polygon', {class: 'cc-area cc-area-on', points: area}));
      gData.append(svgEl('polyline', {class: 'cc-line-off', points: path('off')}));
      gData.append(svgEl('polyline', {class: 'cc-line-on', points: path('on')}));

      // 标记点：形状区分两条线（圆 vs 方），不只靠颜色
      /* 标记点直接按轮次索引取值，不去 pts 里按浮点相等找 ——
         入场缓动最后一帧会落在 7.9999999，用 find(o => o.x === 8) 会漏掉
         最后一个点（实测过，第 8 轮只画出 7 个点）。 */
      const rows = SERIES[ttl].rows;
      const full = Math.min(Math.floor(p + 1e-6), MAX);
      const st = full <= 8 ? 1 : 2;
      for (let i = 1; i <= full; i++) {
        if (i !== full && (full - i) % st !== 0) continue;
        const r = rows[i - 1];
        gData.append(svgEl('rect', {class: 'cc-dot-off', x: g.X(i) - 2.6,
          y: g.Y(r.offEff) - 2.6, width: 5.2, height: 5.2}));
        gData.append(svgEl('circle', {class: 'cc-dot-on', cx: g.X(i),
          cy: g.Y(r.onEff), r: 2.9}));
      }

      // 回本标记：只在曲线已经画过交点之后才出现
      const c = crossing();
      if (c && p >= c.x) {
        const x = g.X(c.x);
        gData.append(svgEl('circle', {class: 'cc-be-dot', cx: x, cy: g.Y(c.eff), r: 5}));
        /* 交点落在 x≈1.3。x 域一放到 8 轮以上，这一段就被压到原点附近十几像素，
           "两条线怎么交的"根本看不见 —— 而那正是这一节存在的理由。
           所以域一宽就放一个放大镜：只画前几轮，自带 y 域。
           域窄时不放（主图已经够清楚），免得同一件事说两遍。 */
        if (g.xMax > 5) {
          drawInset(g, c, p);
        } else {
          gData.append(svgEl('line', {class: 'cc-be-line', x1: x, x2: x,
            y1: g.padT, y2: g.h - g.padB}));
          const tx = svgEl('text', {class: 'cc-be-txt', x: x + 6, y: g.padT + 8});
          tx.textContent = `${S.be(c.be)} ${getLang() === 'en' ? 'break-even' : '回本'}`;
          gData.append(tx);
        }
      }
    }

    // 放大镜：前 IN_N 轮，独立 y 域，画在绘图区右上角的空白处
    function drawInset(g, c, p) {
      const IN_N = 3;
      const rows = SERIES[ttl].rows;
      const iw = Math.max(96, Math.round((g.w - g.padL - g.padR) * 0.30));
      const ih = Math.max(58, Math.round((g.h - g.padT - g.padB) * 0.34));
      /* 放左上角：不缓存那条线是从左下往右上走的，右上角其实是它的必经之路
         （放那儿会被黄线直接穿过去，实测糊成一团）。左上角在黄线之上，是真空白。 */
      const ix = g.padL + 8, iy = g.padT + 13;
      const top = Math.max(rows[IN_N - 1].onEff, rows[IN_N - 1].offEff) * 1.1;
      /* 盒内留边：最后一个刻度正好在盒边上会被裁掉半个字（实测 "3" 只剩一半），
         底部还要留一行放刻度数字。 */
      const PX = 9, PT = 6, PB = 13;
      const IX = (n) => ix + PX + (iw - PX * 2) * (n / IN_N);
      const IY = (e) => iy + ih - PB - (ih - PT - PB) * (e / top);

      const gi = svgEl('g', {class: 'cc-inset'});
      gi.append(svgEl('rect', {class: 'cc-inset-bg', x: ix, y: iy, width: iw, height: ih, rx: 6}));
      const pts = (key) => {
        const out = [`${IX(0)},${IY(0)}`];
        for (let i = 1; i <= IN_N; i++) {
          if (i > p) break;
          out.push(`${IX(i)},${IY(rows[i - 1][key])}`);
        }
        return out.join(' ');
      };
      gi.append(svgEl('polyline', {class: 'cc-line-off cc-inset-l', points: pts('offEff')}));
      gi.append(svgEl('polyline', {class: 'cc-line-on cc-inset-l', points: pts('onEff')}));
      for (let i = 1; i <= Math.min(IN_N, Math.floor(p + 1e-6)); i++) {
        gi.append(svgEl('rect', {class: 'cc-dot-off', x: IX(i) - 2.2,
          y: IY(rows[i - 1].offEff) - 2.2, width: 4.4, height: 4.4}));
        gi.append(svgEl('circle', {class: 'cc-dot-on', cx: IX(i),
          cy: IY(rows[i - 1].onEff), r: 2.5}));
      }
      if (c.x <= IN_N) {
        gi.append(svgEl('line', {class: 'cc-be-line', x1: IX(c.x), x2: IX(c.x),
          y1: iy + 4, y2: iy + ih - PB + 2}));
        gi.append(svgEl('circle', {class: 'cc-be-dot', cx: IX(c.x), cy: IY(c.eff), r: 4.2}));
      }
      // 轮次刻度：放大镜里也要知道横轴是第几轮
      for (let i = 1; i <= IN_N; i++) {
        const t = svgEl('text', {class: 'cc-inset-tick', x: IX(i), y: iy + ih - 4,
          'text-anchor': 'middle'});
        t.textContent = String(i);
        gi.append(t);
      }
      const lab = svgEl('text', {class: 'cc-be-txt', x: ix, y: iy - 4});
      lab.textContent = getLang() === 'en'
        ? `first ${IN_N} turns · break-even ${c.be}`
        : `前 ${IN_N} 轮放大 · 第 ${c.be} 轮回本`;
      gi.append(lab);
      gData.append(gi);
    }

    function drawHover(g) {
      gHover.textContent = '';
      if (!hoverN || hoverN > Math.floor(prog)) { tip.hidden = true; return; }
      const r = SERIES[ttl].rows[hoverN - 1], x = g.X(hoverN);
      gHover.append(svgEl('line', {class: 'cc-cross', x1: x, x2: x,
        y1: g.padT, y2: g.h - g.padB}));
      gHover.append(svgEl('rect', {class: 'cc-dot-off', x: x - 4, y: g.Y(r.offEff) - 4,
        width: 8, height: 8}));
      gHover.append(svgEl('circle', {class: 'cc-dot-on', cx: x, cy: g.Y(r.onEff), r: 4.4}));

      tip.innerHTML = `${S.tipTurn(hoverN)}<br>`
        + `<b>${site4(r.onEff)}</b> ${S.tipOn}<br>`
        + `<b class="cc-tip-off">${site4(r.offEff)}</b> ${S.tipOff}`;
      tip.hidden = false;
      const top = Math.min(g.Y(r.onEff), g.Y(r.offEff)) - 8;
      tip.style.left = Math.max(tip.offsetWidth / 2 + 2,
        Math.min(g.w - tip.offsetWidth / 2 - 2, x)) + 'px';
      tip.style.top = Math.max(tip.offsetHeight + 2, top) + 'px';
    }
    function paintPanel() {
      const {rows, be} = SERIES[ttl], r = rows[turn - 1];
      const w = WRITE[ttl].toFixed(2);
      q('cc-turn').textContent = S.turn(turn);
      q('cc-on').textContent = site4(r.onEff);
      q('cc-off').textContent = site4(r.offEff);
      // 官方价只出现在小字里，且明写"官方价"。大号数字一律是本站价。
      q('cc-on-off').textContent = S.off(official2(r.onEff));
      q('cc-off-off').textContent = S.off(official2(r.offEff));

      const top = Math.max(r.onEff, r.offEff);
      q('cc-bar-on').style.width = (r.onEff / top * 100).toFixed(2) + '%';
      q('cc-bar-off').style.width = (r.offEff / top * 100).toFixed(2) + '%';

      const diff = r.offEff - r.onEff, neg = diff < 0;
      const save = q('cc-save');
      save.classList.toggle('cc-neg', neg);
      q('cc-save-lbl').textContent = neg ? S.extra : S.saved;
      q('cc-save-v').textContent = site4(Math.abs(diff));
      q('cc-save-pct').textContent = neg
        ? S.more((-diff / r.offEff * 100).toFixed(1))
        : S.less((diff / r.offEff * 100).toFixed(1));

      // 单轮构成：轨道满格 = 两者里更贵的那个。第 1 轮 on 更长，正好把
      // "首次写入更贵"画成一根比对照更长的条。
      const cs = Math.max(r.turnOn, r.turnOff);
      const readW = r.readEff / cs * 100, writeW = r.writeEff / cs * 100;
      q('cc-seg-read').style.width = readW.toFixed(2) + '%';
      q('cc-seg-write').style.width = writeW.toFixed(2) + '%';
      q('cc-seg-write').style.borderRadius = readW < 0.5 ? '99px' : '';
      const ghostPct = r.turnOff / cs * 100;
      q('cc-ghost').style.width = ghostPct.toFixed(2) + '%';
      // 终点刻线：贴着影子右端，满格时正好落在轨道右缘
      q('cc-ghost-end').style.left = `calc(${ghostPct.toFixed(2)}% - 2px)`;
      q('cc-ctx').textContent = S.ctx(tok(r.ctx));
      q('cc-v-read').textContent = site4(r.readEff);
      q('cc-v-write').textContent = site4(r.writeEff);
      q('cc-v-off').textContent = site4(r.turnOff);

      const pct = (diff / r.offEff * 100).toFixed(1);
      q('cc-sum').innerHTML = neg
        ? S.sumPre(turn, site4(-diff), w)
        : S.sumPost(turn, be, pct);
      plot.setAttribute('aria-label', S.aria(turn, be, pct, !neg));
      q('cc-be-n').textContent = S.be(be);
      q('cc-out').textContent = `${turn} / ${MAX}`;
      range.setAttribute('aria-valuetext',
        `${S.turn(turn)} · ${neg ? S.extra : S.saved} ${site4(Math.abs(diff))}`);
      q('cc-row-5m').classList.toggle('cc-on', ttl === '5m');
      q('cc-row-1h').classList.toggle('cc-on', ttl === '1h');
      q('cc-minus').disabled = turn <= 1;
      q('cc-plus').disabled = turn >= MAX;
    }

    function render() {
      geo = layout();
      buildChrome(geo);
      drawData(geo, prog);
      drawHover(geo);
      paintPanel();
    }
    // 用户一动手就停掉入场动画：动画和拖动抢同一个状态会打架
    function stopIntro() {
      introRun = false;
      if (raf) { cancelAnimationFrame(raf); raf = 0; }
    }

    function setTurn(n, {fromIntro = false} = {}) {
      if (!fromIntro) stopIntro();
      turn = Math.min(MAX, Math.max(1, n));
      domainN = turn;
      prog = turn;
      range.value = String(turn);
      render();
    }

    function frame(t) {
      if (!introRun) return;
      if (!introT0) introT0 = t;
      const k = Math.min(1, (t - introT0) / INTRO_MS);
      // easeOutCubic：起步快、收尾慢，最后几轮的差距拉开看得清
      const e = 1 - Math.pow(1 - k, 3);
      // k=1 时直接钉到终点，不留 7.9999999 这种尾数
      prog = k >= 1 ? AUTO_TO : 1 + (AUTO_TO - 1) * e;
      turn = Math.max(1, Math.round(prog));
      range.value = String(turn);
      drawData(geo, prog);
      drawHover(geo);
      paintPanel();
      if (k < 1) { raf = requestAnimationFrame(frame); }
      else { introRun = false; raf = 0; setTurn(AUTO_TO, {fromIntro: true}); }
    }

    function startIntro() {
      if (REDUCED) { setTurn(AUTO_TO); return; }   // 直接给完成态，不动
      domainN = AUTO_TO;                            // 域钉在终点，图不缩放
      prog = 1; turn = 1; introT0 = 0; introRun = true;
      geo = layout(); buildChrome(geo);
      raf = requestAnimationFrame(frame);
    }

    /* ---- 控件 ------------------------------------------------------------ */
    on(range, 'input', () => setTurn(Number(range.value)));
    on(q('cc-minus'), 'click', () => setTurn(turn - 1));
    on(q('cc-plus'), 'click', () => setTurn(turn + 1));
    q('cc-minus').setAttribute('aria-label', S.aMinus);
    q('cc-plus').setAttribute('aria-label', S.aPlus);

    const opts = [q('cc-ttl-5m'), q('cc-ttl-1h')];
    function pickTtl(i) {
      ttl = opts[i].dataset.ttl;
      opts.forEach((b, j) => {
        b.setAttribute('aria-checked', String(i === j));
        b.tabIndex = i === j ? 0 : -1;
      });
      chromeKey = '';           // 换 TTL → y 域变了，网格要重画
      stopIntro();
      render();
    }
    opts.forEach((b, i) => {
      on(b, 'click', () => { pickTtl(i); b.focus(); });
      // radiogroup 的键盘约定：左右/上下在选项间移动并直接选中
      on(b, 'keydown', (e) => {
        const d = {ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1}[e.key];
        if (!d) return;
        e.preventDefault();
        const j = (i + d + opts.length) % opts.length;
        pickTtl(j); opts[j].focus();
      });
    });
    /* pointermove 而不是 mousemove：触屏上 mousemove 不触发，
       用 pointer 事件一套代码同时管鼠标和手指。 */
    on(plot, 'pointermove', (e) => {
      if (!geo) return;
      const b = plot.getBoundingClientRect();
      const x = (e.clientX - b.left) / (b.width || 1) * geo.w;
      const n = Math.round((x - geo.padL) / (geo.w - geo.padL - geo.padR) * geo.xMax);
      const c = Math.min(Math.floor(prog), Math.max(1, n));
      if (c !== hoverN) { hoverN = c; drawHover(geo); }
    });
    const clearHover = () => { if (hoverN) { hoverN = 0; drawHover(geo); } };
    on(plot, 'pointerleave', clearHover);
    on(plot, 'pointercancel', clearHover);

    /* 容器宽度变了就重算：SVG viewBox 跟着像素尺寸走（1:1），
       文字不会被拉伸，也不必操心 devicePixelRatio。 */
    const ro = new ResizeObserver(() => { chromeKey = ''; render(); });
    ro.observe(plot);

    /* 滚出视口就把入场动画停掉；滚回来若还没跑过就补跑一次。
       页面滚走了还在 rAF 是白烧电池。 */
    let introDone = REDUCED;
    const vis = new IntersectionObserver((es) => {
      for (const e of es) {
        if (e.isIntersecting) {
          if (!introDone) { introDone = true; startIntro(); }
        } else if (introRun) {
          stopIntro(); setTurn(AUTO_TO, {fromIntro: true});
        }
      }
    }, {threshold: 0.15});
    vis.observe(plot);

    MOUNTED.set(root, () => {
      stopIntro();
      ac.abort(); ro.disconnect(); vis.disconnect();
      svg.remove();
      tip.hidden = true;
      MOUNTED.delete(root);
    });

    pickTtl(0);
    setTurn(1);
    if (introDone) setTurn(AUTO_TO);   // prefers-reduced-motion：直接完成态
  }

  window.initToy_cache = (root) => {
    const el = root || document.getElementById('cachecost');
    if (el) mount(el);
  };

  /* 自启动：DOMContentLoaded 后挂一个观察器，首次进入视口自动跑一次。
     只跑一次 —— unobserve 掉，之后要重跑得显式调 initToy_cache。 */
  function selfStart() {
    const el = document.getElementById('cachecost');
    if (!el) return;
    const io = new IntersectionObserver((es, o) => {
      for (const e of es) {
        if (!e.isIntersecting) continue;
        o.unobserve(e.target);
        o.disconnect();
        mount(e.target);
      }
    }, {threshold: 0.1});
    io.observe(el);
  }
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', selfStart, {once: true});
  } else {
    selfStart();
  }
})();

</script>
<script>
'use strict';
/* ==========================================================================
   启动
   --------------------------------------------------------------------------
   顺序很重要：
     1. 上面各段已经把 shell 自己的控件装好，中文快照也取过一次；
     2. toy 资产的占位注释在本段之前 —— 三个 toy 的 <script> 在这一步已经
        执行完 SKI.addI18n('en', …)，所以它们的英文文案已经在字典里；
        （这里刻意不写出那个占位标记的字面量：集成时若用裸 token 做字符串
        替换，注释里的同名文字会被一起换掉。）
     3. 本段再补一次 captureZH（覆盖 toy 里新出现的 [data-i] 中文原文），
        然后 applyLang()，最后调用每个 window.initToy_*。
   applyLang 必须晚于 toy 注册文案，否则英文态下 toy 的文字会留在中文。
   ========================================================================= */
(() => {
  const started = new Set();

  function initToys() {
    /* 不写死三个名字：凡是 window 上以 initToy_ 开头的函数都调一次。
       每个都单独 try/catch —— 一个 toy 崩了不能把另外两个和整页拖下水。 */
    Object.keys(window)
      .filter(k => k.indexOf('initToy_') === 0 && typeof window[k] === 'function')
      .forEach(k => {
        if (started.has(k)) return;
        started.add(k);
        try { window[k](); }
        catch (err) { console.error('[toy] ' + k + ' failed to init', err); }
      });
  }

  function boot() {
    SKI.captureZH(document);
    if (SKI.lang() === 'en') SKI.applyLang();
    initToys();
    /* prefers-reduced-motion 下 .rv 本来就是可见的（CSS 里 opacity:1），
       但进度条的宽度是靠揭示回调填的。要求减少动效的人不该为了看到数据
       而先滚动一遍，所以这里直接一次填满、不挂观察器。 */
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      SKI.$$('.rv').forEach(el => el.classList.add('in'));
      SKI.paintBars(document);
    } else {
      // toy 可能自己往页面里加了 .rv，一并纳入揭示观察
      SKI.$$('.rv').forEach((el, i) => {
        el.style.transitionDelay = (i % 4) * 55 + 'ms';
        SKI.reveal(el);
      });
    }
    SKI.onScroll();
    /* 兜底：任何不滚动的渲染场景（打印、截图工具、Lighthouse、部分内嵌
       浏览器）都不会触发 IntersectionObserver。3 秒后无条件全部显形，
       宁可少个动画也不能白页。进度条同理，一起填满。 */
    setTimeout(() => {
      SKI.$$('.rv').forEach(el => el.classList.add('in'));
      SKI.paintBars(document);
    }, 3000);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', boot, {once:true});
  } else {
    boot();
  }
})();
</script>
</body>
</html>
