<script>
'use strict';
/* ==========================================================================
   hero 终端里的 SSE 流式演示
   流式是这个产品最核心、最难用文字讲清的能力，所以让它自己演。
   纯本地动画，不发请求 —— 落地页的 CSP connect-src 只放行 /health 那几个源，
   而且真发一次生成请求要消耗号池配额，为了首页动画去烧配额不值得。
   界面上明确标了"演示动画，非真实请求"，不含糊其辞。
   ========================================================================= */
(() => {
  const {$, t, setBtn} = SKI;
  const SSE_TPL = {
    chat: {
      label:'chat', prompt:'"讲讲这个网关"', promptEn:'"explain this gateway"',
      toks:['一个','标准','Anthropic','端点','，','背后','接','全部','模型','。'],
      toksEn:['One',' standard',' Anthropic',' endpoint',',',' every',' model',' behind',' it','.'],
    },
    think: {
      label:'thinking', prompt:'"这题怎么解"', promptEn:'"how do I solve this"',
      pre:['(','先','看','约束','条件',')'], preEn:['(','check',' the',' constraints',')'],
      toks:['答案','是','把','base_url','换掉','。'],
      toksEn:['Answer',':',' swap',' the',' base_url','.'],
    },
    tool: {
      label:'tool_use', prompt:'"查一下余额"', promptEn:'"check my balance"',
      json:['{"','name','":"','get_balance','","','input','":{}}'],
      toks:['余额','充足','，','可以','继续','。'],
      toksEn:['Balance',' is',' fine',',',' go',' ahead','.'],
    },
    code: {
      label:'code', prompt:'"写个 curl"', promptEn:'"write me a curl"',
      toks:['curl',' -X',' POST',' \\\n  ','$BASE','/v1','/messages'],
      toksEn:['curl',' -X',' POST',' \\\n  ','$BASE','/v1','/messages'],
    },
  };

  const body = $('#s-body'), live = $('#s-live'), row = $('#tpl-row');
  const btn = $('#s-run');
  const tokEl = $('#s-tok'), rateEl = $('#s-rate'), promptEl = $('#term-prompt');
  const labelEl = $('#term-label');
  let timer = null, n = 0, t0 = 0, cur = 'chat';

  function renderTabs() {
    row.innerHTML = '';
    Object.entries(SSE_TPL).forEach(([k, v]) => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'tpl';
      b.setAttribute('aria-pressed', String(k === cur));
      b.textContent = v.label;
      b.addEventListener('click', () => { cur = k; renderTabs(); reset(); run(); });
      row.appendChild(b);
    });
  }

  function reset() {
    clearTimeout(timer); timer = null;
    body.innerHTML = ''; n = 0;
    tokEl.textContent = '0'; rateEl.textContent = '0';
    live.classList.remove('on');
    const tpl = SSE_TPL[cur];
    promptEl.textContent = SKI.lang() === 'en' ? tpl.promptEn : tpl.prompt;
    labelEl.textContent = 'text/event-stream · ' + tpl.label;
    setBtn(btn, 'play', t('s.run'));
  }

  function run() {
    if (timer) { reset(); return; }
    const tpl = SSE_TPL[cur];
    body.innerHTML = ''; n = 0; t0 = performance.now();
    live.classList.add('on');
    setBtn(btn, 'stop', SKI.lang() === 'en' ? 'Stop' : '停止');
    // 每个模板拼出自己的序列：[文本, 种类] —— 种类决定 pill 的配色
    const en = SKI.lang() === 'en';
    const seq = [];
    (en ? tpl.preEn : tpl.pre)?.forEach(w => seq.push([w, 'think']));
    (en ? tpl.jsonEn || tpl.json : tpl.json)?.forEach(w => seq.push([w, 'json']));
    (en ? tpl.toksEn : tpl.toks).forEach(w => seq.push([w, '']));

    const step = (i) => {
      if (i >= seq.length) {
        clearTimeout(timer); timer = null;
        live.classList.remove('on');
        setBtn(btn, 'play', t('s.run'));
        return;
      }
      const [w, kind] = seq[i];
      const el = document.createElement('span');
      el.className = 'tok' + (kind ? ' ' + kind : '');
      // 空格是 token 的一部分而不是分隔符，用 ␣ 显式画出来
      el.innerHTML = w.replace(/^ /, '<span class="sp">␣</span>').replace(/\n/g, '⏎');
      body.appendChild(el);
      n++;
      tokEl.textContent = String(n);
      const secs = (performance.now() - t0) / 1000;
      rateEl.textContent = secs > 0 ? (n / secs).toFixed(1) : '0';
      // 抖动的间隔比匀速更像真的流：真实 SSE 的 token 间隔本来就不均匀
      timer = setTimeout(() => step(i + 1), 52 + Math.random() * 120);
    };
    step(0);
  }
  btn.addEventListener('click', run);
  renderTabs(); reset();
  SKI.onLangChange(reset);
})();

/* ==========================================================================
   接入点：延迟探测 + 对照条
   --------------------------------------------------------------------------
   /health 不返回 Access-Control-Allow-Origin（四个端点实测都没有），所以
   **必须用 mode:'no-cors'**：那样拿到的是 opaque response，读不到状态码和
   响应体，但 fetch 会正常 resolve，而往返耗时照样测得到 —— 我们要的就是耗时。
   基线用的是默认 cors 模式，于是每次探测都被浏览器拦掉、控制台刷四条
   CORS 错误、四张卡全部显示"无法探测"。改成 no-cors 之后不必等运维给
   /health 补头就能工作，控制台也干净。

   仍然保留失败分支：网络不通、DNS 失败、CSP connect-src 拦截都会走到那里，
   那时显示"无法探测"，不猜、不编数字。
   ========================================================================= */
(() => {
  const {$, $$, t} = SKI;
  const eps = $$('.ep');
  const results = new Map();

  function paint() {
    const ok = [...results.entries()].filter(([, v]) => typeof v === 'number');
    if (!ok.length) return;
    const best = Math.min(...ok.map(([, v]) => v));
    eps.forEach(ep => {
      const v = results.get(ep.dataset.host);
      const latEl = ep.querySelector('.ep-lat');
      const wrap = ep.querySelector('.bar');
      const fill = ep.querySelector('.bar > i');
      if (typeof v !== 'number') return;
      latEl.className = 'ep-lat';
      latEl.textContent = '';
      const num = document.createElement('span');
      num.textContent = String(v);
      const unit = document.createElement('small');
      unit.textContent = 'ms';
      latEl.append(num, unit);
      if (v === best && ok.length > 1) {
        const badge = document.createElement('span');
        badge.className = 'ep-fastest';
        badge.innerHTML = '<svg class="ico ico-sm" aria-hidden="true"><use href="#i-zap"/></svg>';
        badge.append(document.createTextNode(t('ep.fastest')));
        latEl.appendChild(badge);
      }
      // 越快越长：best 铺满，其余按反比。留 12% 底，太短的条读不出来
      const pct = Math.max(12, Math.min(100, (best / v) * 100));
      fill.style.width = pct.toFixed(1) + '%';
      wrap.setAttribute('role', 'progressbar');
      wrap.setAttribute('aria-valuemin', '0');
      wrap.setAttribute('aria-valuemax', '100');
      wrap.setAttribute('aria-valuenow', String(Math.round(pct)));
      wrap.setAttribute('aria-label', ep.dataset.host + ' ' + v + 'ms');
    });
  }

  async function probe(ep) {
    const host = ep.dataset.host;
    const latEl = ep.querySelector('.ep-lat');
    const t0 = performance.now();
    try {
      const ctl = new AbortController();
      const timeout = setTimeout(() => ctl.abort(), 6000);
      await fetch('https://' + host + '/health',
        {mode:'no-cors', cache:'no-store', signal:ctl.signal});
      clearTimeout(timeout);
      results.set(host, Math.round(performance.now() - t0));
    } catch {
      // 网络不通 / DNS 失败 / CSP 拦截都会到这里。不猜、不编数字。
      results.set(host, null);
      latEl.className = 'ep-lat failed';
      latEl.textContent = t('ep.failed');
    }
    paint();
  }
  eps.forEach(probe);

  /* 选中端点 → 同步所有展示 URL */
  function select(ep) {
    eps.forEach(e => e.setAttribute('aria-pressed', String(e === ep)));
    const url = 'https://' + ep.dataset.host;
    $('#ep-url').textContent = url;
    $('#ep-url-plain').textContent = url;
    $('#term-url').textContent = url;
  }
  eps.forEach(ep => ep.addEventListener('click', () => select(ep)));

  $('#ep-copy').addEventListener('click',
    (e) => SKI.copy('export ANTHROPIC_BASE_URL=' + $('#ep-url').textContent, e.currentTarget));
  $('#ep-copy-url').addEventListener('click',
    (e) => SKI.copy($('#ep-url-plain').textContent, e.currentTarget));
  // 语言切回时"无法探测"/"fastest" 要跟着换
  SKI.onLangChange(() => {
    eps.forEach(ep => {
      if (results.get(ep.dataset.host) === null) {
        ep.querySelector('.ep-lat').textContent = t('ep.failed');
      }
    });
    paint();
  });
})();
</script>
<script>
'use strict';
/* ==========================================================================
   模型切换器 + 上下文窗口条
   把"换模型只改 model 字段"从一句话变成一个能点的动作。
   ========================================================================= */
(() => {
  const {$, t, MODELS, CTX_1M} = SKI;
  let curModel = MODELS[0];
  let use1m = false;

  const modelString = () => curModel.id + (use1m ? CTX_1M : '');

  function renderModels() {
    const box = $('#mdl-switch');
    if (!box) return;
    box.innerHTML = '';
    MODELS.forEach(m => {
      const b = document.createElement('button');
      b.type = 'button';
      b.className = 'chip' + (m.claude ? ' chip-claude' : '');
      b.setAttribute('aria-pressed', String(m.id === curModel.id));
      b.textContent = m.id;
      if (m.tag) {
        const tag = document.createElement('span');
        tag.className = 'chip-tag';
        tag.textContent = SKI.lang() === 'en' ? 'latest' : m.tag;
        b.appendChild(tag);
      }
      b.addEventListener('click', () => { curModel = m; renderModels(); paintModel(true); });
      box.appendChild(b);
    });
  }

  function paintModel(flash) {
    const cmd = $('#mdl-cmd'), tm = $('#term-model'), meta = $('#term-meta');
    if (!cmd) return;
    cmd.textContent = curModel.id;
    const sfx = $('#mdl-sfx');
    if (sfx) sfx.textContent = use1m ? CTX_1M : '';
    if (tm) tm.textContent = modelString();
    const ctx = use1m ? '1M' : curModel.ctx;
    if (meta) meta.textContent = ctx + (SKI.lang() === 'en' ? ' context' : ' 上下文');
    $('#mdl-ctx').textContent = ctx;
    $('#mdl-think').textContent = curModel.think ? t('mdl.yes') : t('mdl.no');
    /* 上下文条的量程是 1M，所以 200K 只占 20% —— 这正是要传达的事：
       1M 不是"稍微大一点"，是五倍。数字和条同时给，条负责量级，数字负责精确。 */
    const pct = use1m ? 100 : 20;
    $('#ctx-num').textContent = ctx;
    $('#ctx-bar').style.width = pct + '%';
    $('#ctx-bar-wrap').setAttribute('aria-valuenow', String(pct));
    if (flash) {
      // 短暂高亮换掉的那个字段，视线才跟得上"只有这里变了"
      [cmd, tm, sfx].forEach(el => {
        if (!el) return;
        el.classList.add('flash');
        setTimeout(() => el.classList.remove('flash'), 420);
      });
      SKI.toast(t('toast.model') + ' ' + modelString());
    }
  }

  /* [1m] 后缀：绑在真实 checkbox 的 change 上，
     所以鼠标点、空格键、程序化 .checked 都会走同一条路 */
  const box = $('#ctx-in');
  box.addEventListener('change', () => { use1m = box.checked; paintModel(true); });
  $('#mdl-copy').addEventListener('click',
    (e) => SKI.copy('/model ' + modelString(), e.currentTarget));

  renderModels();
  paintModel();
  SKI.onLangChange(() => { renderModels(); paintModel(); });
  // 命令面板要能切模型，所以把这两个动作交出去
  SKI.selectModel = (m) => { curModel = m; renderModels(); paintModel(true); };
})();

/* ==========================================================================
   命令面板 ⌘K
   只放真正有用的动作：跳区块、复制端点、切模型、切主题。
   ========================================================================= */
(() => {
  const {$, $$, t} = SKI;
  const mask = $('#pal-mask'), input = $('#pal-in'), list = $('#pal-list');
  let items = [], sel = 0, lastFocus = null;

  const build = () => {
    const out = [
      {ic:'zap', label:t('ep.title'), sub:'endpoints', act:() => { location.hash = '#endpoints'; }},
      {ic:'database', label:t('mdl.title'), sub:'models', act:() => { location.hash = '#models'; }},
      {ic:'layers', label:t('cmp.title'), sub:'why', act:() => { location.hash = '#why'; }},
      {ic:'globe', label:t('mdl.all'), sub:'plaza', act:() => { location.href = '/model-plaza'; }},
      {ic:'copy', label:t('pal.copy') + ' ' + $('#ep-url-plain').textContent, sub:'copy',
       act:() => SKI.copy($('#ep-url-plain').textContent)},
      {ic:'moon', label:t('pal.theme'), sub:'theme', act:() => $('#theme').click()},
    ];
    SKI.MODELS.forEach(m => out.push({
      ic:'database', label:m.id, sub:t('pal.model'),
      act:() => SKI.selectModel?.(m),
    }));
    return out;
  };

  function render(q) {
    const all = build();
    const needle = (q || '').toLowerCase();
    items = needle ? all.filter(i => (i.label + ' ' + i.sub).toLowerCase().includes(needle)) : all;
    sel = 0;
    list.innerHTML = '';
    if (!items.length) {
      const empty = document.createElement('div');
      empty.className = 'pal-empty';
      empty.textContent = t('pal.empty');
      list.appendChild(empty);
      return;
    }
    items.forEach((it, i) => {
      const row = document.createElement('div');
      row.className = 'pal-item';
      row.setAttribute('role', 'option');
      row.setAttribute('aria-selected', String(i === sel));
      const ic = document.createElement('span');
      ic.className = 'pal-ic';
      ic.innerHTML = '<svg class="ico" aria-hidden="true"><use href="#i-' + it.ic + '"/></svg>';
      const lb = document.createElement('span');
      lb.textContent = it.label;
      const sb = document.createElement('span');
      sb.className = 'sub';
      sb.textContent = it.sub;
      row.append(ic, lb, sb);
      row.addEventListener('click', () => { it.act(); close(); });
      list.appendChild(row);
    });
  }
  const rows = () => [...list.querySelectorAll('.pal-item')];
  function move(d) {
    if (!items.length) return;
    sel = (sel + d + items.length) % items.length;
    rows().forEach((r, i) => r.setAttribute('aria-selected', String(i === sel)));
    rows()[sel]?.scrollIntoView({block:'nearest'});
  }
  function open() {
    lastFocus = document.activeElement;
    mask.classList.add('open');
    input.value = '';
    render('');
    input.focus();
  }
  function close() {
    mask.classList.remove('open');
    /* 焦点必须回到打开它的那个按钮，否则键盘用户被丢回文档开头。
       ⌘K 打开时焦点可能在任意位置（甚至 body，body 不可聚焦），
       所以拿不到可聚焦的来源就退回搜索按钮本身。 */
    const back = (lastFocus && document.contains(lastFocus) && lastFocus !== document.body)
      ? lastFocus : $('#pal-open');
    back.focus();
  }

  $('#pal-open').addEventListener('click', open);
  input.addEventListener('input', () => render(input.value));
  mask.addEventListener('click', (e) => { if (e.target === mask) close(); });
  input.addEventListener('keydown', (e) => {
    if (e.key === 'ArrowDown') { move(1); e.preventDefault(); }
    else if (e.key === 'ArrowUp') { move(-1); e.preventDefault(); }
    else if (e.key === 'Enter') { items[sel]?.act(); close(); }
    else if (e.key === 'Escape') close();
  });
  addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); open(); }
    else if (e.key === 'Escape' && mask.classList.contains('open')) close();
  });
})();
</script>
