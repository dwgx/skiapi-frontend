// Maps a model name to a vendor key. Order matters: claude before gpt,
// because the Claude group contains a gpt-4o entry that would otherwise mis-tag.
window.VENDOR_RULES = [
  [/^claude/i, 'Anthropic'],
  [/^gpt|^o[134]-|^chatgpt/i, 'OpenAI'],
  [/^minimax/i, 'MiniMax'],
  [/^deepseek/i, 'DeepSeek'],
  [/^glm/i, 'ZhipuAI'],
  [/^qwen/i, 'Qwen'],
];

window.vendorOf = n => (window.VENDOR_RULES.find(([re]) => re.test(n)) || [null, 'Other'])[1];

// Renders a vendor mark as a standalone SVG string at `size` px, or '' when the vendor
// is unknown or has no path (caller falls back to `fallbackText`).
window.vendorIconSVG = (vendorKey, size = 20) => {
  const icon = window.VENDOR_ICONS[vendorKey];
  if (!icon || !icon.path) return '';
  return (
    '<svg xmlns="http://www.w3.org/2000/svg"' +
    ' width="' + size + '" height="' + size + '"' +
    ' viewBox="' + icon.viewBox + '"' +
    ' fill="currentColor" fill-rule="evenodd"' +
    ' role="img" aria-label="' + icon.label + '">' +
    icon.path +
    '</svg>'
  );
};

</script>
