<script>
// 主题：与后台共用 localStorage 的 'theme' 键，跨落地页/面板保持一致。
const root = document.documentElement, tBtn = document.getElementById('theme');
const saved = localStorage.getItem('theme');
const dark0 = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
root.classList.toggle('dark', dark0);
tBtn.textContent = dark0 ? '☾' : '☀';
tBtn.onclick = () => {
  const d = root.classList.toggle('dark');
  localStorage.setItem('theme', d ? 'dark' : 'light');
  tBtn.textContent = d ? '☾' : '☀';
};

const nav = document.getElementById('nav');
addEventListener('scroll', () => nav.classList.toggle('scrolled', scrollY > 8), {passive:true});

const io = new IntersectionObserver((es) => {
  es.forEach(e => { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
}, {threshold:.12, rootMargin:'0px 0px -8% 0px'});
document.querySelectorAll('.rv').forEach(el => io.observe(el));

// 终端动画循环重放：CSS animation-delay 只在首次生效，
// 所以整段重启靠移除再插回节点来强制重新触发。
// 只在终端可见时循环，滚走后停掉，避免后台无谓重排。
// 不用定时器循环：每轮重放会把 8 行全部重置成 opacity:0，
// 在 animation-delay 生效前有一段整块空白，正在阅读的人会看到终端每 8 秒闪空一次，
// 像坏掉而不像动画。改为播放一次，滚离后再回来时才重放。
function replay() {
  // 重新查询：上一轮 replaceWith 之后旧引用已脱离文档。
  const cur = document.getElementById('tbody');
  if (cur) cur.replaceWith(cur.cloneNode(true));
}
let wasAway = false;
new IntersectionObserver((es) => {
  const vis = es[0].isIntersecting;
  if (!vis) { wasAway = true; return; }
  if (wasAway) { wasAway = false; replay(); }
}, {threshold:.3}).observe(document.getElementById('how'));

// 双语：中文为默认，英文覆盖表只在切换时应用。
const EN = {
  'nav.login':'Log in','nav.start':'Get started',
  'hero.eyebrow':'Anthropic-protocol compatible gateway',
  'hero.h1':'Two env vars, <span class="accent">and you’re running</span>',
  'hero.lede':'Standard Anthropic Messages protocol. Claude Code, the official SDKs, any compatible client — point base_url here and it just works. No code changes.',
  'hero.cta1':'Get started','hero.cta2':'See how it works',
  'hero.note':'Free trial credit on signup · metered — <b>pay for what you use</b>',
  't.l0':'# two environment variables, that’s it',
  't.l4':'connected','t.l4b':'claude-opus-5 · 1M context',
  't.l5':'# switching models means changing the model field, not the endpoint',
  'strip.note':'live now · one key calls every model, no separate applications',
  'mdl.title':'Models available','mdl.sub':'The full Claude family, plus others to choose from',
  'mdl.opus':'Deepest reasoning · up to 1M context',
  'mdl.sonnet':'Everyday workhorse · balanced speed and quality',
  'mdl.haiku':'Light and fast · built for high-frequency calls',
  'mdl.also':'also supported','mdl.auto':'Auto routing','mdl.latest':'latest',
  'pp.title':'Sound familiar?',
  'pp.1t':'Subscriptions add up','pp.1d':'A fixed Max bill every month, and unused quota is never refunded.',
  'pp.2t':'Juggling accounts','pp.2d':'Several subscriptions in rotation, credentials scattered, chaos on a new machine.',
  'pp.3t':'New model means new code','pp.3d':'Every vendor has its own API shape, so adding one means rewriting your call layer.',
  'pp.4t':'No spend visibility','pp.4d':'No idea where the money went, and no way to cap what your team uses.',
  'sol.title':'Here’s how we fix it','sol.sub':'Three steps to a calmer Claude setup',
  'sol.1t':'One key, all models','sol.1d':'A single API key calls the entire Claude family. No separate applications.',
  'sol.2t':'One protocol','sol.2d':'Everything speaks standard Anthropic Messages. Switching models means changing one field.',
  'sol.3t':'Pay for what you use','sol.3d':'Metered billing, quota ceilings, and per-member usage you can actually read.',
  'cmp.title':'Why not wire up each vendor yourself?',
  'cmp.h0':'','cmp.h1':'Integrating each vendor',
  'cmp.r1':'Integration cost','cmp.r1a':'A separate SDK, auth, and error model per vendor','cmp.r1b':'One key, one protocol',
  'cmp.r2':'Switching models','cmp.r2a':'Rewrite the call layer','cmp.r2b':'Change the model field',
  'cmp.r3':'Billing','cmp.r3a':'Top up and track each vendor separately','cmp.r3b':'One balance, metered',
  'cmp.r4':'Client support','cmp.r4a':'Claude Code only speaks the Anthropic protocol','cmp.r4b':'Every model works through Claude Code',
  'cmp.r5':'Spend control','cmp.r5a':'Check each vendor’s own console','cmp.r5b':'Set quotas and read the log in one place',
  'cta.title':'Ready to start?','cta.sub':'Sign up for free trial credit and wire Claude into your workflow in minutes',
  'cta.btn':'Sign up free',
  'foot.rights':'All rights reserved.','foot.usage':'Usage lookup','foot.terms':'Terms'
};
// hero.note 含 <b>，用 innerHTML 存取；其余走 textContent 避免注入面。
const HTML_KEYS = new Set(['hero.note','hero.h1']);
const TITLE = {zh:'SkiAPI — Anthropic 协议兼容网关', en:'SkiAPI — Anthropic-protocol compatible gateway'};
const ZH = new Map();
function collect() {
  document.querySelectorAll('[data-i]').forEach(n => {
    if (!ZH.has(n.dataset.i)) ZH.set(n.dataset.i, HTML_KEYS.has(n.dataset.i) ? n.innerHTML : n.textContent);
  });
}
collect();
let lang = localStorage.getItem('landing_lang') || 'zh';
const lBtn = document.getElementById('lang');
function applyLang() {
  lBtn.textContent = lang === 'zh' ? 'ZH' : 'EN';
  root.lang = lang === 'zh' ? 'zh-CN' : 'en';
  document.title = TITLE[lang];
  // 终端节点每 CYCLE 被替换，所以每次都重新查询而不是缓存节点引用。
  document.querySelectorAll('[data-i]').forEach(n => {
    const k = n.dataset.i;
    const v = lang === 'zh' ? ZH.get(k) : (EN[k] ?? ZH.get(k));
    if (v === undefined) return;
    if (HTML_KEYS.has(k)) n.innerHTML = v; else n.textContent = v;
  });
}
lBtn.onclick = () => { lang = lang === 'zh' ? 'en' : 'zh'; localStorage.setItem('landing_lang', lang); applyLang(); };
if (lang === 'en') applyLang();
// 终端重放后新克隆的节点是中文原文，英文模式下需要补翻。
new MutationObserver(() => { if (lang === 'en') applyLang(); })
  .observe(document.querySelector('.term'), {childList:true});
</script>
