window.vendorOf = n => (window.VENDOR_RULES.find(([re]) => re.test(n)) || [null, 'Other'])[1];

// Renders a vendor mark as a standalone SVG string at `size` px, or '' when the vendor
// is unknown or has no path (caller falls back to `fallbackText`).
window.vendorIconSVG = (vendorKey, size = 20) => {
  const icon = window.VENDOR_ICONS[vendorKey];
  if (!icon || !icon.path) return '';
  return (
    '<svg xmlns="http://www.w3.org/2000/svg"' +
    ' width="' + size + '" height="' + size + '"' +
    ' viewBox="' + icon.viewBox + '"' +
    ' fill="currentColor" fill-rule="evenodd"' +
    ' role="img" aria-label="' + icon.label + '">' +
    icon.path +
    '</svg>'
  );
};
</script>
<script>
'use strict';
const $ = s => document.querySelector(s);

/* ---- 厂商表 -------------------------------------------------------------
   品牌标记来自上面内联的 VENDOR_ICONS（lobehub/lobe-icons）。那一段万一没
   内联进来，下面这份兜底表保证颜色/名称/首字母块仍然正确，页面不开天窗。
   ---------------------------------------------------------------------- */
const FALLBACK_VENDORS = {
  Anthropic: {label:'Anthropic', color:'#D97757', fallbackText:'A'},
  OpenAI:    {label:'OpenAI',    color:'#10A37F', fallbackText:'O'},
  MiniMax:   {label:'MiniMax',   color:'#F23F5D', fallbackText:'M'},
  DeepSeek:  {label:'DeepSeek',  color:'#4D6BFE', fallbackText:'D'},
  ZhipuAI:   {label:'Z.ai',      color:'#3859FF', fallbackText:'Z'},
  Qwen:      {label:'Qwen',      color:'#615CED', fallbackText:'Q'},
};
/* 本站接口不返回 vendor 字段，按模型名前缀推导，好让厂商强调色用得上。
   顺序有意义：claude 必须在 gpt 之前判断，否则 Claude 分组里的 gpt-4o 会串色。 */
const FALLBACK_RULES = [
  [/^claude/i,'Anthropic'], [/^gpt|^o[134]-|^chatgpt/i,'OpenAI'],
  [/^minimax/i,'MiniMax'], [/^deepseek/i,'DeepSeek'],
  [/^glm/i,'ZhipuAI'], [/^qwen/i,'Qwen'],
];
/* 卡片/表格里厂商的排列顺序：先按模型数降序，同数按这里的次序，保证每次刷新一致 */
const VENDOR_ORDER = ['Anthropic','OpenAI','MiniMax','DeepSeek','ZhipuAI','Qwen'];

const ICONS = (window.VENDOR_ICONS && typeof window.VENDOR_ICONS === 'object')
  ? window.VENDOR_ICONS : FALLBACK_VENDORS;
const HAS_SVG = typeof window.vendorIconSVG === 'function';
const RULES = Array.isArray(window.VENDOR_RULES) ? window.VENDOR_RULES : FALLBACK_RULES;
const vendorOf = typeof window.vendorOf === 'function'
  ? window.vendorOf
  : n => (RULES.find(([re]) => re.test(n)) || [null,'Other'])[1];
const meta = v => ICONS[v] || FALLBACK_VENDORS[v] || {};
const vcOf = v => meta(v).color || '#A78BFA';
const vlOf = v => meta(v).label || v;      /* ZhipuAI 显示成 Z.ai 就靠这里 */
const vmOf = v => meta(v).fallbackText || String(v).slice(0,1).toUpperCase();

/* ---- i18n --------------------------------------------------------------- */
const EN = {
  'back':'Back','h1':'Model Plaza',
  'sub':'Prices follow upstream changes; this page reads the API live. Each discount is computed from that model’s own site price ÷ list price.',
  'ph':'Search models…','v.card':'Cards','v.table':'Table','s.name':'By name','s.price':'By price',
  'f.group':'Group','f.vendor':'Vendor','f.all':'All',
  'th.model':'Model','th.vendor':'Vendor','th.in':'input','th.out':'output',
  'th.cw':'cache write','th.cr':'cache read','th.disc':'discount','th.grp':'Group',
  'mine':'our price','off':'list price',
  'st.models':'models','st.vendors':'vendors','st.groups':'groups','st.cheapest':'cheapest input',
  'copied':'Model name copied','err':'Could not load','noff':'Model plaza is not enabled',
  'noffd':'An administrator can enable it in settings.','empty':'No models match',
  'rate':'effective multiplier','save':'save','nooff':'No published list price to compare.',
  'perM':'per 1M tokens',
  'warn':'The blurb’s percentage differs from the live multiplier above; the multiplier is what the API reports.',
};
let lang = 'zh';
try { if (localStorage.getItem('lang') === 'en') lang = 'en'; } catch (e) {}
const ZH = {};
document.querySelectorAll('[data-i]').forEach(el => ZH[el.dataset.i] = el.textContent);
ZH['ph'] = $('#q').placeholder;
ZH['th.in'] = '输入'; ZH['th.out'] = '输出'; ZH['th.cw'] = '缓存写入';
ZH['th.cr'] = '缓存读取'; ZH['th.disc'] = '折扣'; ZH['th.model'] = '模型';
ZH['th.vendor'] = '厂商'; ZH['th.grp'] = '分组';
ZH['mine'] = '本站价'; ZH['off'] = '官方价';
ZH['f.group'] = '分组'; ZH['f.vendor'] = '厂商'; ZH['f.all'] = '全部';
ZH['st.models'] = '个模型'; ZH['st.vendors'] = '家厂商'; ZH['st.groups'] = '个分组';
ZH['st.cheapest'] = '最低输入价';
ZH['copied'] = '模型名已复制'; ZH['err'] = '加载失败'; ZH['noff'] = '模型广场未启用';
ZH['noffd'] = '管理员可在后台设置里开启。'; ZH['empty'] = '没有匹配的模型';
ZH['rate'] = '实际倍率'; ZH['save'] = '省'; ZH['nooff'] = '该模型未公布官方价，不做对比。';
ZH['perM'] = '每 100 万 tokens';
ZH['warn'] = '描述里的百分比与上面的实际倍率不一致，以接口返回的实际倍率为准。';
const t = k => (lang === 'en' ? EN[k] : ZH[k]) || k;

/* ---- 主题：与站内其它页共用 localStorage 的 'theme' 键 ------------------ */
const MOON = '<path d="M20.985 12.486a9 9 0 1 1-9.473-9.472c.405-.022.617.46.402.803a6 6 0 0 0 8.268 8.268c.344-.215.825-.004.803.401"/>';
const SUN = '<circle cx="12" cy="12" r="4"/><path d="M12 2v2"/><path d="M12 20v2"/><path d="m4.93 4.93 1.41 1.41"/><path d="m17.66 17.66 1.41 1.41"/><path d="M2 12h2"/><path d="M20 12h2"/><path d="m6.34 17.66-1.41 1.41"/><path d="m19.07 4.93-1.41 1.41"/>';
let dark = true;
try {
  const s = localStorage.getItem('theme');
  dark = s ? s === 'dark' : !matchMedia('(prefers-color-scheme: light)').matches;
} catch (e) { /* 隐私模式下访问 localStorage 会抛，用默认值 */ }
function applyTheme() {
  document.documentElement.classList.toggle('light', !dark);
  $('#theme-ic').innerHTML = dark ? MOON : SUN;
}
applyTheme();
$('#theme').onclick = () => {
  dark = !dark; applyTheme();
  try { localStorage.setItem('theme', dark ? 'dark' : 'light'); } catch (e) {}
};

let toastT;
function toast(m) {
  const el = $('#toast'); el.textContent = m; el.classList.add('on');
  clearTimeout(toastT); toastT = setTimeout(() => el.classList.remove('on'), 1700);
}
function esc(s) {
  // 模型名与分组描述都来自数据库（管理员可改）。一律转义，不给存储型 XSS 留路。
  return String(s).replace(/[&<>"']/g, c =>
    ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}
/* 品牌标记：有内联 SVG 就用，没有就退化成品牌色首字母块 */
function icon(v, cls) {
  const svg = HAS_SVG ? window.vendorIconSVG(v, 20) : '';
  return svg
    ? '<span class="' + cls + '">' + svg + '</span>'
    : '<span class="' + cls + ' mono">' + esc(vmOf(v)) + '</span>';
}

/* ---- 数据 ---------------------------------------------------------------
   价格口径（我实测核对过，写错就是在钱上骗人）：
     本站实收 = pricing.<字段> × group.rate_multiplier × 1e6（换算成每 1M）。
   折扣在**分组级** rate_multiplier 上（当前两组都是 0.08），pricing.* 本身
   多数与 official_pricing.* 数值相同（倍率 1.000）。直接显示 pricing.input_price
   会把官方价当本站价 —— 那是最危险的一种错。

   但**不能**因此把折扣写成 1 - rate_multiplier。2026-08-06 实测：38 个有官方价
   的模型里有 6 个 pricing.* ≠ official_pricing.*（gpt-5.6-luna 5 倍、gpt-5.6-terra
   1.25 倍、claude-haiku-4-5[-20251001]-thinking 4 倍、claude-sonnet-5-thinking
   0.667 倍、gpt-4o 输入 2 倍/输出 2.5 倍）。这些模型的真实折扣分别是 60% / 90% /
   68% / 94.7% / 84~80%，若一律标 92% 就是虚标。所以折扣**逐模型按
   1 - 本站价 ÷ 官方价**实算，输入与输出折扣不一致时显示区间。

   另有一处生产数据自相矛盾：分组描述写「按官方价的 5%」「10%」，而
   rate_multiplier 是 0.08。这里原样显示描述，但把实际倍率单独标出来，
   不让读者把描述里的百分比当成真实费率。
   ---------------------------------------------------------------------- */
let MODELS = [], GROUPS = [], DESC = '';
let fGroup = null, fVendor = null, view = 'card', sort = 'name', q = '';

const perM = (v, mult) => (v == null ? null : v * 1e6 * mult);
const fmtUSD = (v) => {
  if (v == null) return '—';
  if (v === 0) return '$0';
  // 小数位按量级选，避免 4.0000000000000003e-7 这种浮点残渣直接显示给用户
  const d = v >= 1 ? 2 : v >= 0.01 ? 4 : 6;
  return '$' + v.toFixed(d);
};
/* 单项折扣。官方价缺失或为 0 时返回 null —— 不编造对比，也绝不产出 NaN。 */
const discOf = (site, off) =>
  (site != null && off != null && off > 0) ? 1 - site / off : null;
/* 折扣百分比文案。输入与输出折扣取整后不同则显示区间（gpt-4o 就是 80~84%）。 */
function discPct(m) {
  const xs = [discOf(m.inp, m.oInp), discOf(m.out, m.oOut)].filter(v => v != null && v > 0);
  if (!xs.length) return null;
  const r = v => Math.round(v * 100);
  const lo = r(Math.min.apply(null, xs)), hi = r(Math.max.apply(null, xs));
  return lo === hi ? hi + '%' : lo + '~' + hi + '%';
}

function fail(html) { $('#out').innerHTML = '<div class="msg glass">' + html + '</div>'; }

async function load() {
  let r;
  try {
    r = await fetch('/api/v1/model-plaza', {cache:'no-store'});
  } catch (e) {
    return fail('<b>' + esc(t('err')) + '</b>' + esc(String(e && e.message || e)));
  }
  if (r.status === 404) {
    return fail('<b>' + esc(t('noff')) + '</b>' + esc(t('noffd')) +
      '<br><code>model_plaza_enabled = true</code>');
  }
  if (!r.ok) return fail('<b>' + esc(t('err')) + '</b>HTTP ' + r.status);
  let j;
  try { j = await r.json(); } catch (e) { return fail('<b>' + esc(t('err')) + '</b>JSON'); }

  const d = (j && j.data) || j || {};
  DESC = d.description || '';
  const gs = Array.isArray(d.groups) ? d.groups : [];
  GROUPS = gs.map(g => ({
    name: g.name || '', desc: g.description || '',
    mult: typeof g.rate_multiplier === 'number' ? g.rate_multiplier : 1,
  }));
  MODELS = [];
  gs.forEach(g => {
    const mult = typeof g.rate_multiplier === 'number' ? g.rate_multiplier : 1;
    (Array.isArray(g.models) ? g.models : []).forEach(m => {
      const p = m.pricing || {}, o = m.official_pricing || null;
      const name = m.name || '-';
      const v = vendorOf(name);
      MODELS.push({
        name, vendor: v, vc: vcOf(v), group: g.name || '', mult,
        think: /-thinking$/.test(name),
        inp: perM(p.input_price, mult), out: perM(p.output_price, mult),
        cw: perM(p.cache_write_price, mult), cr: perM(p.cache_read_price, mult),
        // 官方价不乘倍率 —— 倍率是本站折扣，官方价按原样列出来做对照
        oInp: o ? perM(o.input_price, 1) : null, oOut: o ? perM(o.output_price, 1) : null,
        oCw: o ? perM(o.cache_write_price, 1) : null, oCr: o ? perM(o.cache_read_price, 1) : null,
        hasOff: !!(o && (o.input_price != null || o.output_price != null)),
      });
    });
  });
  if (!MODELS.length) return fail('<b>' + esc(t('empty')) + '</b>');
  render();
}

function counts(key) {
  const c = {};
  MODELS.forEach(m => { c[m[key]] = (c[m[key]] || 0) + 1; });
  return c;
}
/* 厂商列表：按模型数降序，同数按 VENDOR_ORDER，未知厂商排最后 —— 顺序稳定 */
function vendorList() {
  const c = counts('vendor');
  return Object.keys(c).map(v => ({v, n: c[v]})).sort((a, b) =>
    b.n - a.n ||
    ((VENDOR_ORDER.indexOf(a.v) + 1 || 99) - (VENDOR_ORDER.indexOf(b.v) + 1 || 99)) ||
    a.v.localeCompare(b.v));
}

/* 宽屏（侧栏在左侧那一列时）分组描述默认展开；窄屏折起来。
   纯 CSS 控制不了 <details open>，所以在这里按 matchMedia 取一次。 */
const WIDE = !matchMedia('(max-width:960px)').matches;

function renderShell() {
  if (DESC) { const el = $('#desc'); el.hidden = false; el.textContent = DESC; }

  // 「43 个模型 · 本站价与官方价并列」—— 个数由数据算出，不写死
  const em = k => '<em>' + esc(t(k)) + '</em>';
  const sep = '<span class="sep">·</span>';
  $('#tally').innerHTML =
    '<span><b>' + MODELS.length + '</b> ' + esc(t('st.models')) + '</span>' + sep +
    '<span>' + (lang === 'en'
      ? em('mine') + ' next to the ' + em('off')
      : em('mine') + '与' + em('off') + '并列') + '</span>' + sep +
    '<span>' + esc(t('perM')) + '</span>';

  const cheapest = MODELS.reduce((a, m) =>
    (m.inp != null && m.inp > 0 && (a == null || m.inp < a)) ? m.inp : a, null);
  const svg = p => '<svg viewBox="0 0 24 24">' + p + '</svg>';
  const stats = [
    {c:'#A78BFA', v:MODELS.length, l:t('st.models'),
     p:'<path d="M12 2 2 7l10 5 10-5-10-5Z"/><path d="m2 17 10 5 10-5"/><path d="m2 12 10 5 10-5"/>'},
    {c:'#F59E0B', v:vendorList().length, l:t('st.vendors'),
     p:'<path d="M3 21h18"/><path d="M5 21V7l7-4 7 4v14"/><path d="M9 21v-6h6v6"/>'},
    {c:'#34D399', v:GROUPS.length, l:t('st.groups'),
     p:'<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M3 5V19A9 3 0 0 0 21 19V5"/><path d="M3 12A9 3 0 0 0 21 12"/>'},
    {c:'#60A5FA', v:fmtUSD(cheapest), l:t('st.cheapest'),
     p:'<path d="M22 7 13.5 15.5l-5-5L2 17"/><path d="M16 7h6v6"/>'},
  ];
  $('#stats').innerHTML = stats.map(s =>
    '<div class="stat" style="background:color-mix(in srgb,' + s.c + ' 8%,transparent);' +
    'border:1px solid color-mix(in srgb,' + s.c + ' 12%,transparent)">' +
    '<div class="stat-ic" style="background:color-mix(in srgb,' + s.c + ' 12%,transparent);color:' +
    s.c + '">' + svg(s.p) + '</div><div><b>' + esc(String(s.v)) + '</b><span>' +
    esc(s.l) + '</span></div></div>').join('');

  // 厂商 pill：六家品牌色 + 内联品牌标记 + 计数
  $('#pills').innerHTML = vendorList().map(({v, n}) => {
    const on = fVendor === v, col = vcOf(v);
    const sty = on ? ' style="--vc:' + col + ';border-color:color-mix(in srgb,' + col +
      ' 55%,transparent);background:color-mix(in srgb,' + col + ' 15%,transparent);' +
      'box-shadow:0 2px 8px color-mix(in srgb,' + col + ' 25%,transparent)"'
      : ' style="--vc:' + col + '"';
    return '<button class="pill" data-v="' + esc(v) + '" aria-pressed="' + on + '"' + sty + '>' +
      icon(v, 'pill-dot') +
      '<span class="pill-n"' + (on ? ' style="color:' + col + '"' : '') + '>' + esc(vlOf(v)) +
      '</span><span class="pill-c">' + n + '</span></button>';
  }).join('');
  $('#pills').querySelectorAll('.pill').forEach(b => b.onclick = () => {
    fVendor = fVendor === b.dataset.v ? null : b.dataset.v; render();
  });

  const gc = counts('group');
  $('#side').innerHTML =
    // 厂商筛选：六家都在，各带品牌色、标记与计数
    '<div class="fsec"><span class="fsec-t">' + esc(t('f.vendor')) + '</span><div class="chips">' +
    '<button class="chip" data-v="" aria-pressed="' + (fVendor === null) + '">' +
      '<span class="chip-l">' + esc(t('f.all')) + '</span>' +
      '<span class="chip-c">' + MODELS.length + '</span></button>' +
    vendorList().map(({v, n}) =>
      '<button class="chip v" data-v="' + esc(v) + '" aria-pressed="' + (fVendor === v) +
      '" style="--vc:' + vcOf(v) + '">' + icon(v, 'chip-i') +
      '<span class="chip-l">' + esc(vlOf(v)) + '</span>' +
      '<span class="chip-c">' + n + '</span></button>').join('') +
    '</div></div>' +
    '<div class="fsec"><span class="fsec-t">' + esc(t('f.group')) + '</span><div class="chips">' +
    '<button class="chip" data-g="" aria-pressed="' + (fGroup === null) + '">' +
      '<span class="chip-l">' + esc(t('f.all')) + '</span>' +
      '<span class="chip-c">' + MODELS.length + '</span></button>' +
    GROUPS.map(g =>
      '<button class="chip" data-g="' + esc(g.name) + '" aria-pressed="' + (fGroup === g.name) + '">' +
      '<span class="chip-l">' + esc(g.name) + '</span>' +
      '<span class="chip-r">' + g.mult + 'x</span>' +
      '<span class="chip-c">' + (gc[g.name] || 0) + '</span></button>').join('') +
    '</div></div>' +
    // 分组描述原样显示；实际倍率单独一行；描述里的百分比与倍率不一致时明说。
    // 窄屏时侧栏排在内容上方，这几段描述会把首张卡片推得很远，所以折起来（宽屏默认展开）。
    GROUPS.filter(g => g.desc).map(g => {
      const pcts = g.desc.match(/\d+(\.\d+)?%/g) || [];
      const bad = pcts.length && pcts.indexOf(+(g.mult * 100).toFixed(4) + '%') < 0;
      return '<details class="fsec gnote"' + (WIDE ? ' open' : '') + '>' +
        '<summary class="fsec-t">' + esc(g.name) + '</summary>' +
        '<div class="gdesc">' + esc(g.desc) + '</div>' +
        '<div class="grate">' + esc(t('rate')) + ' ' + g.mult + 'x</div>' +
        (bad ? '<div class="gwarn">' + esc(t('warn')) + '</div>' : '') + '</details>';
    }).join('');
  $('#side').querySelectorAll('.chip[data-g]').forEach(b => b.onclick = () => {
    fGroup = b.dataset.g === '' ? null : (fGroup === b.dataset.g ? null : b.dataset.g);
    render();
  });
  $('#side').querySelectorAll('.chip[data-v]').forEach(b => b.onclick = () => {
    fVendor = b.dataset.v === '' ? null : (fVendor === b.dataset.v ? null : b.dataset.v);
    render();
  });
}

function filtered() {
  let r = MODELS.slice();
  if (fGroup) r = r.filter(m => m.group === fGroup);
  if (fVendor) r = r.filter(m => m.vendor === fVendor);
  if (q) {
    const k = q.toLowerCase();
    r = r.filter(m => m.name.toLowerCase().indexOf(k) >= 0 ||
      vlOf(m.vendor).toLowerCase().indexOf(k) >= 0);
  }
  r.sort(sort === 'price'
    ? (a,b) => (a.inp == null) - (b.inp == null) || (a.inp || 0) - (b.inp || 0) ||
               a.name.localeCompare(b.name)
    : (a,b) => a.name.localeCompare(b.name));
  return r;
}

const CP = '<svg viewBox="0 0 24 24"><rect width="14" height="14" x="8" y="8" rx="2" ry="2"/><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"/></svg>';

/* 价格行：本站价一列（accent 主导）+ 官方价一列（划掉、弱化）。
   没有官方价的模型走 solo 两列，不留空格子，也不显示 NaN。 */
function pxRow(label, mine, off, hasOff, cls) {
  return '<div class="px-row' + (cls ? ' ' + cls : '') + '"><dt>' + esc(label) + '</dt>' +
    '<dd class="mine' + (cls ? ' c' : '') + '">' + fmtUSD(mine) + '</dd>' +
    (hasOff ? '<dd class="off">' + fmtUSD(off) + '</dd>' : '') + '</div>';
}

function cardHTML(m, i) {
  const pct = discPct(m);
  return '<article class="card" style="--vc:' + m.vc + ';animation-delay:' +
    Math.min(i * 0.03, 0.4).toFixed(2) + 's">' +
    '<div class="card-hd">' +
      icon(m.vendor, 'card-ic') +
      '<div class="card-nm"><b>' + esc(m.name) + '</b><span>' + esc(vlOf(m.vendor)) + '</span></div>' +
      '<button class="card-cp" data-cp="' + esc(m.name) + '" aria-label="' +
        esc(lang === 'en' ? 'Copy model name' : '复制模型名') + '">' + CP + '</button>' +
    '</div>' +
    '<div class="px">' +
      '<div class="px-hd"><span class="k mine">' + esc(t('mine')) + '</span>' +
        (m.hasOff ? '<span class="k sl">' + esc(t('off')) + '</span>' : '') +
        '<span class="sp"></span>' +
        (pct ? '<span class="px-disc">' + esc(t('save') + ' ' + pct) + '</span>' : '') +
      '</div>' +
      '<dl class="px-g' + (m.hasOff ? '' : ' solo') + '">' +
        pxRow(t('th.in'), m.inp, m.oInp, m.hasOff) +
        pxRow(t('th.out'), m.out, m.oOut, m.hasOff) +
        (m.cw != null ? pxRow(t('th.cw'), m.cw, m.oCw, m.hasOff, 'cache') : '') +
        (m.cr != null ? pxRow(t('th.cr'), m.cr, m.oCr, m.hasOff, 'cache') : '') +
      '</dl>' +
      (m.hasOff ? '' : '<div class="px-note">' + esc(t('nooff')) + '</div>') +
    '</div>' +
    '<div class="tags"><span class="tag">' + m.mult + 'x</span>' +
      (m.think ? '<span class="tag think">thinking</span>' : '') +
      '<span class="tag grp">' + esc(m.group) + '</span></div>' +
  '</article>';
}

function tableHTML(rows) {
  const th = (k, cls) => '<th scope="col"' + (cls ? ' class="' + cls + '"' : '') + '>' +
    esc(t(k)) + '</th>';
  return '<div class="tbl-wrap"><table><thead>' +
    // 第一行把两组价格跨列分开，第二行才是具体项目
    '<tr class="g"><th scope="col" colspan="2"></th>' +
      '<th scope="colgroup" colspan="4" class="mine grp-a">' + esc(t('mine')) + '</th>' +
      '<th scope="colgroup" colspan="2" class="grp-b">' + esc(t('off')) + '</th>' +
      '<th scope="col" colspan="2"></th></tr>' +
    '<tr class="h">' + th('th.model') + th('th.vendor') +
      th('th.in', 'n mine grp-a') + th('th.out', 'n mine grp-a') +
      th('th.cw', 'n mine grp-a') + th('th.cr', 'n mine grp-a') +
      th('th.in', 'n grp-b') + th('th.out', 'n grp-b') +
      th('th.disc', 'n') + th('th.grp') + '</tr></thead><tbody>' +
    rows.map(m => {
      const pct = discPct(m);
      const o = v => m.hasOff
        ? '<td class="n off grp-b">' + fmtUSD(v) + '</td>'
        : '<td class="n dash grp-b">—</td>';
      return '<tr><td class="m">' + esc(m.name) +
        (m.think ? ' <span class="tag think">t</span>' : '') + '</td>' +
      '<td><span class="vd" style="--vc:' + m.vc + '">' + icon(m.vendor, 'vi') +
        esc(vlOf(m.vendor)) + '</span></td>' +
      '<td class="n hi grp-a">' + fmtUSD(m.inp) + '</td>' +
      '<td class="n hi grp-a">' + fmtUSD(m.out) + '</td>' +
      '<td class="n grp-a">' + fmtUSD(m.cw) + '</td>' +
      '<td class="n grp-a">' + fmtUSD(m.cr) + '</td>' +
      o(m.oInp) + o(m.oOut) +
      '<td class="n disc">' + (pct ? esc(pct) : '<span class="dash">—</span>') + '</td>' +
      '<td class="m" style="color:var(--muted);font-size:11.4px">' + esc(m.group) + '</td></tr>';
    }).join('') + '</tbody></table></div>';
}

function render() {
  if (!MODELS.length) return;
  renderShell();
  const rows = filtered();
  $('#count').textContent = rows.length + ' / ' + MODELS.length;
  const out = $('#out');
  if (!rows.length) {
    out.innerHTML = '<div class="msg glass"><b>' + esc(t('empty')) + '</b></div>';
    return;
  }
  out.innerHTML = view === 'card'
    ? '<div class="grid">' + rows.map(cardHTML).join('') + '</div>'
    : tableHTML(rows);

  out.querySelectorAll('[data-cp]').forEach(b => b.onclick = async () => {
    const v = b.dataset.cp;
    try { await navigator.clipboard.writeText(v); }
    catch (e) {
      // 非 HTTPS 或权限被拒时 clipboard API 不可用，退回选中让用户自己按 ⌘C
      const ta = document.createElement('textarea');
      ta.value = v; document.body.appendChild(ta); ta.select();
      try { document.execCommand('copy'); } catch (e2) {}
      ta.remove();
    }
    toast(t('copied'));
  });
}

/* ---- 控件 --------------------------------------------------------------- */
let qT;
$('#q').oninput = e => {
  q = e.target.value.trim();
  clearTimeout(qT); qT = setTimeout(render, 120);   // 去抖：43 个模型也别每键重排
};
function segPair(aSel, bSel, aVal, bVal, set) {
  const a = $(aSel), b = $(bSel);
  a.onclick = () => { set(aVal); a.setAttribute('aria-pressed','true'); b.setAttribute('aria-pressed','false'); render(); };
  b.onclick = () => { set(bVal); b.setAttribute('aria-pressed','true'); a.setAttribute('aria-pressed','false'); render(); };
}
segPair('#v-card', '#v-tbl', 'card', 'tbl', v => view = v);
segPair('#s-name', '#s-price', 'name', 'price', s => sort = s);

function applyLang() {
  $('#lang-t').textContent = lang === 'en' ? 'EN' : 'ZH';
  document.documentElement.lang = lang === 'en' ? 'en' : 'zh-CN';
  document.querySelectorAll('[data-i]').forEach(el => { el.textContent = t(el.dataset.i); });
  $('#q').placeholder = t('ph');
  if (MODELS.length) render();
}
$('#lang').onclick = () => {
  lang = lang === 'en' ? 'zh' : 'en';
  try { localStorage.setItem('lang', lang); } catch (e) {}
  applyLang();
};
if (lang === 'en') applyLang();

load();
</script>
</body>
</html>
