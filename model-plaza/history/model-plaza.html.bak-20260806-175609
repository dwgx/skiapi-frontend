<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<link rel="icon" type="image/png" href="/favicon.png">
<title>模型广场 — SkiAPI</title>
<style>
/* ============================================================================
   模型广场
   ----------------------------------------------------------------------------
   这是 dwgx/skiapi-frontend 的 src/pages/Pricing.jsx 移植版，**不是** sub2api
   自带那套 8 列宽表。设计语言（配色、卡片手法、动画曲线）照搬原件，只把 MUI
   的 sx 翻译成原生 CSS，并把数据层适配到本站 /api/v1/model-plaza。

   被迫偏离原件的三处，各自注明：
   1. Geist / Geist Mono 换系统栈 —— 应用下发的 CSP 只放行 'self'，webfont
      外链会被拦，内嵌字体文件又让单文件体积翻倍。
   2. 原件字段是 model_ratio / completion_ratio / model_price / quota_per_unit，
      本站接口是 groups[].models[].pricing 与 official_pricing，所以筛选维度
      从"厂商 + 分组"改成"分组 + 由模型名推导厂商"。
   3. 原件 VendorIcon 依赖外部图片资源，CSP 只放行 'self'，所以品牌标记全部
      内联成 SVG（见文末 VENDOR_ICONS，取自 lobehub/lobe-icons）。拿不到内联
      表时退化成品牌色首字母块，不让页面开天窗。
   ========================================================================= */

/* ---- 原件 src/theme/index.js 的 TOKENS_DARK / TOKENS_LIGHT，逐值照搬 ---- */
:root{
  --canvas:#0F0F0F; --surface:#1A1A1A; --raised:#242424; --bright:#2E2E2E;
  --hover:#1E1E1E; --border:#2E2E2E; --border-strong:#3D3D3D;
  --text:#E3E3E3; --muted:#A0A0A0; --subtle:#6E6E6E;
  --accent:#A78BFA; --accent-dim:#7C3AED; --accent-surface:#1E1533;
  --success:#34D399; --warn:#FBBF24; --error:#F87171; --info:#60A5FA;
  /* 原件的 M3 缓动与时长梯度 */
  --ease:cubic-bezier(0.2,0,0,1);
  --d-micro:100ms; --d-short:200ms; --d-med:300ms;
  --r:12px;
  /* 毛玻璃三件套：半透明底 + blur + 1px 半透明描边。深浅色各一组。 */
  --glass:color-mix(in srgb,var(--surface) 58%,transparent);
  --glass-strong:color-mix(in srgb,var(--surface) 74%,transparent);
  --glass-line:color-mix(in srgb,var(--text) 9%,transparent);
  --blur:blur(16px) saturate(140%);
  --sans:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Hiragino Sans GB","Microsoft YaHei",system-ui,sans-serif;
  --mono:ui-monospace,SFMono-Regular,"SF Mono",Menlo,Consolas,monospace;
}
html.light{
  --canvas:#F8F8FA; --surface:#FFFFFF; --raised:#F0F0F3; --bright:#E8E8EC;
  --hover:#F4F4F6; --border:#E0E0E5; --border-strong:#C8C8D0;
  --text:#1A1A1A; --muted:#5C5C66; --subtle:#8C8C96;
  --accent:#7C3AED; --accent-dim:#6D28D9; --accent-surface:#F0EBFF;
  --success:#16A34A; --warn:#D97706; --error:#DC2626; --info:#2563EB;
  --glass:color-mix(in srgb,var(--surface) 62%,transparent);
  --glass-strong:color-mix(in srgb,var(--surface) 80%,transparent);
  --glass-line:color-mix(in srgb,#000 8%,transparent);
}
*{box-sizing:border-box;margin:0;padding:0}
/* 画布背景的两团极淡辉光：毛玻璃要有东西可透，纯平底色下 blur 看不出来。
   刻意画在 body 的 background 上、随页面滚动 —— 早先写成 position:fixed;z-index:-1
   的伪元素，被十几层 backdrop-filter 反复采样，Chromium 的合成器直接卡死：
   JS 照常跑，但任何截图请求（Playwright 与 CDP 都试过）永不返回。 */
body{color:var(--text);font-family:var(--sans);
  line-height:1.6;-webkit-font-smoothing:antialiased;
  background:
    radial-gradient(52rem 30rem at 12% -6%,color-mix(in srgb,var(--accent) 13%,transparent),transparent 70%),
    radial-gradient(44rem 26rem at 92% 2%,color-mix(in srgb,var(--info) 9%,transparent),transparent 72%),
    var(--canvas);
  background-repeat:no-repeat}
a{color:inherit;text-decoration:none}
button{font:inherit;color:inherit;background:none;border:none;cursor:pointer}
:focus-visible{outline:2px solid var(--accent);outline-offset:2px}

/* 毛玻璃工具类。@supports 兜底：不支持 backdrop-filter 时换成实底，
   否则半透明底叠在辉光上会糊得读不了字。 */
.glass{background:var(--glass);backdrop-filter:var(--blur);-webkit-backdrop-filter:var(--blur);
  border:1px solid var(--glass-line)}
@supports not (backdrop-filter:blur(1px)){
  .glass,.top,.side-in,.pill,.chip,.px{background:var(--surface)!important;
    border-color:var(--border)!important}
  .card:hover{background:var(--raised)!important}
}

/* 原件的 pricingFadeUp */
@keyframes pricingFadeUp{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){
  *{animation-duration:.01ms!important;transition-duration:.01ms!important}
}

/* ---- 顶栏 ---------------------------------------------------------------- */
.top{position:sticky;top:0;z-index:40;
  background:color-mix(in srgb,var(--canvas) 72%,transparent);
  backdrop-filter:blur(14px) saturate(150%);-webkit-backdrop-filter:blur(14px) saturate(150%);
  border-bottom:1px solid var(--glass-line)}
.top-in{max-width:1440px;margin:0 auto;padding:0 24px;height:56px;
  display:flex;align-items:center;gap:14px}
.brand{display:flex;align-items:center;gap:9px;font-weight:700;font-size:15px}
.brand img{width:24px;height:24px;border-radius:6px}
.top-sp{flex:1}
.ibtn{width:34px;height:34px;border-radius:10px;display:grid;place-items:center;
  color:var(--muted);transition:background var(--d-short) var(--ease),color var(--d-short) var(--ease)}
.ibtn:hover{background:var(--hover);color:var(--text)}
.ibtn:active{transform:scale(.94)}
.ibtn svg{width:17px;height:17px;fill:none;stroke:currentColor;stroke-width:2;
  stroke-linecap:round;stroke-linejoin:round}
.back{display:inline-flex;align-items:center;gap:6px;font-size:13px;color:var(--muted);
  padding:6px 11px;border-radius:9px;transition:background var(--d-short) var(--ease),color var(--d-short) var(--ease)}
.back:hover{background:var(--hover);color:var(--text)}
.back svg{width:15px;height:15px;fill:none;stroke:currentColor;stroke-width:2;
  stroke-linecap:round;stroke-linejoin:round}
@media (max-width:560px){.back span{display:none}}

/* ---- hero ---------------------------------------------------------------- */
.wrap{max-width:1440px;margin:0 auto;padding:0 24px}
.hero{padding:34px 0 20px}
.hero h1{font-size:clamp(1.6rem,3.4vw,2.1rem);font-weight:800;letter-spacing:-.025em;line-height:1.15}
/* 表头那行「43 个模型 · 本站价与官方价并列」——个数由数据算出，不写死 */
.tally{margin-top:9px;display:flex;align-items:center;gap:9px;flex-wrap:wrap;
  font-size:14px;color:var(--muted)}
.tally b{font-weight:800;color:var(--text);font-variant-numeric:tabular-nums;
  font-size:15px;letter-spacing:-.01em}
.tally .sep{color:var(--subtle)}
.tally em{font-style:normal;color:var(--accent);font-weight:600}
.hero p{color:var(--muted);font-size:13.5px;margin-top:7px;max-width:62ch}
.hero-desc{margin-top:12px;padding:11px 14px;border-radius:var(--r);
  font-size:13px;color:var(--muted);white-space:pre-line}

/* 统计卡：原件 StatCard 的 alpha(color,.08) 底 + alpha(color,.12) 边 */
.stats{display:flex;gap:11px;flex-wrap:wrap;margin-top:16px}
.stat{display:flex;align-items:center;gap:12px;padding:12px 20px;border-radius:14px;
  flex:1;min-width:160px;backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.stat-ic{width:36px;height:36px;border-radius:9px;display:grid;place-items:center;flex:none}
.stat-ic svg{width:18px;height:18px;fill:none;stroke:currentColor;stroke-width:2;
  stroke-linecap:round;stroke-linejoin:round}
.stat b{display:block;font-weight:800;font-size:1.1rem;line-height:1.1;
  font-variant-numeric:tabular-nums;letter-spacing:-.02em}
.stat span{font-size:.68rem;color:var(--muted)}

/* 厂商 pill：原件 VendorPill，含 backdrop-filter 与 :active scale(.97) */
.pills{display:flex;gap:8px;flex-wrap:wrap;margin-top:16px}
.pill{display:inline-flex;align-items:center;gap:7px;padding:6px 13px;border-radius:20px;
  border:1.5px solid var(--glass-line);background:var(--glass);
  backdrop-filter:blur(10px) saturate(140%);-webkit-backdrop-filter:blur(10px) saturate(140%);
  transition:transform var(--d-short) var(--ease),border-color var(--d-short) var(--ease),
    background var(--d-short) var(--ease),box-shadow var(--d-short) var(--ease)}
.pill:hover{transform:translateY(-1px)}
.pill:active{transform:scale(.97)}
/* 品牌标记：SVG 用 currentColor，靠 color 上品牌色；退化成首字母时才需要底色块 */
.pill-dot{width:18px;height:18px;display:grid;place-items:center;flex:none;
  font-size:9.5px;font-weight:800;color:var(--vc)}
.pill-dot svg{display:block;width:100%;height:100%}
.pill-dot.mono{border-radius:5px;color:#fff}
.pill-n{font-size:.76rem;font-weight:500}
.pill[aria-pressed="true"] .pill-n{font-weight:700}
.pill-c{padding:1px 5px;border-radius:5px;font-size:.6rem;font-weight:700;
  background:color-mix(in srgb,var(--text) 6%,transparent);color:var(--muted);
  font-variant-numeric:tabular-nums}

/* ---- 主体：sticky 240px 侧栏 + 内容（原件的骨架） ---------------------- */
/* minmax(0,1fr) 而不是 1fr：1fr 的最小值是 auto，表格视图那张 10 列宽表会把
   轨道顶到自己的 min-content（实测 390px 视口下轨道被撑到 853px），于是整页横向
   滚动，而不是 .tbl-wrap 自己内部滚。加了 minmax(0,…) 才轮到 overflow:auto 生效。 */
.main{display:grid;grid-template-columns:240px minmax(0,1fr);gap:26px;padding:22px 0 60px}
/* 轨道用 minmax(0,…) 之外，网格项自己也要 min-width:0 —— 项的自动最小尺寸同样是
   min-content，只改轨道的话项照样会顶出去。两处都改了 overflow:auto 才真正生效。 */
.main>*{min-width:0}
@media (max-width:960px){.main{grid-template-columns:minmax(0,1fr);gap:16px}
  .side{position:static;max-height:none}}
.side{position:sticky;top:76px;align-self:start;max-height:calc(100vh - 96px);
  overflow-y:auto;scrollbar-width:thin}
/* 侧栏整块做成一片毛玻璃 —— 它 sticky 停在内容上方，是毛玻璃最自然的落点 */
.side-in{padding:14px;border-radius:14px;background:var(--glass);
  backdrop-filter:var(--blur);-webkit-backdrop-filter:var(--blur);
  border:1px solid var(--glass-line)}
.fsec{margin-bottom:18px}
.fsec:last-child{margin-bottom:0}
.fsec-t{font-weight:700;font-size:.72rem;color:var(--muted);text-transform:uppercase;
  letter-spacing:.08em;margin-bottom:8px;display:block}
.chips{display:flex;flex-wrap:wrap;gap:4px}
/* 原件 FilterChip：label + ratio 徽章 + count 徽章 */
/* chip 也不单独加模糊：它嵌在已经是毛玻璃的 .side-in 里，父层已经把背后糊过一遍，
   再叠一层只是重复开销。半透明底 + 描边就够读出玻璃感。 */
.chip{display:inline-flex;align-items:center;gap:4px;padding:3.5px 10px;border-radius:9px;
  border:1px solid color-mix(in srgb,var(--border) 60%,transparent);
  background:color-mix(in srgb,var(--surface) 30%,transparent);
  transition:border-color 150ms ease,background 150ms ease,transform 150ms var(--ease)}
.chip:hover{border-color:color-mix(in srgb,var(--accent) 50%,transparent);
  background:color-mix(in srgb,var(--accent) 8%,transparent)}
.chip:active{transform:scale(.97)}
.chip-l{font-size:.72rem;font-weight:500;line-height:1.4}
.chip[aria-pressed="true"]{border-color:color-mix(in srgb,var(--accent) 50%,transparent);
  background:color-mix(in srgb,var(--accent) 14%,transparent)}
.chip[aria-pressed="true"] .chip-l{font-weight:700;color:var(--accent)}
.chip-r{font-size:.62rem;font-weight:600;color:var(--muted);opacity:.8;
  font-variant-numeric:tabular-nums}
.chip[aria-pressed="true"] .chip-r{color:var(--accent)}
.chip-c{padding:.5px 4px;border-radius:4px;min-width:16px;text-align:center;
  font-size:.58rem;font-weight:700;font-variant-numeric:tabular-nums;
  background:color-mix(in srgb,var(--text) 6%,transparent);color:var(--muted)}
.chip[aria-pressed="true"] .chip-c{background:color-mix(in srgb,var(--accent) 15%,transparent);
  color:var(--accent)}
/* 厂商 chip 选中时走品牌色，不走 accent —— 六家品牌色是这一版的重点 */
.chip.v[aria-pressed="true"]{border-color:color-mix(in srgb,var(--vc) 55%,transparent);
  background:color-mix(in srgb,var(--vc) 15%,transparent)}
.chip.v[aria-pressed="true"] .chip-l{color:var(--vc)}
.chip.v[aria-pressed="true"] .chip-c{background:color-mix(in srgb,var(--vc) 18%,transparent);
  color:var(--vc)}
.chip-i{width:13px;height:13px;flex:none;display:grid;place-items:center;color:var(--vc)}
.chip-i svg{display:block;width:100%;height:100%}
.chip-i.mono{border-radius:3px;background:var(--vc);color:#fff;font-size:7.5px;font-weight:800}
.gdesc{font-size:11.6px;color:var(--muted);line-height:1.65;white-space:pre-line}
/* 分组描述里的百分比与 rate_multiplier 不一致（生产数据的已知矛盾），
   描述原样显示，实际倍率单独标一行，别让人把描述里的数字当费率。 */
.grate{margin-top:7px;font-family:var(--mono);font-size:11px;color:var(--accent)}
.gwarn{margin-top:5px;font-size:10.6px;color:var(--warn);line-height:1.5;opacity:.9}
/* 分组描述折叠块：窄屏默认收起，标题右侧一个小箭头 */
.gnote summary{display:flex;align-items:center;gap:6px;cursor:pointer;list-style:none}
.gnote summary::-webkit-details-marker{display:none}
.gnote summary::after{content:'';width:5px;height:5px;flex:none;opacity:.65;
  border-right:1.5px solid currentColor;border-bottom:1.5px solid currentColor;
  transform:rotate(-45deg) translateY(-1px);transition:transform var(--d-short) var(--ease)}
.gnote[open] summary::after{transform:rotate(45deg) translateY(-1px)}
.gnote summary:hover{color:var(--text)}

/* ---- 控制条 -------------------------------------------------------------- */
.ctrl{display:flex;gap:11px;align-items:center;flex-wrap:wrap;margin-bottom:16px}
.search{position:relative;flex:1;min-width:190px;max-width:340px}
.search svg{position:absolute;left:11px;top:50%;transform:translateY(-50%);
  width:15px;height:15px;fill:none;stroke:var(--subtle);stroke-width:2;
  stroke-linecap:round;stroke-linejoin:round;pointer-events:none}
.search input{width:100%;height:38px;padding:0 12px 0 34px;border-radius:11px;
  background:var(--glass);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);
  border:1px solid var(--glass-line);color:var(--text);
  font-size:13.5px;font-family:var(--sans);outline:none;
  transition:border-color var(--d-short) var(--ease)}
.search input:focus{border-color:var(--accent)}
.search input::placeholder{color:var(--subtle)}
.seg{display:inline-flex;border-radius:11px;overflow:hidden;border:1px solid var(--glass-line);
  background:var(--glass);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px)}
.seg button{padding:0 13px;height:38px;font-size:12.5px;color:var(--muted);
  transition:background var(--d-short) var(--ease),color var(--d-short) var(--ease)}
.seg button+button{border-left:1px solid var(--glass-line)}
.seg button[aria-pressed="true"]{background:color-mix(in srgb,var(--accent) 14%,transparent);
  color:var(--accent);font-weight:600}
.ctrl-sp{flex:1}
.count{font-size:12.5px;color:var(--subtle);font-variant-numeric:tabular-nums}

/* ---- 模型卡：原件 ModelCard 逐条还原 ------------------------------------ */
.grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(290px,1fr));gap:12px}
.card{position:relative;overflow:hidden;border-radius:14px;
  /* 原件 dark 下卡底是 vendorColor 4% 到 paper 的 145deg 渐变 */
  background:linear-gradient(145deg,color-mix(in srgb,var(--vc) 6%,transparent) 0%,var(--surface) 42%);
  border:1px solid var(--border);padding:16px;display:flex;flex-direction:column;
  animation:pricingFadeUp var(--d-med) ease-out both;
  transition:transform 250ms var(--ease),border-color 250ms var(--ease),
    box-shadow 250ms var(--ease),background 250ms var(--ease)}
/* 顶部 2px 强调条：默认 opacity 0，hover 才出现 —— 原件最关键的一笔 */
.card::before{content:'';position:absolute;top:0;left:0;right:0;height:2px;opacity:0;
  transition:opacity 250ms ease;z-index:1;
  background:linear-gradient(90deg,var(--vc),color-mix(in srgb,var(--vc) 20%,transparent))}
/* hover 时卡片转成毛玻璃：半透明底 + blur，让底下的辉光透上来 */
.card:hover{transform:translateY(-4px);border-color:color-mix(in srgb,var(--vc) 40%,transparent);
  box-shadow:0 8px 30px color-mix(in srgb,var(--vc) 15%,transparent);
  background:linear-gradient(145deg,color-mix(in srgb,var(--vc) 12%,transparent) 0%,var(--glass-strong) 45%);
  backdrop-filter:var(--blur);-webkit-backdrop-filter:var(--blur)}
.card:hover::before{opacity:1}
.card-hd{display:flex;align-items:flex-start;gap:9px;margin-bottom:13px}
/* 原件是 alpha(vendorColor,.1) 的圆角底 + 26px 品牌图标 */
.card-ic{width:32px;height:32px;border-radius:9px;flex:none;display:grid;place-items:center;
  font-size:12px;font-weight:800;color:var(--vc);
  background:color-mix(in srgb,var(--vc) 12%,transparent);
  border:1px solid color-mix(in srgb,var(--vc) 20%,transparent)}
.card-ic svg{display:block;width:19px;height:19px}
.card-ic.mono{color:#fff;background:color-mix(in srgb,var(--vc) 82%,transparent)}
.card-nm{flex:1;min-width:0}
.card-nm b{display:block;font-weight:700;line-height:1.3;font-size:.8rem;
  font-family:var(--mono);overflow-wrap:anywhere}
.card-nm span{font-size:.68rem;font-weight:600;opacity:.85;color:var(--vc)}
/* 复制按钮：opacity 0 → 卡片 hover .5 → 自身 hover 1（原件行为） */
.card-cp{opacity:0;width:24px;height:24px;border-radius:7px;flex:none;display:grid;
  place-items:center;color:var(--muted);transition:all var(--d-short) var(--ease)}
.card:hover .card-cp{opacity:.5}
.card-cp:hover{opacity:1;color:var(--vc);background:color-mix(in srgb,var(--vc) 12%,transparent)}
.card-cp:focus-visible{opacity:1}
.card-cp svg{width:13px;height:13px;fill:none;stroke:currentColor;stroke-width:2;
  stroke-linecap:round;stroke-linejoin:round}

/* ---- 价格块：本站价与官方价并列 ------------------------------------------
   三列网格：项目 | 本站价 | 官方价。本站价视觉占主导（accent 色 + 700），
   官方价划掉 + 弱化，右上角挂实际折扣。official_pricing 为 null 的模型
   用 .solo 收成两列，不显示空的官方列，也不编造对比。
   ------------------------------------------------------------------------- */
/* 这里刻意**不加** backdrop-filter：价格块贴在不透明的卡面上，模糊没有可透之物，
   43 张卡就是 43 层常驻模糊，纯纯的合成开销（实测把截图卡到 120s 都出不来）。 */
.px{margin-bottom:12px;padding:10px 11px;border-radius:9px;font-family:var(--mono);
  background:color-mix(in srgb,var(--text) 3%,transparent);
  border:1px solid color-mix(in srgb,var(--border) 65%,transparent)}
.px-hd{display:flex;align-items:center;gap:6px;margin-bottom:7px;
  padding-bottom:6px;border-bottom:1px solid color-mix(in srgb,var(--border) 55%,transparent)}
.px-hd .k{font-size:9.6px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;
  color:var(--subtle);font-family:var(--sans)}
.px-hd .k.mine{color:var(--accent)}
/* 图例上的「官方价」也划掉，和下面那一列的处理对上，靠视觉编码而非位置认列 */
.px-hd .k.sl{text-decoration:line-through;text-decoration-thickness:1px}
.px-hd .sp{flex:1}
/* 折扣徽章：真实折扣 = 1 - 本站价/官方价，逐模型算，不是照抄 1-倍率 */
.px-disc{font-size:9.8px;font-weight:800;padding:1.5px 6px;border-radius:20px;
  font-family:var(--sans);white-space:nowrap;
  background:color-mix(in srgb,var(--success) 16%,transparent);color:var(--success);
  border:1px solid color-mix(in srgb,var(--success) 24%,transparent)}
.px-g{display:grid;grid-template-columns:auto 1fr auto;gap:2px 9px;align-items:baseline}
.px-g.solo{grid-template-columns:auto 1fr}
/* dl > div 是合法 HTML，display:contents 让里面的 dt/dd 直接参与网格，
   两列价格才能逐行对齐（各行官方价宽度不一，flex 排法对不齐）。 */
.px-row{display:contents}
.px-g dt{font-size:10.8px;color:var(--muted);white-space:nowrap}
.px-g dd{font-size:11.6px;font-variant-numeric:tabular-nums;letter-spacing:-.02em;
  text-align:right;white-space:nowrap}
/* 本站价：主导 */
.px-g dd.mine{color:var(--accent);font-weight:700}
/* 官方价：划掉 + subtle，一眼看出是被替代的那个数 */
.px-g dd.off{font-size:10.4px;color:var(--subtle);text-decoration:line-through;
  text-decoration-thickness:1px;text-decoration-color:color-mix(in srgb,var(--subtle) 70%,transparent)}
.px-g .cache dt,.px-g .cache dd.mine{opacity:.78;font-weight:500}
.px-g dd.mine.c{color:var(--text);font-weight:500}
.px-note{margin-top:7px;padding-top:6px;font-size:10px;color:var(--subtle);
  font-family:var(--sans);line-height:1.5;
  border-top:1px dashed color-mix(in srgb,var(--border) 80%,transparent)}
.tags{display:flex;gap:5px;flex-wrap:wrap;margin-top:auto}
.tag{font-size:.62rem;padding:2px 7px;border-radius:6px;font-weight:600;
  background:color-mix(in srgb,var(--info) 13%,transparent);color:var(--info);
  font-family:var(--mono)}
.tag.think{background:color-mix(in srgb,var(--warn) 15%,transparent);color:var(--warn)}
.tag.grp{background:color-mix(in srgb,var(--text) 7%,transparent);color:var(--muted);
  font-weight:500;font-family:var(--sans)}

/* ---- 表格视图（原件的 compact table） -----------------------------------
   两行表头：第一行把「本站价」「官方价」分组跨列，第二行是具体项目。
   两组各自带一层极淡底色，免得 43 行看下来串列。 */
.tbl-wrap{border-radius:14px;overflow:auto;background:var(--glass);
  backdrop-filter:var(--blur);-webkit-backdrop-filter:var(--blur);
  border:1px solid var(--glass-line)}
table{width:100%;border-collapse:separate;border-spacing:0;font-size:12.8px}
thead th{position:sticky;z-index:2;background:var(--raised);padding:0 14px;
  text-align:left;font-weight:700;font-size:11.6px;color:var(--muted);white-space:nowrap;
  border-bottom:1px solid var(--border)}
thead tr.g th{top:0;height:30px;font-size:10.4px;letter-spacing:.06em;text-transform:uppercase;
  border-bottom:1px solid color-mix(in srgb,var(--border) 60%,transparent)}
thead tr.h th{top:30px;height:34px}
thead th.mine{color:var(--accent)}
thead th.grp-a{background:color-mix(in srgb,var(--accent) 10%,var(--raised))}
thead th.grp-b{background:color-mix(in srgb,var(--text) 4%,var(--raised))}
td.grp-a{background:color-mix(in srgb,var(--accent) 4%,transparent)}
td.grp-b{background:color-mix(in srgb,var(--text) 2%,transparent)}
tbody td,tbody th{padding:9px 14px;text-align:left;font-weight:400;
  border-bottom:1px solid color-mix(in srgb,var(--border) 55%,transparent)}
tbody tr:last-child td{border-bottom:none}
tbody tr{transition:background var(--d-micro) var(--ease)}
tbody tr:hover td{background:var(--hover)}
th.n,td.n{text-align:right;font-family:var(--mono);font-variant-numeric:tabular-nums;
  letter-spacing:-.02em}
td.m{font-family:var(--mono);font-size:12px}
td.hi{color:var(--accent);font-weight:600}
td.off{color:var(--subtle);text-decoration:line-through;
  text-decoration-thickness:1px;font-size:12px}
td.disc{color:var(--success);font-weight:700;font-size:11.6px}
td.dash{color:var(--subtle);text-decoration:none}
.vd{display:inline-flex;align-items:center;gap:6px;white-space:nowrap}
.vd .vi{width:15px;height:15px;display:grid;place-items:center;flex:none;color:var(--vc)}
.vd .vi svg{display:block;width:100%;height:100%}
.vd .vi.mono{border-radius:4px;background:var(--vc);color:#fff;font-size:8.5px;font-weight:800}

/* ---- 状态 ---------------------------------------------------------------- */
.msg{padding:56px 22px;text-align:center;color:var(--muted);border-radius:14px}
.msg b{display:block;font-size:15px;color:var(--text);margin-bottom:6px}
.msg code{font-family:var(--mono);font-size:12px;background:var(--raised);
  padding:2px 6px;border-radius:5px}
/* 骨架屏：原件用 MUI Skeleton，这里自己画 */
.sk{border-radius:14px;background:var(--surface);border:1px solid var(--border);
  height:196px;position:relative;overflow:hidden}
.sk.t{height:22px;width:190px;border-radius:7px;display:inline-block;vertical-align:middle}
.sk::after{content:'';position:absolute;inset:0;
  background:linear-gradient(90deg,transparent,color-mix(in srgb,var(--text) 5%,transparent),transparent);
  animation:shim 1.4s infinite}
@keyframes shim{from{transform:translateX(-100%)}to{transform:translateX(100%)}}
.toast{position:fixed;bottom:24px;left:50%;transform:translate(-50%,80px);
  background:color-mix(in srgb,var(--raised) 88%,transparent);
  backdrop-filter:var(--blur);-webkit-backdrop-filter:var(--blur);
  border:1px solid var(--glass-line);color:var(--text);
  padding:9px 16px;border-radius:11px;font-size:13px;opacity:0;z-index:90;
  transition:opacity var(--d-med) var(--ease),transform var(--d-med) var(--ease);
  pointer-events:none;box-shadow:0 8px 30px rgba(0,0,0,.35)}
.toast.on{opacity:1;transform:translate(-50%,0)}

/* ---- 窄屏 ---------------------------------------------------------------- */
@media (max-width:640px){
  .wrap{padding:0 14px}
  .top-in{padding:0 14px;gap:8px}
  .hero{padding:22px 0 14px}
  .stats{gap:8px}
  .stat{padding:10px 14px;min-width:0;flex:1 1 46%;gap:9px}
  .stat-ic{width:30px;height:30px}
  .stat b{font-size:.98rem}
  .grid{grid-template-columns:1fr;gap:10px}
  .ctrl{gap:8px}
  .search{max-width:none;flex:1 1 100%}
  .seg{flex:1}
  .seg button{flex:1;padding:0 8px}
  .count{width:100%;text-align:right}
}
</style>
</head>
<body>

<header class="top">
  <div class="top-in">
    <a class="back" href="/"><svg viewBox="0 0 24 24"><path d="M5 12h14"/><path d="m12 19-7-7 7-7"/></svg><span data-i="back">返回</span></a>
    <a class="brand" href="/"><img src="/favicon.png" alt=""><span>SkiAPI</span></a>
    <span class="top-sp"></span>
